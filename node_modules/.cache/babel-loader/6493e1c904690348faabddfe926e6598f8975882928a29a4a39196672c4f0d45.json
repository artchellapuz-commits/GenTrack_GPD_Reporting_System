{"ast":null,"code":"import _regenerator from \"C:/Users/eladiong/Desktop/OJT Intern_v2/npc-reporting-system/frontend/node_modules/@babel/runtime/helpers/esm/regenerator.js\";\nimport _asyncToGenerator from \"C:/Users/eladiong/Desktop/OJT Intern_v2/npc-reporting-system/frontend/node_modules/@babel/runtime/helpers/esm/asyncToGenerator.js\";\nimport \"core-js/modules/es.date.to-string.js\";\nimport \"core-js/modules/es.string.trim.js\";\nimport AppLayout from './AppLayout.vue';\nimport api from '../services/api';\nexport default {\n  name: 'SignatoryAuthorizationRequest',\n  components: {\n    AppLayout: AppLayout\n  },\n  data: function data() {\n    return {\n      selectedSignatory: '',\n      selectedRole: '',\n      justification: '',\n      submitting: false,\n      userAuthorizations: [],\n      pendingRequests: [],\n      availableSignatories: [{\n        name: 'O.M. LAVA',\n        title: 'Prin. Engr. A, GPD'\n      }, {\n        name: 'JMM MATA',\n        title: 'Manager, GPD'\n      }, {\n        name: 'EL ADIONG',\n        title: 'Acting Manager, GPD'\n      }, {\n        name: 'C.C. AMIGABLE JR.',\n        title: 'Dept. Manager, GPD'\n      }, {\n        name: 'D.R.B. CAIRO',\n        title: 'Prin. Engr. B, GPD'\n      }, {\n        name: 'DB ESMADE JR.',\n        title: 'Acting Dept. Manager, GPD'\n      }]\n    };\n  },\n  computed: {\n    canSubmit: function canSubmit() {\n      return this.selectedSignatory && this.selectedRole && this.justification.trim().length > 10;\n    }\n  },\n  mounted: function mounted() {\n    this.loadUserAuthorizations();\n    this.loadPendingRequests();\n  },\n  methods: {\n    loadUserAuthorizations: function loadUserAuthorizations() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var response, _t;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _context.p = 0;\n              _context.n = 1;\n              return api.getUserSignatoryAuthorizations();\n            case 1:\n              response = _context.v;\n              _this.userAuthorizations = response.data.results || response.data;\n              _context.n = 3;\n              break;\n            case 2:\n              _context.p = 2;\n              _t = _context.v;\n              console.error('Error loading authorizations:', _t);\n            case 3:\n              return _context.a(2);\n          }\n        }, _callee, null, [[0, 2]]);\n      }))();\n    },\n    loadPendingRequests: function loadPendingRequests() {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2() {\n        var response, _t2;\n        return _regenerator().w(function (_context2) {\n          while (1) switch (_context2.p = _context2.n) {\n            case 0:\n              _context2.p = 0;\n              _context2.n = 1;\n              return api.getUserAuthorizationRequests();\n            case 1:\n              response = _context2.v;\n              _this2.pendingRequests = response.data.results || response.data;\n              _context2.n = 3;\n              break;\n            case 2:\n              _context2.p = 2;\n              _t2 = _context2.v;\n              console.error('Error loading pending requests:', _t2);\n            case 3:\n              return _context2.a(2);\n          }\n        }, _callee2, null, [[0, 2]]);\n      }))();\n    },\n    submitRequest: function submitRequest() {\n      var _this3 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee3() {\n        var _t3;\n        return _regenerator().w(function (_context3) {\n          while (1) switch (_context3.p = _context3.n) {\n            case 0:\n              if (_this3.canSubmit) {\n                _context3.n = 1;\n                break;\n              }\n              return _context3.a(2);\n            case 1:\n              _this3.submitting = true;\n              _context3.p = 2;\n              _context3.n = 3;\n              return api.requestSignatoryAuthorization({\n                signatory_name: _this3.selectedSignatory,\n                role: _this3.selectedRole,\n                justification: _this3.justification\n              });\n            case 3:\n              // Show success message\n              _this3.$toast.success('Authorization request submitted successfully! You will receive an email notification when it is reviewed.');\n\n              // Reset form\n              _this3.selectedSignatory = '';\n              _this3.selectedRole = '';\n              _this3.justification = '';\n\n              // Reload pending requests\n              _context3.n = 4;\n              return _this3.loadPendingRequests();\n            case 4:\n              _context3.n = 6;\n              break;\n            case 5:\n              _context3.p = 5;\n              _t3 = _context3.v;\n              console.error('Error submitting request:', _t3);\n              _this3.$toast.error('Failed to submit request. Please try again.');\n            case 6:\n              _context3.p = 6;\n              _this3.submitting = false;\n              return _context3.f(6);\n            case 7:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[2, 5, 6, 7]]);\n      }))();\n    },\n    formatDate: function formatDate(dateString) {\n      return new Date(dateString).toLocaleDateString('en-US', {\n        year: 'numeric',\n        month: 'long',\n        day: 'numeric'\n      });\n    }\n  }\n};","map":{"version":3,"names":["AppLayout","api","name","components","data","selectedSignatory","selectedRole","justification","submitting","userAuthorizations","pendingRequests","availableSignatories","title","computed","canSubmit","trim","length","mounted","loadUserAuthorizations","loadPendingRequests","methods","_this","_asyncToGenerator","_regenerator","m","_callee","response","_t","w","_context","p","n","getUserSignatoryAuthorizations","v","results","console","error","a","_this2","_callee2","_t2","_context2","getUserAuthorizationRequests","submitRequest","_this3","_callee3","_t3","_context3","requestSignatoryAuthorization","signatory_name","role","$toast","success","f","formatDate","dateString","Date","toLocaleDateString","year","month","day"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\SignatoryAuthorizationRequest.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n    <div class=\"authorization-request-page\">\r\n      <!-- Hero Section -->\r\n      <div class=\"hero-section\">\r\n        <div class=\"hero-content\">\r\n          <div class=\"hero-icon\">\r\n            <i class=\"pi pi-shield\"></i>\r\n          </div>\r\n          <h1 class=\"hero-title\">Signature Authorization Center</h1>\r\n          <p class=\"hero-subtitle\">Secure your digital signature access with enterprise-grade authorization</p>\r\n          \r\n          <!-- Stats Cards -->\r\n          <div class=\"stats-grid\">\r\n            <div class=\"stat-card\">\r\n              <div class=\"stat-icon success\">\r\n                <i class=\"pi pi-check-circle\"></i>\r\n              </div>\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-number\">{{ userAuthorizations.length }}</div>\r\n                <div class=\"stat-label\">Active Authorizations</div>\r\n              </div>\r\n            </div>\r\n            <div class=\"stat-card\">\r\n              <div class=\"stat-icon warning\">\r\n                <i class=\"pi pi-clock\"></i>\r\n              </div>\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-number\">{{ pendingRequests.length }}</div>\r\n                <div class=\"stat-label\">Pending Requests</div>\r\n              </div>\r\n            </div>\r\n            <div class=\"stat-card\">\r\n              <div class=\"stat-icon info\">\r\n                <i class=\"pi pi-users\"></i>\r\n              </div>\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-number\">{{ availableSignatories.length }}</div>\r\n                <div class=\"stat-label\">Available Signatories</div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Main Content -->\r\n      <div class=\"main-content\">\r\n        <!-- Current Authorizations Section -->\r\n        <div v-if=\"userAuthorizations.length > 0\" class=\"section-card authorizations-section\">\r\n          <div class=\"section-header\">\r\n            <div class=\"section-title\">\r\n              <i class=\"pi pi-verified\"></i>\r\n              <h2>Your Active Authorizations</h2>\r\n            </div>\r\n            <div class=\"section-badge success\">{{ userAuthorizations.length }} Active</div>\r\n          </div>\r\n          \r\n          <div class=\"authorizations-grid\">\r\n            <div \r\n              v-for=\"(auth, index) in userAuthorizations\" \r\n              :key=\"auth.id\"\r\n              class=\"authorization-card\"\r\n              :class=\"{ 'expired': !auth.is_valid }\"\r\n              :style=\"{ animationDelay: `${index * 0.1}s` }\"\r\n            >\r\n              <div class=\"auth-card-header\">\r\n                <div class=\"auth-avatar\">\r\n                  <i class=\"pi pi-user\"></i>\r\n                </div>\r\n                <div class=\"auth-info\">\r\n                  <h3 class=\"auth-name\">{{ auth.signatory_name }}</h3>\r\n                  <p class=\"auth-role\">{{ getSignatoryTitle(auth.signatory_name) }}</p>\r\n                </div>\r\n                <div class=\"auth-status-badge\" :class=\"auth.is_valid ? 'active' : 'expired'\">\r\n                  <i :class=\"auth.is_valid ? 'pi pi-check-circle' : 'pi pi-times-circle'\"></i>\r\n                  {{ auth.is_valid ? 'Active' : 'Expired' }}\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"auth-card-body\">\r\n                <div class=\"auth-details\">\r\n                  <div class=\"detail-item\">\r\n                    <i class=\"pi pi-calendar\"></i>\r\n                    <span>Authorized: {{ formatDate(auth.authorization_date) }}</span>\r\n                  </div>\r\n                  <div v-if=\"auth.expiry_date\" class=\"detail-item\">\r\n                    <i class=\"pi pi-clock\"></i>\r\n                    <span>Expires: {{ formatDate(auth.expiry_date) }}</span>\r\n                  </div>\r\n                  <div class=\"detail-item\">\r\n                    <i class=\"pi pi-shield\"></i>\r\n                    <span>2FA: {{ auth.requires_2fa ? 'Required' : 'Not Required' }}</span>\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"auth-actions\">\r\n                  <button class=\"btn-action secondary\" @click=\"viewAuthDetails(auth)\">\r\n                    <i class=\"pi pi-eye\"></i>\r\n                    View Details\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Request New Authorization Section -->\r\n        <div class=\"section-card request-section\">\r\n          <div class=\"section-header\">\r\n            <div class=\"section-title\">\r\n              <i class=\"pi pi-plus-circle\"></i>\r\n              <h2>Request New Authorization</h2>\r\n            </div>\r\n            <div class=\"progress-indicator\">\r\n              <div class=\"progress-step\" :class=\"{ active: currentStep >= 1, completed: currentStep > 1 }\">\r\n                <div class=\"step-number\">1</div>\r\n                <span>Select Signatory</span>\r\n              </div>\r\n              <div class=\"progress-line\" :class=\"{ active: currentStep > 1 }\"></div>\r\n              <div class=\"progress-step\" :class=\"{ active: currentStep >= 2, completed: currentStep > 2 }\">\r\n                <div class=\"step-number\">2</div>\r\n                <span>Choose Role</span>\r\n              </div>\r\n              <div class=\"progress-line\" :class=\"{ active: currentStep > 2 }\"></div>\r\n              <div class=\"progress-step\" :class=\"{ active: currentStep >= 3, completed: currentStep > 3 }\">\r\n                <div class=\"step-number\">3</div>\r\n                <span>Provide Justification</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"request-form-container\">\r\n            <form @submit.prevent=\"submitRequest\" class=\"request-form\">\r\n              <!-- Step 1: Signatory Selection -->\r\n              <div class=\"form-step\" :class=\"{ active: currentStep === 1 }\">\r\n                <div class=\"step-header\">\r\n                  <h3>Step 1: Select Signatory</h3>\r\n                  <p>Choose the signatory name you need authorization for</p>\r\n                </div>\r\n                \r\n                <div class=\"signatory-grid\">\r\n                  <div \r\n                    v-for=\"signatory in availableSignatories\" \r\n                    :key=\"signatory.name\"\r\n                    class=\"signatory-card\"\r\n                    :class=\"{ selected: selectedSignatory === signatory.name }\"\r\n                    @click=\"selectSignatory(signatory.name)\"\r\n                  >\r\n                    <div class=\"signatory-avatar\">\r\n                      <i class=\"pi pi-user\"></i>\r\n                    </div>\r\n                    <div class=\"signatory-info\">\r\n                      <h4>{{ signatory.name }}</h4>\r\n                      <p>{{ signatory.title }}</p>\r\n                    </div>\r\n                    <div class=\"selection-indicator\">\r\n                      <i class=\"pi pi-check\"></i>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"step-actions\">\r\n                  <button \r\n                    type=\"button\" \r\n                    class=\"btn-next\" \r\n                    :disabled=\"!selectedSignatory\"\r\n                    @click=\"nextStep\"\r\n                  >\r\n                    Continue\r\n                    <i class=\"pi pi-arrow-right\"></i>\r\n                  </button>\r\n                </div>\r\n              </div>\r\n\r\n              <!-- Step 2: Role Selection -->\r\n              <div class=\"form-step\" :class=\"{ active: currentStep === 2 }\">\r\n                <div class=\"step-header\">\r\n                  <h3>Step 2: Choose Your Role</h3>\r\n                  <p>Select the role that best describes your responsibility</p>\r\n                </div>\r\n                \r\n                <div class=\"role-grid\">\r\n                  <div \r\n                    v-for=\"role in availableRoles\" \r\n                    :key=\"role.value\"\r\n                    class=\"role-card\"\r\n                    :class=\"{ selected: selectedRole === role.value }\"\r\n                    @click=\"selectRole(role.value)\"\r\n                  >\r\n                    <div class=\"role-icon\">\r\n                      <i :class=\"role.icon\"></i>\r\n                    </div>\r\n                    <div class=\"role-info\">\r\n                      <h4>{{ role.label }}</h4>\r\n                      <p>{{ role.description }}</p>\r\n                    </div>\r\n                    <div class=\"selection-indicator\">\r\n                      <i class=\"pi pi-check\"></i>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"step-actions\">\r\n                  <button type=\"button\" class=\"btn-back\" @click=\"prevStep\">\r\n                    <i class=\"pi pi-arrow-left\"></i>\r\n                    Back\r\n                  </button>\r\n                  <button \r\n                    type=\"button\" \r\n                    class=\"btn-next\" \r\n                    :disabled=\"!selectedRole\"\r\n                    @click=\"nextStep\"\r\n                  >\r\n                    Continue\r\n                    <i class=\"pi pi-arrow-right\"></i>\r\n                  </button>\r\n                </div>\r\n              </div>\r\n\r\n              <!-- Step 3: Justification -->\r\n              <div class=\"form-step\" :class=\"{ active: currentStep === 3 }\">\r\n                <div class=\"step-header\">\r\n                  <h3>Step 3: Provide Justification</h3>\r\n                  <p>Explain why you need this authorization</p>\r\n                </div>\r\n                \r\n                <div class=\"justification-section\">\r\n                  <div class=\"form-field\">\r\n                    <label class=\"field-label\">\r\n                      <i class=\"pi pi-comment\"></i>\r\n                      Justification Details\r\n                    </label>\r\n                    <div class=\"textarea-container\">\r\n                      <textarea \r\n                        v-model=\"justification\"\r\n                        class=\"form-textarea\"\r\n                        rows=\"6\"\r\n                        placeholder=\"Please provide a detailed explanation of why you need this authorization. Include your role, responsibilities, and how this authorization will be used.\"\r\n                        required\r\n                        @input=\"updateCharacterCount\"\r\n                      ></textarea>\r\n                      <div class=\"character-count\">\r\n                        {{ justification.length }}/500 characters\r\n                      </div>\r\n                    </div>\r\n                    <div class=\"field-hint\">\r\n                      <i class=\"pi pi-info-circle\"></i>\r\n                      <span>Be specific about your role and responsibilities. This helps administrators process your request faster.</span>\r\n                    </div>\r\n                  </div>\r\n\r\n                  <!-- Request Summary -->\r\n                  <div class=\"request-summary\">\r\n                    <h4>Request Summary</h4>\r\n                    <div class=\"summary-grid\">\r\n                      <div class=\"summary-item\">\r\n                        <span class=\"summary-label\">Signatory:</span>\r\n                        <span class=\"summary-value\">{{ selectedSignatory }}</span>\r\n                      </div>\r\n                      <div class=\"summary-item\">\r\n                        <span class=\"summary-label\">Role:</span>\r\n                        <span class=\"summary-value\">{{ selectedRole }}</span>\r\n                      </div>\r\n                      <div class=\"summary-item\">\r\n                        <span class=\"summary-label\">Request Date:</span>\r\n                        <span class=\"summary-value\">{{ new Date().toLocaleDateString() }}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"step-actions\">\r\n                  <button type=\"button\" class=\"btn-back\" @click=\"prevStep\">\r\n                    <i class=\"pi pi-arrow-left\"></i>\r\n                    Back\r\n                  </button>\r\n                  <button \r\n                    type=\"submit\"\r\n                    class=\"btn-submit\"\r\n                    :disabled=\"!canSubmit || submitting\"\r\n                    :class=\"{ submitting: submitting }\"\r\n                  >\r\n                    <div class=\"btn-content\">\r\n                      <i v-if=\"!submitting\" class=\"pi pi-send\"></i>\r\n                      <i v-else class=\"pi pi-spin pi-spinner\"></i>\r\n                      <span>{{ submitting ? 'Submitting...' : 'Submit Request' }}</span>\r\n                    </div>\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </form>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Pending Requests Section -->\r\n        <div v-if=\"pendingRequests.length > 0\" class=\"section-card pending-section\">\r\n          <div class=\"section-header\">\r\n            <div class=\"section-title\">\r\n              <i class=\"pi pi-hourglass\"></i>\r\n              <h2>Pending Requests</h2>\r\n            </div>\r\n            <div class=\"section-badge warning\">{{ pendingRequests.length }} Pending</div>\r\n          </div>\r\n          \r\n          <div class=\"pending-requests-list\">\r\n            <div \r\n              v-for=\"(request, index) in pendingRequests\" \r\n              :key=\"request.id\"\r\n              class=\"pending-request-card\"\r\n              :style=\"{ animationDelay: `${index * 0.1}s` }\"\r\n            >\r\n              <div class=\"request-header\">\r\n                <div class=\"request-info\">\r\n                  <h4>{{ request.signatory_name }}</h4>\r\n                  <p>{{ request.role }}</p>\r\n                </div>\r\n                <div class=\"request-status\">\r\n                  <div class=\"status-indicator pending\">\r\n                    <div class=\"pulse-dot\"></div>\r\n                    Pending Review\r\n                  </div>\r\n                  <div class=\"request-date\">{{ formatDate(request.created_at) }}</div>\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"request-body\">\r\n                <div class=\"justification-preview\">\r\n                  <strong>Justification:</strong>\r\n                  <p>{{ request.justification }}</p>\r\n                </div>\r\n                \r\n                <div class=\"request-actions\">\r\n                  <button class=\"btn-action secondary\" @click=\"viewRequestDetails(request)\">\r\n                    <i class=\"pi pi-eye\"></i>\r\n                    View Details\r\n                  </button>\r\n                  <button class=\"btn-action danger\" @click=\"cancelRequest(request)\">\r\n                    <i class=\"pi pi-times\"></i>\r\n                    Cancel Request\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Help & Information Section -->\r\n        <div class=\"section-card help-section\">\r\n          <div class=\"section-header\">\r\n            <div class=\"section-title\">\r\n              <i class=\"pi pi-question-circle\"></i>\r\n              <h2>Help & Information</h2>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"help-content\">\r\n            <div class=\"help-tabs\">\r\n              <button \r\n                v-for=\"tab in helpTabs\" \r\n                :key=\"tab.id\"\r\n                class=\"help-tab\"\r\n                :class=\"{ active: activeHelpTab === tab.id }\"\r\n                @click=\"activeHelpTab = tab.id\"\r\n              >\r\n                <i :class=\"tab.icon\"></i>\r\n                {{ tab.label }}\r\n              </button>\r\n            </div>\r\n            \r\n            <div class=\"help-tab-content\">\r\n              <div v-if=\"activeHelpTab === 'overview'\" class=\"help-panel\">\r\n                <h3>What is Signatory Authorization?</h3>\r\n                <p>Signatory authorization is a security feature that ensures only authorized personnel can digitally sign official reports. This system provides:</p>\r\n                <ul>\r\n                  <li><strong>Security:</strong> Only approved users can sign documents</li>\r\n                  <li><strong>Accountability:</strong> Full audit trail of all signatures</li>\r\n                  <li><strong>Compliance:</strong> Meets regulatory requirements for digital signatures</li>\r\n                  <li><strong>Flexibility:</strong> Different authorization levels for different roles</li>\r\n                </ul>\r\n              </div>\r\n              \r\n              <div v-if=\"activeHelpTab === 'process'\" class=\"help-panel\">\r\n                <h3>Authorization Process</h3>\r\n                <div class=\"process-steps\">\r\n                  <div class=\"process-step\">\r\n                    <div class=\"process-number\">1</div>\r\n                    <div class=\"process-content\">\r\n                      <h4>Submit Request</h4>\r\n                      <p>Complete the authorization request form with your details and justification</p>\r\n                    </div>\r\n                  </div>\r\n                  <div class=\"process-step\">\r\n                    <div class=\"process-number\">2</div>\r\n                    <div class=\"process-content\">\r\n                      <h4>Admin Review</h4>\r\n                      <p>System administrators review your request (typically 1-2 business days)</p>\r\n                    </div>\r\n                  </div>\r\n                  <div class=\"process-step\">\r\n                    <div class=\"process-number\">3</div>\r\n                    <div class=\"process-content\">\r\n                      <h4>Email Notification</h4>\r\n                      <p>You'll receive an email notification when your request is approved or rejected</p>\r\n                    </div>\r\n                  </div>\r\n                  <div class=\"process-step\">\r\n                    <div class=\"process-number\">4</div>\r\n                    <div class=\"process-content\">\r\n                      <h4>Start Signing</h4>\r\n                      <p>Once approved, you can create your digital signature and sign reports</p>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              \r\n              <div v-if=\"activeHelpTab === 'faq'\" class=\"help-panel\">\r\n                <h3>Frequently Asked Questions</h3>\r\n                <div class=\"faq-list\">\r\n                  <div class=\"faq-item\">\r\n                    <h4>How long does approval take?</h4>\r\n                    <p>Most requests are reviewed within 1-2 business days. Complex requests may take longer.</p>\r\n                  </div>\r\n                  <div class=\"faq-item\">\r\n                    <h4>Can I request multiple authorizations?</h4>\r\n                    <p>Yes, you can request authorization for multiple signatory names if your role requires it.</p>\r\n                  </div>\r\n                  <div class=\"faq-item\">\r\n                    <h4>What if my request is rejected?</h4>\r\n                    <p>You'll receive an email with the reason for rejection and can resubmit with additional information.</p>\r\n                  </div>\r\n                  <div class=\"faq-item\">\r\n                    <h4>Do authorizations expire?</h4>\r\n                    <p>Some authorizations may have expiry dates. You'll be notified before expiration to renew if needed.</p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </AppLayout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from './AppLayout.vue';\r\nimport api from '../services/api';\r\n\r\nexport default {\r\n  name: 'SignatoryAuthorizationRequest',\r\n  components: {\r\n    AppLayout\r\n  },\r\n  data() {\r\n    return {\r\n      selectedSignatory: '',\r\n      selectedRole: '',\r\n      justification: '',\r\n      submitting: false,\r\n      userAuthorizations: [],\r\n      pendingRequests: [],\r\n      availableSignatories: [\r\n        { name: 'O.M. LAVA', title: 'Prin. Engr. A, GPD' },\r\n        { name: 'JMM MATA', title: 'Manager, GPD' },\r\n        { name: 'EL ADIONG', title: 'Acting Manager, GPD' },\r\n        { 