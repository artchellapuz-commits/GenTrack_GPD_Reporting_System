{"ast":null,"code":"export default {\n  name: 'PrivacyPolicy',\n  data: function data() {\n    return {\n      sections: [{\n        title: '1. Information We Collect',\n        content: ['We collect information necessary to provide and improve our reporting services. This includes:'],\n        list: ['User account information (name, email, role)', 'Plant operational data uploaded through the system', 'System usage logs and analytics', 'Technical information (IP address, browser type)']\n      }, {\n        title: '2. How We Use Your Information',\n        content: ['The information we collect is used to:'],\n        list: ['Provide and maintain the reporting system', 'Generate performance reports and analytics', 'Improve system functionality and user experience', 'Ensure system security and prevent unauthorized access', 'Communicate important system updates']\n      }, {\n        title: '3. Data Security',\n        content: ['We implement industry-standard security measures to protect your data, including encryption, secure authentication, and regular security audits. Access to sensitive data is restricted to authorized personnel only.']\n      }, {\n        title: '4. Data Retention',\n        content: ['We retain operational data as required by government regulations and organizational policies. User account information is maintained for the duration of active employment or system access.']\n      }, {\n        title: '5. Data Sharing',\n        content: ['We do not sell or share your personal information with third parties. Data may be shared internally within NPC for operational purposes and with government agencies as required by law.']\n      }, {\n        title: '6. Your Rights',\n        content: ['You have the right to access, correct, or request deletion of your personal information. Contact our support team for assistance with data-related requests.']\n      }, {\n        title: '7. Changes to This Policy',\n        content: ['We may update this privacy policy periodically. Users will be notified of significant changes through the system or email.']\n      }, {\n        title: '8. Contact Us',\n        content: ['For questions about this privacy policy, please contact your system administrator or the GPD IT support team.']\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","data","sections","title","content","list"],"sources":["C:\\Users\\eladiong\\Pictures\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\PrivacyPolicy.vue"],"sourcesContent":["<template>\r\n  <div class=\"privacy-page\">\r\n    <!-- Animated Background -->\r\n    <div class=\"animated-bg\">\r\n      <div class=\"bg-shape shape-1\"></div>\r\n      <div class=\"bg-shape shape-2\"></div>\r\n      <div class=\"bg-shape shape-3\"></div>\r\n    </div>\r\n\r\n    <!-- Back Button Top Left -->\r\n    <div class=\"back-button-top-left\">\r\n      <router-link to=\"/\" class=\"btn-back-glass-small\">\r\n        <i class=\"pi pi-arrow-left\"></i>\r\n        <span>Back to Home</span>\r\n      </router-link>\r\n    </div>\r\n\r\n    <!-- Header -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"header-icon\">\r\n          <i class=\"pi pi-shield\"></i>\r\n        </div>\r\n        <h1 class=\"glowing-text\">Privacy Policy</h1>\r\n        <p class=\"subtitle\">Your privacy is important to us</p>\r\n        <p class=\"last-updated\">Last Updated: February 2026</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Content -->\r\n    <div class=\"content-container\">\r\n      <div class=\"content-card-glass\">\r\n        <div v-for=\"(section, index) in sections\" :key=\"index\" class=\"section\">\r\n          <h2>{{ section.title }}</h2>\r\n          <p v-for=\"(paragraph, idx) in section.content\" :key=\"idx\">{{ paragraph }}</p>\r\n          <ul v-if=\"section.list\">\r\n            <li v-for=\"(item, idx) in section.list\" :key=\"idx\">{{ item }}</li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'PrivacyPolicy',\r\n  data() {\r\n    return {\r\n      sections: [\r\n        {\r\n          title: '1. Information We Collect',\r\n          content: [\r\n            'We collect information necessary to provide and improve our reporting services. This includes:'\r\n          ],\r\n          list: [\r\n            'User account information (name, email, role)',\r\n            'Plant operational data uploaded through the system',\r\n            'System usage logs and analytics',\r\n            'Technical information (IP address, browser type)'\r\n          ]\r\n        },\r\n        {\r\n          title: '2. How We Use Your Information',\r\n          content: [\r\n            'The information we collect is used to:'\r\n          ],\r\n          list: [\r\n            'Provide and maintain the reporting system',\r\n            'Generate performance reports and analytics',\r\n            'Improve system functionality and user experience',\r\n            'Ensure system security and prevent unauthorized access',\r\n            'Communicate important system updates'\r\n          ]\r\n        },\r\n        {\r\n          title: '3. Data Security',\r\n          content: [\r\n            'We implement industry-standard security measures to protect your data, including encryption, secure authentication, and regular security audits. Access to sensitive data is restricted to authorized personnel only.'\r\n          ]\r\n        },\r\n        {\r\n          title: '4. Data Retention',\r\n          content: [\r\n            'We retain operational data as required by government regulations and organizational policies. User account information is maintained for the duration of active employment or system access.'\r\n          ]\r\n        },\r\n        {\r\n          title: '5. Data Sharing',\r\n          content: [\r\n            'We do not sell or share your personal information with third parties. Data may be shared internally within NPC for operational purposes and with government agencies as required by law.'\r\n          ]\r\n        },\r\n        {\r\n          title: '6. Your Rights',\r\n          content: [\r\n            'You have the right to access, correct, or request deletion of your personal information. Contact our support team for assistance with data-related requests.'\r\n          ]\r\n        },\r\n        {\r\n          title: '7. Changes to This Policy',\r\n          content: [\r\n            'We may update this privacy policy periodically. Users will be notified of significant changes through the system or email.'\r\n          ]\r\n        },\r\n        {\r\n          title: '8. Contact Us',\r\n          content: [\r\n            'For questions about this privacy policy, please contact your system administrator or the GPD IT support team.'\r\n          ]\r\n        }\r\n      ]\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.privacy-page {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);\r\n  padding: 100px 20px 80px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.animated-bg {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.bg-shape {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  filter: blur(80px);\r\n  opacity: 0.15;\r\n  animation: float 20s ease-in-out infinite;\r\n}\r\n\r\n.shape-1 {\r\n  width: 500px;\r\n  height: 500px;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  top: -200px;\r\n  left: -200px;\r\n}\r\n\r\n.shape-2 {\r\n  width: 400px;\r\n  height: 400px;\r\n  background: linear-gradient(135deg, #ec4899 0%, #f59e0b 100%);\r\n  bottom: -150px;\r\n  right: -150px;\r\n  animation-delay: 5s;\r\n}\r\n\r\n.shape-3 {\r\n  width: 350px;\r\n  height: 350px;\r\n  background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation-delay: 10s;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% { transform: translate(0, 0) scale(1); }\r\n  33% { transform: translate(100px, -100px) scale(1.1); }\r\n  66% { transform: translate(-100px, 100px) scale(0.9); }\r\n}\r\n\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.header-icon {\r\n  width: 100px;\r\n  height: 100px;\r\n  margin: 0 auto 30px;\r\n  border-radius: 30px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 3rem;\r\n  color: #60a5fa;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n  animation: iconPulse 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes iconPulse {\r\n  0%, 100% { transform: scale(1); }\r\n  50% { transform: scale(1.05); }\r\n}\r\n\r\n.glowing-text {\r\n  font-size: 4rem;\r\n  font-weight: 900;\r\n  background: linear-gradient(135deg, #ffffff 0%, #60a5fa 50%, #a78bfa 100%);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  background-clip: text;\r\n  margin: 0 0 20px 0;\r\n  letter-spacing: -2px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 1.5rem;\r\n  color: #cbd5e1;\r\n  margin: 0 0 12px 0;\r\n  font-weight: 300;\r\n}\r\n\r\n.last-updated {\r\n  font-size: 1rem;\r\n  color: #94a3b8;\r\n  margin: 0;\r\n  font-style: italic;\r\n}\r\n\r\n.content-container {\r\n  max-width: 1000px;\r\n  margin: 0 auto 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.content-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(255, 255, 255, 0.05) 0%, \r\n    rgba(255, 255, 255, 0.02) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  padding: 60px;\r\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n.section {\r\n  margin-bottom: 40px;\r\n}\r\n\r\n.section:last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\n.section h2 {\r\n  font-size: 1.75rem;\r\n  color: #ffffff !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.section p {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  margin: 0 0 16px 0;\r\n}\r\n\r\n.section ul {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 16px 0 0 0;\r\n}\r\n\r\n.section ul li {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  padding: 8px 0 8px 32px;\r\n  position: relative;\r\n}\r\n\r\n.section ul li::before {\r\n  content: '•';\r\n  position: absolute;\r\n  left: 12px;\r\n  color: #60a5fa;\r\n  font-size: 1.5rem;\r\n}\r\n\r\n.back-button-container {\r\n  text-align: center;\r\n  margin-top: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.btn-back-glass {\r\n  position: relative;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 18px 40px;\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.2) 0%, \r\n    rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 16px;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 1.125rem;\r\n  font-weight: 600;\r\n  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n  overflow: hidden;\r\n  box-shadow: 0 10px 40px rgba(59, 130, 246, 0.2);\r\n}\r\n\r\n.btn-back-glass:hover {\r\n  transform: translateY(-5px) scale(1.05);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.4);\r\n}\r\n\r\n.btn-shine {\r\n  position: absolute;\r\n  top: 0;\r\n  left: -100%;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: linear-gradient(90deg, \r\n    transparent, \r\n    rgba(255, 255, 255, 0.2), \r\n    transparent);\r\n  transition: left 0.6s ease;\r\n}\r\n\r\n.btn-back-glass:hover .btn-shine {\r\n  left: 100%;\r\n}\r\n\r\n/* Back Button Top Left */\r\n.back-button-top-left {\r\n  position: fixed;\r\n  top: 30px;\r\n  left: 30px;\r\n  z-index: 1000;\r\n}\r\n\r\n.btn-back-glass-small {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 12px 24px;\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.3) 0%, \r\n    rgba(139, 92, 246, 0.3) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 12px;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.btn-back-glass-small:hover {\r\n  transform: translateX(-5px);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 12px 40px rgba(59, 130, 246, 0.5);\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.4) 0%, \r\n    rgba(139, 92, 246, 0.4) 100%);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .content-card-glass {\r\n    padding: 40px 30px;\r\n  }\r\n  \r\n  .glowing-text {\r\n    font-size: 2.5rem;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AA8CA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,IAAI,WAAJA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,CACR;QACEC,KAAK,EAAE,2BAA2B;QAClCC,OAAO,EAAE,CACP,gGAA+F,CAChG;QACDC,IAAI,EAAE,CACJ,8CAA8C,EAC9C,oDAAoD,EACpD,iCAAiC,EACjC,kDAAiD;MAErD,CAAC,EACD;QACEF,KAAK,EAAE,gCAAgC;QACvCC,OAAO,EAAE,CACP,wCAAuC,CACxC;QACDC,IAAI,EAAE,CACJ,2CAA2C,EAC3C,4CAA4C,EAC5C,kDAAkD,EAClD,wDAAwD,EACxD,sCAAqC;MAEzC,CAAC,EACD;QACEF,KAAK,EAAE,kBAAkB;QACzBC,OAAO,EAAE,CACP,uNAAsN;MAE1N,CAAC,EACD;QACED,KAAK,EAAE,mBAAmB;QAC1BC,OAAO,EAAE,CACP,8LAA6L;MAEjM,CAAC,EACD;QACED,KAAK,EAAE,iBAAiB;QACxBC,OAAO,EAAE,CACP,0LAAyL;MAE7L,CAAC,EACD;QACED,KAAK,EAAE,gBAAgB;QACvBC,OAAO,EAAE,CACP,8JAA6J;MAEjK,CAAC,EACD;QACED,KAAK,EAAE,2BAA2B;QAClCC,OAAO,EAAE,CACP,4HAA2H;MAE/H,CAAC,EACD;QACED,KA