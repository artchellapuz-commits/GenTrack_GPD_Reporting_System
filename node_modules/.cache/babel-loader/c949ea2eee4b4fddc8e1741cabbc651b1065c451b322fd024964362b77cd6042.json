 link = document.createElement('a');\n                link.href = url;\n                link.download = \"Audit_Logs_\".concat(new Date().toISOString().split('T')[0], \".xlsx\");\n                link.style.display = 'none';\n                document.body.appendChild(link);\n                link.click();\n                document.body.removeChild(link);\n              } catch (error) {\n                console.error('Error exporting audit logs:', error);\n                alert('Failed to export audit logs');\n              }\n            case 1:\n              return _context2.a(2);\n          }\n        }, _callee2);\n      }))();\n    },\n    formatDateOnly: function formatDateOnly(datetime) {\n      return new Date(datetime).toLocaleDateString('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric'\n      });\n    },\n    formatTimeOnly: function formatTimeOnly(datetime) {\n      return new Date(datetime).toLocaleTimeString('en-US', {\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit',\n        hour12: true\n      });\n    },\n    getInitials: function getInitials(name) {\n      if (!name || name === 'System') return 'SY';\n      var parts = name.split(' ');\n      if (parts.length >= 2) {\n        return \"\".concat(parts[0][0]).concat(parts[1][0]).toUpperCase();\n      }\n      return name.substring(0, 2).toUpperCase();\n    },\n    getAvatarColor: function getAvatarColor(name) {\n      if (!name || name === 'System') return '#64748b';\n      var hash = 0;\n      for (var i = 0; i < name.length; i++) {\n        hash = name.charCodeAt(i) + ((hash << 5) - hash);\n      }\n      var colors = ['#6366f1', '#8b5cf6', '#ec4899', '#f43f5e', '#f97316', '#10b981', '#14b8a6', '#06b6d4', '#3b82f6'];\n      return colors[Math.abs(hash) % colors.length];\n    },\n    getActionIcon: function getActionIcon(action) {\n      var icons = {\n        'CREATE': 'pi pi-plus-circle',\n        'UPDATE': 'pi pi-pencil',\n        'DELETE': 'pi pi-trash',\n        'UPLOAD': 'pi pi-upload',\n        'EXPORT': 'pi pi-download',\n        'APPROVE': 'pi pi-check-circle',\n        'REJECT': 'pi pi-times-circle',\n        'LOGIN': 'pi pi-sign-in',\n        'LOGOUT': 'pi pi-sign-out'\n      };\n      return icons[action] || 'pi pi-info-circle';\n    },\n    getActionClass: function getActionClass(action) {\n      var classes = {\n        'CREATE': 'success',\n        'UPDATE': 'info',\n        'DELETE': 'danger',\n        'UPLOAD': 'primary',\n        'EXPORT': 'secondary',\n        'APPROVE': 'success',\n        'REJECT': 'danger',\n        'LOGIN': 'info',\n        'LOGOUT': 'warning'\n      };\n      return classes[action] || 'secondary';\n    }\n  }\n};","map":{"version":3,"names":["axios","AppLayout","Paginator","name","components","data","logs","loading","filters","action","username","date_from","date_to","currentPage","entriesPerPage","totalEntries","sortField","sortOrder","computed","sortedLogs","_this","_toConsumableArray","sort","a","b","_a$description","_b$description","aVal","bVal","Date","timestamp","user_full_name","toLowerCase","action_display","model_display_name","model_name","description","ip_address","location_display","totalPages","Math","ceil","startEntry","length","endEntry","min","mounted","loadLogs","methods","sortBy","field","getSortIcon","_this2","_asyncToGenerator","_regenerator","m","_callee","params","response","_t","w","_context","p","n","page","page_size","get","v","results","count","console","error","alert","f","onPageChange","event","changeEntriesPerPage","clearFilters","exportLogs","_this3","_callee2","queryString","url","link","_context2","start_date","end_date","URLSearchParams","toString","concat","document","createElement","href","download","toISOString","split","style","display","body","appendChild","click","removeChild","formatDateOnly","datetime","toLocaleDateString","year","month","day","formatTimeOnly","toLocaleTimeString","hour","minute","second","hour12","getInitials","parts","toUpperCase","substring","getAvatarColor","hash","i","charCodeAt","colors","abs","getActionIcon","icons","getActionClass","classes"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\AuditLogs.vue"],"sourcesContent":["<template>\n  <AppLayout>\n  <div class=\"audit-logs-container\">\n    \n    <!-- Page Header -->\n    <div class=\"page-header\">\n      <div class=\"header-content\">\n        <div class=\"breadcrumb-nav\">\n          <router-link to=\"/\" class=\"breadcrumb-item\">\n            <i class=\"pi pi-home\"></i> Home\n          </router-link>\n          <span class=\"breadcrumb-separator\">/</span>\n          <span class=\"breadcrumb-item active\">Audit Logs</span>\n        </div>\n        <div class=\"header-title-section\">\n          <div class=\"title-with-icon\">\n            <div class=\"icon-wrapper\">\n              <i class=\"pi pi-shield\"></i>\n            </div>\n            <div>\n              <h1>System Audit Logs</h1>\n              <p class=\"subtitle\">Monitor system activities, user actions, and security events in real-time.</p>\n            </div>\n          </div>\n          <div class=\"header-actions\">\n            <button @click=\"loadLogs\" class=\"btn-icon-header\" title=\"Refresh\">\n              <i class=\"pi pi-refresh\" :class=\"{ 'pi-spin': loading }\"></i>\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"content-section\">\n      \n      <!-- Filters -->\n      <div class=\"filters-card\">\n        <div class=\"card-header\">\n          <i class=\"pi pi-filter\"></i>\n          <h3>Search & Filter</h3>\n        </div>\n        <div class=\"filters-grid\">\n          <div class=\"filter-group\">\n            <label>Action Type</label>\n            <div class=\"input-with-icon\">\n              <i class=\"pi pi-bolt\"></i>\n              <select v-model=\"filters.action\">\n                <option value=\"\">All Actions</option>\n                <option value=\"CREATE\">Create</option>\n                <option value=\"UPDATE\">Update</option>\n                <option value=\"DELETE\">Delete</option>\n                <option value=\"UPLOAD\">Upload</option>\n                <option value=\"EXPORT\">Export</option>\n                <option value=\"APPROVE\">Approve</option>\n                <option value=\"REJECT\">Reject</option>\n                <option value=\"LOGIN\">Login</option>\n                <option value=\"LOGOUT\">Logout</option>\n              </select>\n            </div>\n          </div>\n          \n          <div class=\"filter-group\">\n            <label>User</label>\n            <div class=\"input-with-icon\">\n              <i class=\"pi pi-user\"></i>\n              <input type=\"text\" v-model=\"filters.username\" placeholder=\"Search by name...\">\n            </div>\n          </div>\n          \n          <div class=\"filter-group\">\n            <label>Date From</label>\n            <div class=\"input-with-icon\">\n              <i class=\"pi pi-calendar\"></i>\n              <input type=\"date\" v-model=\"filters.date_from\">\n            </div>\n          </div>\n          \n          <div class=\"filter-group\">\n            <label>Date To</label>\n            <div class=\"input-with-icon\">\n              <i class=\"pi pi-calendar\"></i>\n              <input type=\"date\" v-model=\"filters.date_to\">\n            </div>\n          </div>\n          \n          <div class=\"filter-actions\">\n            <button @click=\"clearFilters\" class=\"btn-secondary\">\n              <i class=\"pi pi-times\"></i> Clear\n            </button>\n            <button @click=\"exportLogs\" class=\"btn-export\">\n              <i class=\"pi pi-file-excel\"></i> Export CSV\n            </button>\n            <button @click=\"loadLogs\" class=\"btn-primary\">\n              <i class=\"pi pi-search\"></i> Search\n            </button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Audit Logs Table -->\n      <div v-if=\"loading\" class=\"loading-state card-box\">\n        <div class=\"spinner-ring\"></div>\n        <p>Loading audit logs securely...</p>\n      </div>\n\n      <div v-else-if=\"logs.length === 0\" class=\"empty-state card-box\">\n        <div class=\"empty-icon-wrapper\">\n          <i class=\"pi pi-inbox\"></i>\n        </div>\n        <h3>No Records Found</h3>\n        <p>There are no audit logs matching your current filters.</p>\n        <button @click=\"clearFilters\" class=\"btn-primary mt-3\">Clear Filters</button>\n      </div>\n\n      <div v-else class=\"table-wrapper\">\n        <!-- Table Header with Entries Selector -->\n        <div class=\"table-header\">\n          <div class=\"entries-selector\">\n            <label>Show</label>\n            <select v-model.number=\"entriesPerPage\" @change=\"changeEntriesPerPage\" class=\"entries-dropdown\">\n              <option :value=\"10\">10</option>\n              <option :value=\"25\">25</option>\n              <option :value=\"50\">50</option>\n              <option :value=\"100\">100</option>\n            </select>\n            <label>entries</label>\n          </div>\n          <div class=\"table-stats\">\n            Showing {{ startEntry }} to {{ endEntry }} of {{ totalEntries }} logs\n          </div>\n        </div>\n\n        <!-- Table -->\n        <div class=\"table-container\">\n          <table class=\"audit-table\">\n            <thead>\n              <tr>\n                <th class=\"sortable\" @click=\"sortBy('timestamp')\">\n                  Timestamp <i :class=\"['pi', getSortIcon('timestamp'), 'sort-icon']\"></i>\n                </th>\n                <th class=\"sortable\" @click=\"sortBy('user')\">\n                  User <i :class=\"['pi', getSortIcon('user'), 'sort-icon']\"></i>\n                </th>\n                <th class=\"sortable\" @click=\"sortBy('action')\">\n                  Action <i :class=\"['pi', getSortIcon('action'), 'sort-icon']\"></i>\n                </th>\n                <th class=\"sortable\" @click=\"sortBy('model')\">\n                  Target <i :class=\"['pi', getSortIcon('model'), 'sort-icon']\"></i>\n                </th>\n                <th class=\"sortable\" @click=\"sortBy('description')\">\n                  Details <i :class=\"['pi', getSortIcon('description'), 'sort-icon']\"></i>\n                </th>\n                <th class=\"sortable nowrap\" @click=\"sortBy('ip_address')\">\n                  Network <i :class=\"['pi', getSortIcon('ip_address'), 'sort-icon']\"></i>\n                </th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr v-for=\"log in sortedLogs\" :key=\"log.id\">\n                <td class=\"time-cell\">\n                  <div class=\"date-text\">{{ formatDateOnly(log.timestamp) }}</div>\n                  <div class=\"time-text\">{{ formatTimeOnly(log.timestamp) }}</div>\n                </td>\n                <td>\n                  <div class=\"user-cell\">\n                    <div class=\"user-avatar\" :style=\"{ backgroundColor: getAvatarColor(log.user_full_name) }\">\n                      {{ getInitials(log.user_full_name) }}\n                    </div>\n                    <span class=\"user-name\">{{ log.user_full_name || 'System' }}</span>\n                  </div>\n                </td>\n                <td>\n                  <span :class=\"['action-badge', getActionClass(log.action)]\">\n                    <i :class=\"getActionIcon(log.action)\"></i>\n                    {{ log.action_display || log.action }}\n                  </span>\n                </td>\n                <td>\n                  <div class=\"model-badge\">\n                    {{ log.model_display_name || log.model_name || 'System' }}\n                  </div>\n                </td>\n                <td class=\"description-cell\">\n                  <div class=\"desc-text\" :title=\"log.description\">{{ log.description }}</div>\n                </td>\n                <td class=\"network-cell\">\n                  <div class=\"ip-text\"><i class=\"pi pi-desktop\"></i> {{ log.ip_address || 'N/A' }}</div>\n                  <div class=\"loc-text\"><i class=\"pi pi-map-marker\"></i> {{ log.location_display || 'Internal Network' }}</div>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n\n        <!-- Pagination Controls -->\n        <Paginator \n          :rows=\"entriesPerPage\" \n          :totalRecords=\"totalEntries\" \n          :first=\"(currentPage - 1) * entriesPerPage\"\n          @page=\"onPageChange($event)\"\n          template=\"FirstPageLink PrevPageLink PageLinks NextPageLink LastPageLink\"\n          :pageLinkSize=\"5\"\n        />\n      </div>\n    </div>\n  </div>\n  </AppLayout>\n</template>\n\n<script>\nimport axios from 'axios';\nimport AppLayout from './AppLayout.vue';\nimport Paginator from 'primevue/paginator';\n\nexport default {\n  name: 'AuditLogs',\n  components: {\n    AppLayout,\n    Paginator\n  },\n  data() {\n    return {\n      logs: [],\n      loading: false,\n      filters: {\n        action: '',\n        username: '',\n        date_from: '',\n        date_to: ''\n      },\n      // Pagination\n      currentPage: 1,\n      entriesPerPage: 10,\n      totalEntries: 0,\n      // Sorting\n      sortField: 'timestamp',\n      sortOrder: -1 // -1 for descending, 1 for ascending\n    };\n  },\n  computed: {\n    sortedLogs() {\n      return [...this.logs].sort((a, b) => {\n        let aVal, bVal;\n        \n        switch(this.sortField) {\n          case 'timestamp':\n            aVal = new Date(a.timestamp);\n            bVal = new Date(b.timestamp);\n            break;\n          case 'user':\n            aVal = (a.user_full_name || 'System').toLowerCase();\n            bVal = (b.user_full_name || 'System').toLowerCase();\n            break;\n          case 'action':\n            aVal = (a.action_display || a.action || '').toLowerCase();\n            bVal = (b.action_display || b.action || '').toLowerCase();\n            break;\n          case 'model':\n            aVal = (a.model_display_name || a.model_name || '').toLowerCase();\n            bVal = (b.model_display_name || b.model_name || '').toLowerCase();\n            break;\n          case 'description':\n            aVal = a.description?.toLowerCase() || '';\n            bVal = b.description?.toLowerCase() || '';\n            break;\n          case 'ip_address':\n            aVal = a.ip_address || '';\n            bVal = b.ip_address || '';\n            break;\n          case 'location':\n            aVal = (a.location_display || '').toLowerCase();\n            bVal = (b.location_display || '').toLowerCase();\n            break;\n          default:\n            return 0;\n        }\n        \n        if (aVal < bVal) return -1 * this.sortOrder;\n        if (aVal > bVal) return 1 * this.sortOrder;\n        return 0;\n      });\n    },\n    totalPages() {\n      return Math.ceil(this.totalEntries / this.entriesPerPage);\n    },\n    startEntry() {\n      return this.logs.length === 0 ? 0 : (this.currentPage - 1) * this.entriesPerPage + 1;\n    },\n    endEntry() {\n      return Math.min(this.currentPage * this.entriesPerPage, this.totalEntries);\n    }\n  },\n  mounted() {\n    this.loadLogs();\n  },\n  methods: {\n    sortBy(field) {\n      if (this.sortField === field) {\n        this.sortOrder = this.sortOrder * -1;\n      } else {\n        this.sortField = field;\n        this.sortOrder = 1;\n      }\n    },\n    getSortIcon(field) {\n      if (this.sortField !== field) {\n        return 'pi-sort-alt';\n      }\n      return this.sortOrder === 1 ? 'pi-sort-amount-up' : 'pi-sort-amount-down';\n    },\n    async loadLogs() {\n      this.loading = true;\n      try {\n        const params = {\n          page: this.currentPage,\n          page_size: this.entriesPerPage\n        };\n        if (this.filters.action) params.action = this.filters.action;\n        if (this.filters.username) params.username = this.filters.username;\n        if (this.filters.date_from) params.date_from = this.filters.date_from;\n        if (this.filters.date_to) params.date_to = this.filters.date_to;\n\n        const response = await axios.get('http://localhost:8000/api/audit-logs/', { params });\n        \n        if (response.data.results) {\n          this.logs = response.data.results;\n          this.totalEntries = response.data.count || 0;\n        } else {\n          this.logs = response.data || [];\n          this.totalEntries = this.logs.length;\n        }\n      } catch (error) {\n        console.error('Error loading audit logs:', error);\n        alert('Failed to load audit logs');\n        this.logs = [];\n        this.totalEntries = 0;\n      } finally {\n        this.loading = false;\n      }\n    },\n    onPageChange(event) {\n      this.currentPage = event.page + 1;\n      this.loadLogs();\n    },\n    changeEntriesPerPage() {\n      this.currentPage = 1;\n      this.loadLogs();\n    },\n    clearFilters() {\n      this.filters = {\n        action: '',\n        username: '',\n        date_from: '',\n        date_to: ''\n      };\n      this.currentPage = 1;\n      this.loadLogs();\n    },\n    async exportLogs() {\n      try {\n        const params = {};\n        if (this.filters.action) params.action = this.filters.action;\n        if (this.filters.username) params.username = this.filters.username;\n        if (this.filters.date_from) params.start_date = this.filters.date_from;\n        if (this.filters.date_to) params.end_date = this.filters.date_to;\n\n        const queryString = new URLSearchParams(params).toString();\n        const url = `http://localhost:8000/api/audit-logs/export/?${queryString}`;\n        \n        const link = document.createElement('a');\n        link.href = url;\n        link.