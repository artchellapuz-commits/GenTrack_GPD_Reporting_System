{"ast":null,"code":"import AppSkeleton from './AppSkeleton.vue';\nexport default {\n  name: 'ContentSkeleton',\n  components: {\n    AppSkeleton: AppSkeleton\n  },\n  props: {\n    /** When true, shows default or #skeleton slot */\n    loading: {\n      type: Boolean,\n      required: true\n    },\n    /** Passed to AppSkeleton when using default skeleton slot (optional) */\n    skeletonProps: {\n      type: Object,\n      \"default\": function _default() {\n        return {\n          type: 'card',\n          count: 4\n        };\n      }\n    }\n  }\n};","map":{"version":3,"names":["AppSkeleton","name","components","props","loading","type","Boolean","required","skeletonProps","Object","default","count"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\common\\ContentSkeleton.vue"],"sourcesContent":["<template>\r\n  <!--\r\n    Swaps skeleton and real content with a smooth cross-fade.\r\n    Usage:\r\n      <ContentSkeleton :loading=\"isLoading\">\r\n        <template #skeleton>\r\n          <AppSkeleton type=\"table\" :rows=\"8\" :cols=\"6\" />\r\n        </template>\r\n        <YourTable :data=\"rows\" />\r\n      </ContentSkeleton>\r\n  -->\r\n  <div class=\"relative w-full\">\r\n    <Transition name=\"skeleton-crossfade\" mode=\"out-in\">\r\n      <div v-if=\"loading\" :key=\"'sk'\" class=\"w-full\">\r\n        <slot name=\"skeleton\">\r\n          <AppSkeleton v-bind=\"skeletonProps\" />\r\n        </slot>\r\n      </div>\r\n      <div v-else :key=\"'content'\" class=\"w-full animate-fade-in-up\">\r\n        <slot />\r\n      </div>\r\n    </Transition>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport AppSkeleton from './AppSkeleton.vue';\r\n\r\nexport default {\r\n  name: 'ContentSkeleton',\r\n  components: { AppSkeleton },\r\n  props: {\r\n    /** When true, shows default or #skeleton slot */\r\n    loading: {\r\n      type: Boolean,\r\n      required: true,\r\n    },\r\n    /** Passed to AppSkeleton when using default skeleton slot (optional) */\r\n    skeletonProps: {\r\n      type: Object,\r\n      default: () => ({ type: 'card', count: 4 }),\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.skeleton-crossfade-enter-active,\r\n.skeleton-crossfade-leave-active {\r\n  transition: opacity 0.25s ease;\r\n}\r\n\r\n.skeleton-crossfade-enter-from,\r\n.skeleton-crossfade-leave-to {\r\n  opacity: 0;\r\n}\r\n</style>\r\n"],"mappings":"AA0BA,OAAOA,WAAU,MAAO,mBAAmB;AAE3C,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,UAAU,EAAE;IAAEF,WAAU,EAAVA;EAAY,CAAC;EAC3BG,KAAK,EAAE;IACL;IACAC,OAAO,EAAE;MACPC,IAAI,EAAEC,OAAO;MACbC,QAAQ,EAAE;IACZ,CAAC;IACD;IACAC,aAAa,EAAE;MACbH,IAAI,EAAEI,MAAM;MACZ,WAAS,SAATC,QAAOA,CAAA;QAAA,OAAS;UAAEL,IAAI,EAAE,MAAM;UAAEM,KAAK,EAAE;QAAE,CAAC;MAAA;IAC5C;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}