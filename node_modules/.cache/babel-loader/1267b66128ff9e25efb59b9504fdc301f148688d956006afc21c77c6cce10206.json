     }, _toConsumableArray(_cache[16] || (_cache[16] = [_createElementVNode(\"i\", {\n          \"class\": \"pi pi-trash\"\n        }, null, -1 /* CACHED */)])), 8 /* PROPS */, _hoisted_24)])]), _createElementVNode(\"div\", _hoisted_25, [_createElementVNode(\"p\", _hoisted_26, _toDisplayString(signature.position || 'No position'), 1 /* TEXT */), _createElementVNode(\"p\", _hoisted_27, _toDisplayString($options.getRoleDisplay(signature.role)), 1 /* TEXT */)]), _createElementVNode(\"div\", _hoisted_28, [signature.signature_image ? (_openBlock(), _createElementBlock(\"img\", {\n          key: 0,\n          src: signature.signature_image,\n          alt: \"\".concat(signature.name, \" signature\"),\n          \"class\": \"signature-image\"\n        }, null, 8 /* PROPS */, _hoisted_29)) : (_openBlock(), _createElementBlock(\"div\", _hoisted_30, _toConsumableArray(_cache[17] || (_cache[17] = [_createElementVNode(\"i\", {\n          \"class\": \"pi pi-image\"\n        }, null, -1 /* CACHED */), _createElementVNode(\"span\", null, \"No signature image\", -1 /* CACHED */)]))))])]);\n      }), 128 /* KEYED_FRAGMENT */))]))])])])];\n    }),\n    _: 1 /* STABLE */\n  });\n}","map":{"version":3,"names":["_createBlock","_component_AppLayout","_createElementVNode","_hoisted_1","_createCommentVNode","_hoisted_2","_hoisted_3","_hoisted_4","_hoisted_5","_hoisted_6","$data","newSignature","name","$event","type","placeholder","_hoisted_7","position","_hoisted_8","role","value","_hoisted_9","_hoisted_10","ref","accept","onChange","_cache","$options","handleFileSelect","apply","arguments","onClick","_ctx","$refs","fileInput","click","file","_createElementBlock","_hoisted_11","_toDisplayString","_hoisted_12","addSignature","disabled","canAddSignature","saving","_hoisted_14","_hoisted_15","_hoisted_16","_hoisted_17","loading","_hoisted_18","_toConsumableArray","validSignatures","length","_hoisted_19","_hoisted_20","_Fragment","_renderList","signature","index","key","id","concat","_hoisted_21","_hoisted_22","editSignature","deleteSignature","_hoisted_25","_hoisted_26","_hoisted_27","getRoleDisplay","_hoisted_28","signature_image","src","alt","_hoisted_30"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\AdminSignatureManagement.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n    <div class=\"admin-signature-management\">\r\n      <div class=\"page-header\">\r\n        <h2 class=\"page-title\">Admin Signature Management</h2>\r\n        <p class=\"page-description\">\r\n          Manage signatures for personnel who don't have system accounts\r\n        </p>\r\n      </div>\r\n\r\n      <!-- Add New Signature -->\r\n      <div class=\"card\">\r\n        <div class=\"card-header\">\r\n          <h3 class=\"card-title\">\r\n            <i class=\"pi pi-plus\"></i>\r\n            Add New Signature\r\n          </h3>\r\n        </div>\r\n        <div class=\"card-body\">\r\n          <div class=\"add-signature-form\">\r\n            <div class=\"form-row\">\r\n              <div class=\"form-group\">\r\n                <label>Full Name (as appears in reports)</label>\r\n                <input \r\n                  v-model=\"newSignature.name\" \r\n                  type=\"text\" \r\n                  placeholder=\"e.g., JMM MATA, C.C. AMIGABLE JR.\"\r\n                  class=\"form-input\"\r\n                />\r\n              </div>\r\n              <div class=\"form-group\">\r\n                <label>Position/Title</label>\r\n                <input \r\n                  v-model=\"newSignature.position\" \r\n                  type=\"text\" \r\n                  placeholder=\"e.g., Manager, GPD\"\r\n                  class=\"form-input\"\r\n                />\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"form-group\">\r\n              <label>Role in Reports</label>\r\n              <select v-model=\"newSignature.role\" class=\"form-select\">\r\n                <option value=\"\">Select Role</option>\r\n                <option value=\"PREPARED_BY\">Prepared by (Principal Engineer)</option>\r\n                <option value=\"CHECKED_BY_MANAGER\">Checked by (Manager)</option>\r\n                <option value=\"CHECKED_BY_ACTING\">Checked by (Acting Manager)</option>\r\n                <option value=\"APPROVED_BY_DEPT\">Approved by (Department Manager)</option>\r\n                <option value=\"APPROVED_BY_ACTING_DEPT\">Approved by (Acting Department Manager)</option>\r\n              </select>\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n              <label>Signature Image</label>\r\n              <div class=\"signature-upload\">\r\n                <input \r\n                  ref=\"fileInput\"\r\n                  type=\"file\" \r\n                  accept=\"image/*\" \r\n                  @change=\"handleFileSelect\"\r\n                  class=\"file-input\"\r\n                />\r\n                <button @click=\"$refs.fileInput.click()\" class=\"upload-btn\">\r\n                  <i class=\"pi pi-upload\"></i>\r\n                  Choose Signature Image\r\n                </button>\r\n                <span v-if=\"newSignature.file\" class=\"file-name\">\r\n                  {{ newSignature.file.name }}\r\n                </span>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"form-actions\">\r\n              <button \r\n                @click=\"addSignature\" \r\n                :disabled=\"!canAddSignature || saving\"\r\n                class=\"btn-add\"\r\n              >\r\n                <i v-if=\"!saving\" class=\"pi pi-save\"></i>\r\n                <i v-else class=\"pi pi-spin pi-spinner\"></i>\r\n                {{ saving ? 'Adding...' : 'Add Signature' }}\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Existing Signatures -->\r\n      <div class=\"card\">\r\n        <div class=\"card-header\">\r\n          <h3 class=\"card-title\">\r\n            <i class=\"pi pi-users\"></i>\r\n            Existing Signatures\r\n          </h3>\r\n        </div>\r\n        <div class=\"card-body\">\r\n          <div v-if=\"loading\" class=\"loading-state\">\r\n            <i class=\"pi pi-spin pi-spinner\"></i>\r\n            Loading signatures...\r\n          </div>\r\n          \r\n          <div v-else-if=\"validSignatures.length === 0\" class=\"empty-state\">\r\n            <i class=\"pi pi-inbox\"></i>\r\n            <p>No signatures added yet</p>\r\n          </div>\r\n\r\n          <div v-else class=\"signatures-grid\">\r\n            <div \r\n              v-for=\"(signature, index) in validSignatures\" \r\n              :key=\"signature.id || `signature-${index}`\"\r\n              class=\"signature-card\"\r\n            >\r\n              <div class=\"signature-header\">\r\n                <h4>{{ signature.name || 'Unknown' }}</h4>\r\n                <div class=\"signature-actions\">\r\n                  <button @click=\"editSignature(signature)\" class=\"btn-edit\">\r\n                    <i class=\"pi pi-pencil\"></i>\r\n                  </button>\r\n                  <button @click=\"deleteSignature(signature)\" class=\"btn-delete\">\r\n                    <i class=\"pi pi-trash\"></i>\r\n                  </button>\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"signature-info\">\r\n                <p class=\"position\">{{ signature.position || 'No position' }}</p>\r\n                <p class=\"role\">{{ getRoleDisplay(signature.role) }}</p>\r\n              </div>\r\n              \r\n              <div class=\"signature-preview\">\r\n                <img \r\n                  v-if=\"signature.signature_image\" \r\n                  :src=\"signature.signature_image\" \r\n                  :alt=\"`${signature.name} signature`\"\r\n                  class=\"signature-image\"\r\n                />\r\n                <div v-else class=\"no-signature\">\r\n                  <i class=\"pi pi-image\"></i>\r\n                  <span>No signature image</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </AppLayout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from './AppLayout.vue';\r\nimport api from '../services/api';\r\n\r\n// Import toast utility with fallback\r\nlet toast;\r\ntry {\r\n  toast = require('../utils/toast').default;\r\n} catch (error) {\r\n  console.warn('Toast utility not available:', error);\r\n  toast = {\r\n    success: (msg) => console.log('SUCCESS:', msg),\r\n    error: (msg) => console.error('ERROR:', msg),\r\n    info: (msg) => console.log('INFO:', msg)\r\n  };\r\n}\r\n\r\nexport default {\r\n  name: 'AdminSignatureManagement',\r\n  components: {\r\n    AppLayout\r\n  },\r\n  data() {\r\n    return {\r\n      signatures: [], // Always initialize as empty array\r\n      loading: true,\r\n      saving: false,\r\n      newSignature: {\r\n        name: '',\r\n        position: '',\r\n        role: '',\r\n        file: null\r\n      }\r\n    };\r\n  },\r\n  computed: {\r\n    canAddSignature() {\r\n      return this.newSignature.name && \r\n             this.newSignature.position && \r\n             this.newSignature.role && \r\n             this.newSignature.file;\r\n    },\r\n    validSignatures() {\r\n      // Filter out null/undefined signatures and ensure they have required properties\r\n      try {\r\n        if (!Array.isArray(this.signatures)) {\r\n          console.warn('Signatures is not an array:', this.signatures);\r\n          return [];\r\n        }\r\n        \r\n        const filtered = this.signatures.filter(signature => {\r\n          const isValid = signature && \r\n            typeof signature === 'object' &&\r\n            signature.id !== null && \r\n            signature.id !== undefined &&\r\n            signature.name;\r\n          \r\n          if (!isValid) {\r\n            console.warn('Invalid signature found:', signature);\r\n          }\r\n          \r\n          return isValid;\r\n        });\r\n        \r\n        console.log('Valid signatures:', filtered);\r\n        return filtered;\r\n      } catch (error) {\r\n        console.error('Error in validSignatures computed:', error);\r\n        return [];\r\n      }\r\n    }\r\n  },\r\n  watch: {\r\n    signatures: {\r\n      handler(newSignatures) {\r\n        console.log('Signatures changed:', newSignatures);\r\n        // Check for any null or invalid entries\r\n        const invalidEntries = newSignatures.filter(sig => !sig || !sig.id);\r\n        if (invalidEntries.length > 0) {\r\n          console.warn('Found invalid signature entries:', invalidEntries);\r\n        }\r\n      },\r\n      deep: true\r\n    }\r\n  },\r\n  mounted() {\r\n    // Check authentication and admin status before loading\r\n    this.checkAuthAndPermissions();\r\n  },\r\n  methods: {\r\n    async checkAuthAndPermissions() {\r\n      // Check if user is authenticated\r\n      const token = localStorage.getItem('access_token');\r\n      if (!token) {\r\n        toast.error('You must be logged in to access admin signature management');\r\n        this.$router.push('/login');\r\n        return;\r\n      }\r\n\r\n      // Check if user has admin privileges\r\n      const user = JSON.parse(localStorage.getItem('user') || '{}');\r\n      const isAdmin = user.is_staff || (user.profile && user.profile.role === 'ADMIN');\r\n      \r\n      if (!isAdmin) {\r\n        toast.error('Admin privileges required to access signature management');\r\n        this.$router.push('/dashboard');\r\n        return;\r\n      }\r\n\r\n      // If all checks pass, load signatures\r\n      this.loadSignatures();\r\n    },\r\n\r\n    async loadSignatures() {\r\n      try {\r\n        this.loading = true;\r\n        console.log('Loading admin signatures...');\r\n        const response = await api.getAdminSignatures();\r\n        console.log('API response:', response);\r\n        \r\n        // Ensure we have a valid array and filter out any null/undefined entries\r\n        if (response && response.data) {\r\n          this.signatures = Array.isArray(response.data) ? response.data : [];\r\n          console.log('Loaded signatures:', this.signatures);\r\n        } else {\r\n          console.warn('Invalid API response structure:', response);\r\n          this.signatures = [];\r\n        }\r\n      } catch (error) {\r\n        console.error('Error loading signatures:', error);\r\n        \r\n        // Handle authentication errors specifically\r\n        if (error.response?.status === 401) {\r\n          toast.error('Authentication failed. Please log in again.');\r\n          localStorage.removeItem('access_token');\r\n          localStorage.removeItem('refresh_token');\r\n          localStorage.removeItem('user');\r\n          this.$router.push('/login');\r\n          return;\r\n        }\r\n        \r\n        // Handle permission errors\r\n        if (error.response?.status === 403) {\r\n          toast.error('You do not have permission to access admin signatures.');\r\n          this.$router.push('/dashboard');\r\n          return;\r\n        }\r\n        \r\n        // Handle other errors\r\n        let errorMessage = 'Failed to load signatures';\r\n        if (error.response?.data?.error?.message) {\r\n          errorMessage = error.response.data.error.message;\r\n        } else if (error.message) {\r\n          errorMessage = error.message;\r\n        }\r\n        \r\n        toast.error(errorMessage);\r\n        // Set to empty array on error to prevent null access\r\n        this.signatures = [];\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n\r\n    handleFileSelect(event) {\r\n      const file = event.target.files[0];\r\n      if (file) {\r\n        this.newSignature.file = file;\r\n      }\r\n    },\r\n\r\n    async addSignature() {\r\n      if (!this.canAddSignature) return;\r\n\r\n      this.saving = true;\r\n      try {\r\n        const formData = new FormData();\r\n        formData.append('name', this.newSignature.name);\r\n        formData.append('position', this.newSignature.position);\r\n        formData.append('role', this.newSignature.role);\r\n        formData.append('signature_image', this.newSignature.file);\r\n\r\n        await api.addAdminSignature(formData);\r\n        \r\n        toast.success('Signature added successfully!');\r\n        \r\n        // Reset form\r\n        this.newSignature = {\r\n          name: '',\r\n          position: '',\r\n          role: '',\r\n          file: null\r\n        };\r\n        this.$refs.fileInput.value = '';\r\n        \r\n        // Reload signatures\r\n        this.loadSignatures();\r\n        \r\n      } catch (error) {\r\n        console.error('Error adding signature:', error);\r\n        \r\n        let errorMessage = 'Failed to add signature';\r\n        \r\n        // Handle different types of errors\r\n        if (error.response?.data) {\r\n          const errorData = error.response.data;\r\n          \r\n          // Handle validation errors\r\n          if (errorData.non_field_errors) {\r\n            errorMessage = errorData.non_field_errors[0];\r\n          } else if (errorData.name) {\r\n            errorMessage = `Name error: ${errorData.name[0]}`;\r\n          } else if (errorData.role) {\r\n            errorMessage = `Role error: ${errorData.role[0]}`;\r\n          } else if (errorData.signature_image) {\r\n            errorMessage = `Image error: ${errorData.signature_image[0]}`;\r\n          } else if (errorData.error) {\r\n            errorMessage = errorData.error;\r\n          } else if (typeof errorData === 'string') {\r\n            errorMessage = errorData;\r\n          }\r\n        } else if (error.message) {\r\n          errorMessage = error.message;\r\n      