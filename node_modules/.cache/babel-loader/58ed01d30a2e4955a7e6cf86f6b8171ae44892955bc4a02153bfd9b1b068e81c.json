nature'\r\n    },\r\n    width: {\r\n      type: Number,\r\n      default: 400\r\n    },\r\n    height: {\r\n      type: Number,\r\n      default: 150\r\n    },\r\n    strokeColor: {\r\n      type: String,\r\n      default: '#000080'\r\n    },\r\n    strokeWidth: {\r\n      type: Number,\r\n      default: 2\r\n    }\r\n  },\r\n  emits: ['signature-saved', 'signature-cleared'],\r\n  data() {\r\n    return {\r\n      isDrawing: false,\r\n      hasSignature: false,\r\n      lastX: 0,\r\n      lastY: 0,\r\n      ctx: null\r\n    };\r\n  },\r\n  mounted() {\r\n    this.initCanvas();\r\n  },\r\n  methods: {\r\n    initCanvas() {\r\n      const canvas = this.$refs.canvas;\r\n      this.ctx = canvas.getContext('2d');\r\n      \r\n      // Set canvas size\r\n      canvas.width = this.width;\r\n      canvas.height = this.height;\r\n      \r\n      // Set drawing properties\r\n      this.ctx.strokeStyle = this.strokeColor;\r\n      this.ctx.lineWidth = this.strokeWidth;\r\n      this.ctx.lineCap = 'round';\r\n      this.ctx.lineJoin = 'round';\r\n      \r\n      // Set white background\r\n      this.ctx.fillStyle = 'white';\r\n      this.ctx.fillRect(0, 0, canvas.width, canvas.height);\r\n    },\r\n    \r\n    getEventPos(e) {\r\n      const canvas = this.$refs.canvas;\r\n      const rect = canvas.getBoundingClientRect();\r\n      \r\n      let clientX, clientY;\r\n      \r\n      if (e.touches && e.touches.length > 0) {\r\n        // Touch event\r\n        clientX = e.touches[0].clientX;\r\n        clientY = e.touches[0].clientY;\r\n      } else {\r\n        // Mouse event\r\n        clientX = e.clientX;\r\n        clientY = e.clientY;\r\n      }\r\n      \r\n      return {\r\n        x: clientX - rect.left,\r\n        y: clientY - rect.top\r\n      };\r\n    },\r\n    \r\n    startDrawing(e) {\r\n      e.preventDefault();\r\n      this.isDrawing = true;\r\n      \r\n      const pos = this.getEventPos(e);\r\n      this.lastX = pos.x;\r\n      this.lastY = pos.y;\r\n      \r\n