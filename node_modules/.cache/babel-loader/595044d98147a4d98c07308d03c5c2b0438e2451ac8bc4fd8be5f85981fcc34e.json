oveRequest: function approveRequest() {\n      var _this3 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee3() {\n        var _error$response3, _error$response4, _error$response$data2, _t3;\n        return _regenerator().w(function (_context3) {\n          while (1) switch (_context3.p = _context3.n) {\n            case 0:\n              _context3.p = 0;\n              _this3.approving = true;\n              _context3.n = 1;\n              return api.approveRequestWithExistingSignature(_this3.token);\n            case 1:\n              _this3.approved = true;\n              _context3.n = 3;\n              break;\n            case 2:\n              _context3.p = 2;\n              _t3 = _context3.v;\n              console.error('Error approving request:', _t3);\n              if (((_error$response3 = _t3.response) === null || _error$response3 === void 0 ? void 0 : _error$response3.status) === 400) {\n                _this3.error = ((_error$response$data2 = _t3.response.data) === null || _error$response$data2 === void 0 ? void 0 : _error$response$data2.error) || 'Failed to approve request.';\n              } else if (((_error$response4 = _t3.response) === null || _error$response4 === void 0 ? void 0 : _error$response4.status) === 404) {\n                _this3.error = 'Authorization request not found or has expired.';\n              } else {\n                _this3.error = 'Failed to approve request. Please try again.';\n              }\n            case 3:\n              _context3.p = 3;\n              _this3.approving = false;\n              return _context3.f(3);\n            case 4:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[0, 2, 3, 4]]);\n      }))();\n    },\n    formatDate: function formatDate(dateString) {\n      if (!dateString) return 'N/A';\n      return new Date(dateString).toLocaleDateString('en-US', {\n        year: 'numeric',\n        month: 'long',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    }\n  }\n};","map":{"version":3,"names":["api","name","props","token","type","String","required","data","loading","error","approved","approving","authorizationDetails","existingSignature","mounted","_this","_asyncToGenerator","_regenerator","m","_callee","w","_context","n","loadAuthorizationDetails","a","methods","_this2","_callee2","response","sigResponse","_error$response","_error$response2","_error$response$data","_t","_t2","_context2","p","getAuthorizationByToken","v","signatory_name","getESignaturesBySignatory","length","console","warn","status","f","approveRequest","_this3","_callee3","_error$response3","_error$response4","_error$response$data2","_t3","_context3","approveRequestWithExistingSignature","formatDate","dateString","Date","toLocaleDateString","year","month","day","hour","minute"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\ApproveRequest.vue"],"sourcesContent":["<template>\r\n  <div class=\"approve-request-container\">\r\n    <div class=\"approve-request-card\">\r\n      <!-- Loading State -->\r\n      <div v-if=\"loading\" class=\"loading-state\">\r\n        <div class=\"spinner\"></div>\r\n        <p>Loading authorization details...</p>\r\n      </div>\r\n\r\n      <!-- Error State -->\r\n      <div v-else-if=\"error\" class=\"error-state\">\r\n        <div class=\"error-icon\">⚠️</div>\r\n        <h2>Authorization Error</h2>\r\n        <p>{{ error }}</p>\r\n        <button @click=\"$router.push('/dashboard')\" class=\"btn-primary\">\r\n          Return to Dashboard\r\n        </button>\r\n      </div>\r\n\r\n      <!-- Success State -->\r\n      <div v-else-if=\"approved\" class=\"success-state\">\r\n        <div class=\"success-icon\">✅</div>\r\n        <h2>Request Approved Successfully!</h2>\r\n        <p>Your e-signature authorization has been activated.</p>\r\n        <div class=\"success-details\">\r\n          <p><strong>Signatory:</strong> {{ authorizationDetails.signatory_name }}</p>\r\n          <p><strong>Role:</strong> {{ authorizationDetails.role }}</p>\r\n          <p><strong>Status:</strong> Active</p>\r\n        </div>\r\n        <button @click=\"$router.push('/generate')\" class=\"btn-primary\">\r\n          Start Signing Reports\r\n        </button>\r\n        <button @click=\"$router.push('/dashboard')\" class=\"btn-secondary\">\r\n          Return to Dashboard\r\n        </button>\r\n      </div>\r\n\r\n      <!-- Approval Form -->\r\n      <div v-else class=\"approval-form\">\r\n        <div class=\"header\">\r\n          <h2>E-Signature Authorization Approval</h2>\r\n          <p>Review and approve your e-signature authorization request</p>\r\n        </div>\r\n\r\n        <div class=\"authorization-details\">\r\n          <h3>Authorization Details</h3>\r\n          <div class=\"detail-row\">\r\n            <span class=\"label\">Signatory Name:</span>\r\n            <span class=\"value\">{{ authorizationDetails.signatory_name }}</span>\r\n          </div>\r\n          <div class=\"detail-row\">\r\n            <span class=\"label\">Role:</span>\r\n            <span class=\"value\">{{ authorizationDetails.role }}</span>\r\n          </div>\r\n          <div class=\"detail-row\">\r\n            <span class=\"label\">Requested By:</span>\r\n            <span class=\"value\">{{ authorizationDetails.user_name }}</span>\r\n          </div>\r\n          <div class=\"detail-row\">\r\n            <span class=\"label\">Request Date:</span>\r\n            <span class=\"value\">{{ formatDate(authorizationDetails.created_at) }}</span>\r\n          </div>\r\n          <div v-if=\"authorizationDetails.justification\" class=\"detail-row\">\r\n            <span class=\"label\">Justification:</span>\r\n            <span class=\"value\">{{ authorizationDetails.justification }}</span>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"existing-signature\">\r\n          <h3>Your Existing Signature</h3>\r\n          <p>We found an existing signature for this signatory. You can use it to approve this request.</p>\r\n          <div class=\"signature-preview\">\r\n            <img \r\n              v-if=\"existingSignature\" \r\n              :src=\"existingSignature.signature_image\" \r\n              alt=\"Your existing signature\"\r\n              class=\"signature-image\"\r\n            />\r\n            <div v-else class=\"signature-placeholder\">\r\n              <p>Loading signature...</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"approval-actions\">\r\n          <button \r\n            @click=\"approveRequest\" \r\n            :disabled=\"approving\"\r\n            class=\"btn-approve\"\r\n          >\r\n            <span v-if=\"approving\">Approving...</span>\r\n            <span v-else>✅ Approve Request</span>\r\n          </button>\r\n          <button @click=\"$router.push('/dashboard')\" class=\"btn-cancel\">\r\n            Cancel\r\n          </button>\r\n        </div>\r\n\r\n        <div class=\"security-notice\">\r\n          <p><strong>Security Notice:</strong> By clicking \"Approve Request\", you confirm that you are authorizing the use of your existing e-signature for this signatory role. This authorization will be immediately active and can be used to sign official reports.</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api';\r\n\r\nexport default {\r\n  name: 'ApproveRequest',\r\n  props: {\r\n    token: {\r\n      type: String,\r\n      required: true\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      loading: true,\r\n      error: null,\r\n      approved: false,\r\n      approving: false,\r\n      authorizationDetails: null,\r\n      existingSignature: null\r\n    };\r\n  },\r\n  async mounted() {\r\n    await this.loadAuthorizationDetails();\r\n  },\r\n  methods: {\r\n    async loadAuthorizationDetails() {\r\n      try {\r\n        this.loading = true;\r\n        this.error = null;\r\n\r\n        // Get authorization details by token\r\n        const response = await api.getAuthorizationByToken(this.token);\r\n        this.authorizationDetails = response.data;\r\n\r\n        // Load existing signature\r\n        if (this.authorizationDetails.signatory_name) {\r\n          try {\r\n            const sigResponse = await api.getESignaturesBySignatory(this.authorizationDetails.signatory_name);\r\n            if (sigResponse.data && sigResponse.data.length > 0) {\r\n              this.existingSignature = sigResponse.data[0];\r\n            }\r\n          } catch (sigError) {\r\n            console.warn('Could not load existing signature:', sigError);\r\n          }\r\n        }\r\n\r\n      } catch (error) {\r\n        console.error('Error loading authorization details:', error);\r\n        if (error.response?.status === 404) {\r\n          this.error = 'Authorization request not found or has expired.';\r\n        } else if (error.response?.status === 400) {\r\n          this.error = error.response.data?.error || 'Invalid authorization token.';\r\n        } else {\r\n          this.error = 'Failed to load authorization details. Please try again.';\r\n        }\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n\r\n    async approveRequest() {\r\n      try {\r\n        this.approving = true;\r\n        \r\n        await api.approveRequestWithExistingSignature(this.token);\r\n        \r\n        this.approved = true;\r\n        \r\n      } catch (error) {\r\n        console.error('Error approving request:', error);\r\n        if (error.response?.status === 400) {\r\n          this.error = error.response.data?.error || 'Failed to approve request.';\r\n        } else if (error.response?.status === 404) {\r\n          this.error = 'Authorization request not found or has expired.';\r\n        } else {\r\n          this.error = 'Failed to approve request. Please try again.';\r\n        }\r\n      } finally {\r\n        this.approving = false;\r\n      }\r\n    },\r\n\r\n    formatDate(dateString) {\r\n      if (!dateString) return 'N/A';\r\n      return new Date(dateString).toLocaleDateString('en-US', {\r\n        year: 'numeric',\r\n        month: 'long',\r\n        day: 'numeric',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.approve-request-container {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 20px;\r\n}\r\n\r\n.approve-request-card {\r\n  background: white;\r\n  border-radius: 12px;\r\n  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);\r\n  max-width: 600px;\r\n  width: 100%;\r\n  overflow: hidden;\r\n}\r\n\r\n.loading-state,\r\n.error-state,\r\n.success-state,\r\n.approval-form {\r\n  padding: 40px;\r\n  text-align: center;\r\n}\r\n\r\n.loading-state {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 20px;\r\n}\r\n\r\n.spinner {\r\n  width: 40px;\r\n  height: 40px;\r\n  border: 4px solid #f3f3f3;\r\n  border-top: 4px solid #667eea;\r\n  border-radius: 50%;\r\n  animation: spin 1s linear infinite;\r\n}\r\n\r\n@keyframes spin {\r\n  0% { transform: rotate(0deg); }\r\n  100% { transform: rotate(360deg); }\r\n}\r\n\r\n.error-state,\r\n.success-state {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 20px;\r\n}\r\n\r\n.error-icon,\r\n.success-icon {\r\n  font-size: 4rem;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.error-state h2 {\r\n  color: #e74c3c;\r\n  margin: 0;\r\n}\r\n\r\n.success-state h2 {\r\n  color: #27ae60;\r\n  margin: 0;\r\n}\r\n\r\n.success-details {\r\n  background: #f8f9fa;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  text-align: left;\r\n  width: 100%;\r\n  margin: 20px 0;\r\n}\r\n\r\n.success-details p {\r\n  margin: 8px 0;\r\n}\r\n\r\n.approval-form {\r\n  text-align: left;\r\n}\r\n\r\n.header {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.header h2 {\r\n  color: #2c3e50;\r\n  margin: 0 0 10px 0;\r\n}\r\n\r\n.header p {\r\n  color: #7f8c8d;\r\n  margin: 0;\r\n}\r\n\r\n.authorization-details,\r\n.existing-signature {\r\n  background: #f8f9fa;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.authorization-details h3,\r\n.existing-signature h3 {\r\n  color: #2c3e50;\r\n  margin: 0 0 15px 0;\r\n  font-size: 1.2rem;\r\n}\r\n\r\n.detail-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  margin-bottom: 10px;\r\n  padding-bottom: 10px;\r\n  border-bottom: 1px solid #ecf0f1;\r\n}\r\n\r\n.detail-row:last-child {\r\n  border-bottom: none;\r\n  margin-bottom: 0;\r\n  padding-bottom: 0;\r\n}\r\n\r\n.label {\r\n  font-weight: 600;\r\n  color: #34495e;\r\n  min-width: 120px;\r\n}\r\n\r\n.value {\r\n  color: #2c3e50;\r\n  flex: 1;\r\n  text-align: right;\r\n  word-break: break-word;\r\n}\r\n\r\n.signature-preview {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  min-height: 120px;\r\n  background: white;\r\n  border: 2px dashed #bdc3c7;\r\n  border-radius: 8px;\r\n  margin-top: 15px;\r\n}\r\n\r\n.signature-image {\r\n  max-width: 200px;\r\n  max-height: 100px;\r\n  object-fit: contain;\r\n}\r\n\r\n.signature-placeholder {\r\n  color: #7f8c8d;\r\n  font-style: italic;\r\n}\r\n\r\n.approval-actions {\r\n  display: flex;\r\n  gap: 15px;\r\n  justify-content: center;\r\n  margin: 30px 0;\r\n}\r\n\r\n.btn-approve {\r\n  background: linear-gradient(135deg, #27ae60, #2ecc71);\r\n  color: white;\r\n  border: none;\r\n  padding: 12px 30px;\r\n  border-radius: 6px;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  min-width: 160px;\r\n}\r\n\r\n.btn-approve:hover:not(:disabled) {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 5px 15px rgba(39, 174, 96, 0.3);\r\n}\r\n\r\n.btn-approve:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.btn-cancel {\r\n  background: #95a5a6;\r\n  color: white;\r\n  border: none;\r\n  padding: 12px 30px;\r\n  border-radius: 6px;\r\n  font-size: 1rem;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.btn-cancel:hover {\r\n  background: #7f8c8d;\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.btn-primary {\r\n  background: linear-gradient(135deg, #667eea, #764ba2);\r\n  color: white;\r\n  border: none;\r\n  padding: 12px 30px;\r\n  border-radius: 6px;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  margin: 0 10px;\r\n}\r\n\r\n.btn-primary:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);\r\n}\r\n\r\n.btn-secondary {\r\n  background: #ecf0f1;\r\n  color: #2c3e50;\r\n  border: 1px solid #bdc3c7;\r\n  padding: 12px 30px;\r\n  border-radius: 6px;\r\n  font-size: 1rem;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  margin: 0 10px;\r\n}\r\n\r\n.btn-secondary:hover {\r\n  background: #d5dbdb;\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.security-notice {\r\n  background: #fff3cd;\r\n  border: 1px solid #ffeaa7;\r\n  border-radius: 6px;\r\n  padding: 15px;\r\n  margin-top: 20px;\r\n}\r\n\r\n.security-notice p {\r\n  margin: 0;\r\n  color: #856404;\r\n  font-size: 0.9rem;\r\n  line-height: 1.4;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .approve-request-container {\r\n    padding: 10px;\r\n  }\r\n  \r\n  .loading-state,\r\n  .error-state,\r\n  .success-state,\r\n  .approval-form {\r\n    padding: 20px;\r\n  }\r\n  \r\n  .detail-row {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    gap: 5px;\r\n  }\r\n  \r\n  .value {\r\n    text-align: left;\r\n  }\r\n  \r\n  .approval-actions {\r\n    flex-direction: column;\r\n  }\r\n  \r\n  .btn-primary,\r\n  .btn-se