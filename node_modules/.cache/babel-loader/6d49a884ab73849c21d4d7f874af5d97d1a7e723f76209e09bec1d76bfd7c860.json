{"ast":null,"code":"import api from '../services/api';\nimport AppLayout from './AppLayout.vue';\nimport toast from '../utils/toast';\nexport default {\n  name: 'GenerateReport',\n  components: {\n    AppLayout\n  },\n  data() {\n    return {\n      plants: [],\n      startDate: '',\n      endDate: '',\n      generating: false,\n      generationHistory: [],\n      showMenu: false\n    };\n  },\n  computed: {\n    canGenerate() {\n      return this.startDate && this.endDate;\n    }\n  },\n  mounted() {\n    this.loadPlants();\n    this.loadGenerationHistory();\n    document.addEventListener('click', this.closeMenu);\n  },\n  beforeUnmount() {\n    document.removeEventListener('click', this.closeMenu);\n  },\n  methods: {\n    async loadPlants() {\n      try {\n        const response = await api.getPlants();\n        // Handle both paginated and non-paginated responses\n        this.plants = response.data.results || response.data;\n        console.log('Loaded plants:', this.plants);\n      } catch (error) {\n        console.error('Error loading plants:', error);\n        toast.error('Error loading plants: ' + (error.message || 'Unknown error'));\n      }\n    },\n    loadGenerationHistory() {\n      try {\n        const history = localStorage.getItem('reportGenerationHistory');\n        if (history) {\n          this.generationHistory = JSON.parse(history);\n          // Sort by timestamp descending (newest first)\n          this.generationHistory.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));\n        }\n      } catch (error) {\n        console.error('Error loading generation history:', error);\n        this.generationHistory = [];\n      }\n    },\n    saveToHistory(reportData) {\n      try {\n        const historyItem = {\n          ...reportData,\n          timestamp: new Date().toISOString()\n        };\n        this.generationHistory.unshift(historyItem);\n\n        // Keep only last 50 items\n        if (this.generationHistory.length > 50) {\n          this.generationHistory = this.generationHistory.slice(0, 50);\n        }\n        localStorage.setItem('reportGenerationHistory', JSON.stringify(this.generationHistory));\n      } catch (error) {\n        console.error('Error saving to history:', error);\n      }\n    },\n    clearHistory() {\n      if (confirm('Are you sure you want to clear all generation history?')) {\n        this.generationHistory = [];\n        localStorage.removeItem('reportGenerationHistory');\n        this.showMenu = false;\n        toast.success('History cleared successfully');\n      }\n    },\n    toggleMenu() {\n      this.showMenu = !this.showMenu;\n    },\n    closeMenu(e) {\n      if (this.$refs.menuButton && !this.$refs.menuButton.contains(e.target)) {\n        this.showMenu = false;\n      }\n    },\n    async regenerateReport(historyItem) {\n      this.startDate = historyItem.startDate;\n      this.endDate = historyItem.endDate;\n\n      // Scroll to top\n      window.scrollTo({\n        top: 0,\n        behavior: 'smooth'\n      });\n      toast.info('Report parameters loaded. Click \"Generate PSR Report\" to regenerate.');\n    },\n    async downloadHistoryReport(historyItem) {\n      if (this.generating) {\n        toast.warning('Please wait for the current report to finish generating');\n        return;\n      }\n      this.generating = true;\n      toast.info('Downloading report...');\n      try {\n        // Always send all plant codes for PSR reports\n        const plantCodes = this.plants.map(plant => plant.code);\n        const response = await api.generateReport({\n          plant_codes: plantCodes,\n          start_date: historyItem.startDate,\n          end_date: historyItem.endDate,\n          report_type: 'psr'\n        });\n\n        // Create download link\n        const url = window.URL.createObjectURL(new Blob([response.data]));\n        const link = document.createElement('a');\n        link.href = url;\n        link.setAttribute('download', historyItem.filename);\n        document.body.appendChild(link);\n        link.click();\n        link.remove();\n        window.URL.revokeObjectURL(url);\n        toast.success('Report downloaded successfully!');\n      } catch (error) {\n        console.error('Download report error:', error);\n        let errorMsg = 'Failed to download report';\n\n        // Handle blob response errors\n        if (error.response?.data instanceof Blob) {\n          try {\n            const text = await error.response.data.text();\n            const errorData = JSON.parse(text);\n            errorMsg = errorData.error || errorMsg;\n          } catch (e) {\n            errorMsg = error.response?.statusText || errorMsg;\n          }\n        } else if (error.response?.data?.error) {\n          errorMsg = error.response.data.error;\n        } else if (error.message) {\n          errorMsg = error.message;\n        }\n        toast.error(errorMsg, 6000);\n      } finally {\n        this.generating = false;\n      }\n    },\n    formatDateRange(startDate, endDate) {\n      if (startDate === endDate) {\n        return new Date(startDate).toLocaleDateString();\n      }\n      return `${new Date(startDate).toLocaleDateString()} - ${new Date(endDate).toLocaleDateString()}`;\n    },\n    formatTimestamp(timestamp) {\n      const date = new Date(timestamp);\n      const now = new Date();\n      const diffMs = now - date;\n      const diffMins = Math.floor(diffMs / 60000);\n      const diffHours = Math.floor(diffMs / 3600000);\n      const diffDays = Math.floor(diffMs / 86400000);\n      if (diffMins < 1) return 'Just now';\n      if (diffMins < 60) return `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;\n      if (diffHours < 24) return `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;\n      if (diffDays < 7) return `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;\n      return date.toLocaleDateString();\n    },\n    formatExactTime(timestamp) {\n      const date = new Date(timestamp);\n      const options = {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit',\n        hour12: true\n      };\n      return date.toLocaleString('en-US', options);\n    },\n    async generateReport() {\n      if (!this.canGenerate) return;\n      this.generating = true;\n      try {\n        // Always send all plant codes for PSR reports\n        const plantCodes = this.plants.map(plant => plant.code);\n        const response = await api.generateReport({\n          plant_codes: plantCodes,\n          start_date: this.startDate,\n          end_date: this.endDate,\n          report_type: 'psr'\n        });\n\n        // Create download link\n        const url = window.URL.createObjectURL(new Blob([response.data]));\n        const link = document.createElement('a');\n        link.href = url;\n\n        // Set filename for PSR report\n        const startDateStr = this.startDate.replace(/-/g, '');\n        const endDateStr = this.endDate.replace(/-/g, '');\n        let filename;\n        if (this.startDate === this.endDate) {\n          filename = `PSR_REPORT_${startDateStr}.xlsx`;\n        } else {\n          filename = `PSR_REPORT_${startDateStr}_${endDateStr}.xlsx`;\n        }\n        link.setAttribute('download', filename);\n        document.body.appendChild(link);\n        link.click();\n        link.remove();\n        window.URL.revokeObjectURL(url);\n\n        // Save to history\n        this.saveToHistory({\n          filename,\n          plantCode: 'ALL',\n          plantName: 'All Plants',\n          startDate: this.startDate,\n          endDate: this.endDate,\n          reportType: 'psr',\n          reportTypeName: 'Plant Status Report (PSR)'\n        });\n        toast.success('PSR Report generated successfully!');\n      } catch (error) {\n        console.error('Generate report error:', error);\n        let errorMsg = 'Failed to generate PSR report';\n\n        // Handle blob response errors\n        if (error.response?.data instanceof Blob) {\n          try {\n            const text = await error.response.data.text();\n            const errorData = JSON.parse(text);\n            errorMsg = errorData.error || errorMsg;\n\n            // Add helpful hint if no data found\n            if (errorMsg.includes('No data found')) {\n              errorMsg += '. Please upload Excel files first in the Upload Excel Reports page.';\n            }\n          } catch (e) {\n            errorMsg = error.response?.statusText || errorMsg;\n          }\n        } else if (error.response?.data?.error) {\n          errorMsg = error.response.data.error;\n          if (errorMsg.includes('No data found')) {\n            errorMsg += '. Please upload Excel files first in the Upload Excel Reports page.';\n          }\n        } else if (error.message) {\n          errorMsg = error.message;\n        }\n        toast.error(errorMsg, 6000);\n      } finally {\n        this.generating = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","AppLayout","toast","name","components","data","plants","startDate","endDate","generating","generationHistory","showMenu","computed","canGenerate","mounted","loadPlants","loadGenerationHistory","document","addEventListener","closeMenu","beforeUnmount","removeEventListener","methods","response","getPlants","results","console","log","error","message","history","localStorage","getItem","JSON","parse","sort","a","b","Date","timestamp","saveToHistory","reportData","historyItem","toISOString","unshift","length","slice","setItem","stringify","clearHistory","confirm","removeItem","success","toggleMenu","e","$refs","menuButton","contains","target","regenerateReport","window","scrollTo","top","behavior","info","downloadHistoryReport","warning","plantCodes","map","plant","code","generateReport","plant_codes","start_date","end_date","report_type","url","URL","createObjectURL","Blob","link","createElement","href","setAttribute","filename","body","appendChild","click","remove","revokeObjectURL","errorMsg","text","errorData","statusText","formatDateRange","toLocaleDateString","formatTimestamp","date","now","diffMs","diffMins","Math","floor","diffHours","diffDays","formatExactTime","options","year","month","day","hour","minute","second","hour12","toLocaleString","startDateStr","replace","endDateStr","plantCode","plantName","reportType","reportTypeName","includes"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\GenerateReport.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n    <div class=\"generate-report-page glass-background\">\r\n    <!-- Page Header -->\r\n    <div class=\"page-header\">\r\n      <h2 class=\"page-title\">Generate PSR Report</h2>\r\n      <p class=\"page-description\">\r\n        Generate Plant Status Reports for all Mindanao plants\r\n      </p>\r\n    </div>\r\n\r\n    <!-- Main Form Card -->\r\n    <div class=\"card glass-card glass-fade-in\">\r\n      <div class=\"card-body\">\r\n        <form @submit.prevent=\"generateReport\" class=\"report-form\">\r\n          <!-- Date Range -->\r\n          <div class=\"form-row\">\r\n            <div class=\"form-field\">\r\n              <label class=\"field-label\">\r\n                <i class=\"pi pi-calendar\"></i>\r\n                Start Date\r\n              </label>\r\n              <input \r\n                type=\"date\" \r\n                v-model=\"startDate\" \r\n                class=\"date-input glass-input\"\r\n                required\r\n              />\r\n            </div>\r\n\r\n            <div class=\"form-field\">\r\n              <label class=\"field-label\">\r\n                <i class=\"pi pi-calendar\"></i>\r\n                End Date\r\n              </label>\r\n              <input \r\n                type=\"date\" \r\n                v-model=\"endDate\" \r\n                class=\"date-input glass-input\"\r\n                required\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Generate Button -->\r\n          <button \r\n            type=\"submit\"\r\n            :disabled=\"!canGenerate || generating\"\r\n            class=\"btn-generate glass-button\"\r\n          >\r\n            <i v-if=\"!generating\" class=\"pi pi-download\"></i>\r\n            <i v-else class=\"pi pi-spin pi-spinner\"></i>\r\n            <span>{{ generating ? 'Generating PSR Report...' : 'Generate PSR Report' }}</span>\r\n          </button>\r\n        </form>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Generation History -->\r\n    <div v-if=\"generationHistory.length > 0\" class=\"card glass-card glass-fade-in mt-4\">\r\n      <div class=\"card-header\">\r\n        <h3 class=\"card-title\">\r\n          <i class=\"pi pi-history\"></i>\r\n          Generation History\r\n        </h3>\r\n        <div class=\"menu-wrapper\">\r\n          <button @click=\"toggleMenu\" class=\"btn-menu\" ref=\"menuButton\">\r\n            <i class=\"pi pi-ellipsis-v\"></i>\r\n          </button>\r\n          <transition name=\"dropdown\">\r\n            <div v-if=\"showMenu\" class=\"dropdown-menu\" @click.stop>\r\n              <button @click=\"clearHistory\" class=\"menu-item menu-item-danger\">\r\n                <i class=\"pi pi-trash\"></i>\r\n                <span>Clear History</span>\r\n              </button>\r\n            </div>\r\n          </transition>\r\n        </div>\r\n      </div>\r\n      <div class=\"card-body p-0\">\r\n        <div class=\"history-list\">\r\n          <div \r\n            v-for=\"(item, index) in generationHistory\" \r\n            :key=\"index\"\r\n            class=\"history-item\"\r\n          >\r\n            <div class=\"history-icon\">\r\n              <i class=\"pi pi-file-excel\"></i>\r\n            </div>\r\n            <div class=\"history-details\" @click=\"downloadHistoryReport(item)\" style=\"cursor: pointer;\">\r\n              <div class=\"history-main\">\r\n                <span class=\"history-filename\">{{ item.filename }}</span>\r\n                <span class=\"history-plant-badge\">{{ item.plantName }}</span>\r\n              </div>\r\n              <div class=\"history-meta\">\r\n                <span class=\"history-type\">\r\n                  <i class=\"pi pi-tag\"></i>\r\n                  {{ item.reportTypeName }}\r\n                </span>\r\n                <span class=\"history-exact-time\">\r\n                  <i class=\"pi pi-clock\"></i>\r\n                  {{ formatExactTime(item.timestamp) }}\r\n                </span>\r\n              </div>\r\n            </div>\r\n            <div class=\"history-actions\">\r\n              <button \r\n                @click=\"downloadHistoryReport(item)\" \r\n                class=\"btn-download\"\r\n                title=\"Download this report\"\r\n              >\r\n                <i class=\"pi pi-download\"></i>\r\n              </button>\r\n              <button \r\n                @click=\"regenerateReport(item)\" \r\n                class=\"btn-regenerate\"\r\n                title=\"Load parameters to regenerate\"\r\n              >\r\n                <i class=\"pi pi-refresh\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  </AppLayout>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api';\r\nimport AppLayout from './AppLayout.vue';\r\nimport toast from '../utils/toast';\r\n\r\nexport default {\r\n  name: 'GenerateReport',\r\n  components: {\r\n    AppLayout,\r\n  },\r\n  data() {\r\n    return {\r\n      plants: [],\r\n      startDate: '',\r\n      endDate: '',\r\n      generating: false,\r\n      generationHistory: [],\r\n      showMenu: false\r\n    };\r\n  },\r\n  computed: {\r\n    canGenerate() {\r\n      return this.startDate && this.endDate;\r\n    },\r\n  },\r\n  mounted() {\r\n    this.loadPlants();\r\n    this.loadGenerationHistory();\r\n    document.addEventListener('click', this.closeMenu);\r\n  },\r\n  beforeUnmount() {\r\n    document.removeEventListener('click', this.closeMenu);\r\n  },\r\n  methods: {\r\n    async loadPlants() {\r\n      try {\r\n        const response = await api.getPlants();\r\n        // Handle both paginated and non-paginated responses\r\n        this.plants = response.data.results || response.data;\r\n        console.log('Loaded plants:', this.plants);\r\n      } catch (error) {\r\n        console.error('Error loading plants:', error);\r\n        toast.error('Error loading plants: ' + (error.message || 'Unknown error'));\r\n      }\r\n    },\r\n    \r\n    loadGenerationHistory() {\r\n      try {\r\n        const history = localStorage.getItem('reportGenerationHistory');\r\n        if (history) {\r\n          this.generationHistory = JSON.parse(history);\r\n          // Sort by timestamp descending (newest first)\r\n          this.generationHistory.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));\r\n        }\r\n      } catch (error) {\r\n        console.error('Error loading generation history:', error);\r\n        this.generationHistory = [];\r\n      }\r\n    },\r\n    \r\n    saveToHistory(reportData) {\r\n      try {\r\n        const historyItem = {\r\n          ...reportData,\r\n          timestamp: new Date().toISOString(),\r\n        };\r\n        \r\n        this.generationHistory.unshift(historyItem);\r\n        \r\n        // Keep only last 50 items\r\n        if (this.generationHistory.length > 50) {\r\n          this.generationHistory = this.generationHistory.slice(0, 50);\r\n        }\r\n        \r\n        localStorage.setItem('reportGenerationHistory', JSON.stringify(this.generationHistory));\r\n      } catch (error) {\r\n        console.error('Error saving to history:', error);\r\n      }\r\n    },\r\n    \r\n    clearHistory() {\r\n      if (confirm('Are you sure you want to clear all generation history?')) {\r\n        this.generationHistory = [];\r\n        localStorage.removeItem('reportGenerationHistory');\r\n        this.showMenu = false;\r\n        toast.success('History cleared successfully');\r\n      }\r\n    },\r\n    \r\n    toggleMenu() {\r\n      this.showMenu = !this.showMenu;\r\n    },\r\n    \r\n    closeMenu(e) {\r\n      if (this.$refs.menuButton && !this.$refs.menuButton.contains(e.target)) {\r\n        this.showMenu = false;\r\n      }\r\n    },\r\n    \r\n    async regenerateReport(historyItem) {\r\n      this.startDate = historyItem.startDate;\r\n      this.endDate = historyItem.endDate;\r\n      \r\n      // Scroll to top\r\n      window.scrollTo({ top: 0, behavior: 'smooth' });\r\n      \r\n      toast.info('Report parameters loaded. Click \"Generate PSR Report\" to regenerate.');\r\n    },\r\n    \r\n    async downloadHistoryReport(historyItem) {\r\n      if (this.generating) {\r\n        toast.warning('Please wait for the current report to finish generating');\r\n        return;\r\n      }\r\n      \r\n      this.generating = true;\r\n      toast.info('Downloading report...');\r\n\r\n      try {\r\n        // Always send all plant codes for PSR reports\r\n        const plantCodes = this.plants.map(plant => plant.code);\r\n        \r\n        const response = await api.generateReport({\r\n          plant_codes: plantCodes,\r\n          start_date: historyItem.startDate,\r\n          end_date: historyItem.endDate,\r\n          report_type: 'psr',\r\n        });\r\n\r\n        // Create download link\r\n        const url = window.URL.createObjectURL(new Blob([response.data]));\r\n        const link = document.createElement('a');\r\n        link.href = url;\r\n        link.setAttribute('download', historyItem.filename);\r\n        document.body.appendChild(link);\r\n        link.click();\r\n        link.remove();\r\n        window.URL.revokeObjectURL(url);\r\n\r\n        toast.success('Report downloaded successfully!');\r\n      } catch (error) {\r\n        console.error('Download report error:', error);\r\n        let errorMsg = 'Failed to download report';\r\n        \r\n        // Handle blob response errors\r\n        if (error.response?.data instanceof Blob) {\r\n          try {\r\n            const text = await error.response.data.text();\r\n            const errorData = JSON.parse(text);\r\n            errorMsg = errorData.error || errorMsg;\r\n          } catch (e) {\r\n            errorMsg = error.response?.statusText || errorMsg;\r\n          }\r\n        } else if (error.response?.data?.error) {\r\n          errorMsg = error.response.data.error;\r\n        } else if (error.message) {\r\n          errorMsg = error.message;\r\n        }\r\n        \r\n        toast.error(errorMsg, 6000);\r\n      } finally {\r\n        this.generating = false;\r\n      }\r\n    },\r\n    \r\n    formatDateRange(startDate, endDate) {\r\n      if (startDate === endDate) {\r\n        return new Date(startDate).toLocaleDateString();\r\n      }\r\n      return `${new Date(startDate).toLocaleDateString()} - ${new Date(endDate).toLocaleDateString()}`;\r\n    },\r\n    \r\n    formatTimestamp(timestamp) {\r\n      const date = new Date(timestamp);\r\n      const now = new Date();\r\n      const diffMs = now - date;\r\n      const diffMins = Math.floor(diffMs / 60000);\r\n      const diffHours = Math.floor(diffMs / 3600000);\r\n      const diffDays = Math.floor(diffMs / 86400000);\r\n      \r\n      if (diffMins < 1) return 'Just now';\r\n      if (diffMins < 60) return `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;\r\n      if (diffHours < 24) return `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;\r\n      if (diffDays < 7) return `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;\r\n      \r\n      return date.toLocaleDateString();\r\n    },\r\n    \r\n    formatExactTime(timestamp) {\r\n      const date = new Date(timestamp);\r\n      const options = {\r\n        year: 'numeric',\r\n        month: 'short',\r\n        day: 'numeric',\r\n        hour: '2-digit',\r\n        minute: '2-digit',\r\n        second: '2-digit',\r\n        hour12: true\r\n      };\r\n      return date.toLocaleString('en-US', options);\r\n    },\r\n    \r\n    async generateReport() {\r\n      if (!this.canGenerate) return;\r\n\r\n      this.generating = true;\r\n\r\n      try {\r\n        // Always send all plant codes for PSR reports\r\n        const plantCodes = this.plants.map(plant => plant.code);\r\n        \r\n        const response = await api.generateReport({\r\n          plant_codes: plantCodes,\r\n          start_date: this.startDate,\r\n          end_date: this.endDate,\r\n          report_type: 'psr',\r\n        });\r\n\r\n        // Create download link\r\n        const url = window.URL.createObjectURL(new Blob([response.data]));\r\n        const link = document.createElement('a');\r\n        link.href = url;\r\n        \r\n        // Set filename for PSR report\r\n        const startDateStr = this.startDate.replace(/-/g, '');\r\n        const endDateStr = this.endDate.replace(/-/g, '');\r\n        let filename;\r\n        \r\n        if (this.startDate === this.endDate) {\r\n          filename = `PSR_REPORT_${startDateStr}.xlsx`;\r\n        } else {\r\n          filename = `PSR_REPORT_${startDateStr}_${endDateStr}.xlsx`;\r\n        }\r\n        \r\n        link.setAttribute('download', filename);\r\n        document.body.appendChild(link);\r\n        link.click();\r\n        link.remove();\r\n        window.URL.revokeObjectURL(url);\r\n\r\n        // Save to history\r\n        this.saveToHistory({\r\n          filename,\r\n          plantCode: 'ALL',\r\n          plantName: 'All Plants',\r\n          startDate: this.startDate,\r\n          endDate: this.endDate,\r\n          reportType: 'psr',\r\n          reportTypeName: 'Plant Status Report (PSR)',\r\n        });\r\n\r\n        toast.success('PSR Report generated successfully!');\r\n      } catch (error) {\r\n        console.error('Generate report error:', error);\r\n        let errorMsg = 'Failed to generate PSR report';\r\n        \r\n        // Handle blob response errors\r\n        if (error.response?.data instanceof Blob) {\r\n          try {\r\n            const text = await error.response.data.text();\r\n            const errorData = JSON.parse(text);\r\n            errorMsg = errorData.error || errorMsg;\r\n            \r\n            // Add helpful hint if no data found\r\n            if (errorMsg.includes('No data found')) {\r\n              errorMsg += '. Please upload Excel files first in the Upload Excel Reports page.';\r\n            }\r\n          } catch (e) {\r\n            errorMsg = error.response?.statusText || errorMsg;\r\n          }\r\n        } else if (error.response?.data?.error) {\r\n          errorMsg = error.response.data.error;\r\n          if (errorMsg.includes('No data found')) {\r\n            errorMsg += '. Please upload Excel files first in the Upload Excel Reports page.';\r\n          }\r\n        } else if (error.message) {\r\n          errorMsg = error.message;\r\n        }\r\n        \r\n        toast.error(errorMsg, 6000);\r\n      } finally {\r\n        this.generating = false;\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.generate-report-page {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n}\r\n\r\n/* Header */\r\n.page-header {\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n.page-title {\r\n  font-size: 1.75rem;\r\n  font-weight: 600;\r\n  color: #1a202c;\r\n  margin: 0 0 0.5rem 0;\r\n  letter-spacing: -0.025em;\r\n}\r\n\r\n.page-description {\r\n  color: #718096;\r\n  font-size: 0.9375rem;\r\n  margin: 0;\r\n}\r\n\r\n/* Form */\r\n.report-form {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2rem;\r\n}\r\n\r\n.form-section,\r\n.form-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.75rem;\r\n}\r\n\r\n.section-label,\r\n.field-label {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  font-size: 0.875rem;\