{"ast":null,"code":"export default {\n  name: 'Documentation',\n  data: function data() {\n    return {\n      docSections: [{\n        icon: 'pi pi-play-circle',\n        title: 'Getting Started',\n        description: 'Quick start guide to begin using the system',\n        items: ['System requirements and setup', 'User registration and login', 'Dashboard overview', 'Navigation basics']\n      }, {\n        icon: 'pi pi-upload',\n        title: 'Data Upload',\n        description: 'Learn how to upload and manage daily reports',\n        items: ['Excel file format requirements', 'Upload process step-by-step', 'Data validation rules', 'Error handling and troubleshooting']\n      }, {\n        icon: 'pi pi-chart-line',\n        title: 'Reports & Analytics',\n        description: 'Generate and analyze performance reports',\n        items: ['PSR report generation', 'Daily status reports', 'Advanced analytics dashboard', 'Export options (Excel, PDF)']\n      }, {\n        icon: 'pi pi-calendar',\n        title: 'Scheduled Reports',\n        description: 'Automate report generation and delivery',\n        items: ['Creating scheduled reports', 'Setting up email notifications', 'Managing report schedules', 'Viewing execution history']\n      }, {\n        icon: 'pi pi-users',\n        title: 'User Management',\n        description: 'Manage users and permissions',\n        items: ['User roles and permissions', 'Adding and editing users', 'Access control settings', 'Audit logs and tracking']\n      }, {\n        icon: 'pi pi-cog',\n        title: 'System Settings',\n        description: 'Configure system preferences',\n        items: ['Theme customization', 'User profile settings', 'Password management', 'Notification preferences']\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","data","docSections","icon","title","description","items"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\Documentation.vue"],"sourcesContent":["<template>\r\n  <div class=\"documentation-page\">\r\n    <!-- Animated Background -->\r\n    <div class=\"animated-bg\">\r\n      <div class=\"bg-shape shape-1\"></div>\r\n      <div class=\"bg-shape shape-2\"></div>\r\n      <div class=\"bg-shape shape-3\"></div>\r\n    </div>\r\n\r\n    <!-- Back Button Top Left -->\r\n    <div class=\"back-button-top-left\">\r\n      <router-link to=\"/\" class=\"btn-back-glass-small\">\r\n        <i class=\"pi pi-arrow-left\"></i>\r\n        <span>Back to Home</span>\r\n      </router-link>\r\n    </div>\r\n\r\n    <!-- Header -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"header-icon\">\r\n          <i class=\"pi pi-book\"></i>\r\n        </div>\r\n        <h1 class=\"glowing-text\">Documentation</h1>\r\n        <p class=\"subtitle\">Complete guides and resources for the GPD Reporting System</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Documentation Sections -->\r\n    <div class=\"docs-container\">\r\n      <div \r\n        v-for=\"(section, index) in docSections\" \r\n        :key=\"index\"\r\n        class=\"doc-card-glass\"\r\n        :style=\"{ animationDelay: `${index * 0.1}s` }\"\r\n      >\r\n        <div class=\"doc-icon\">\r\n          <i :class=\"section.icon\"></i>\r\n        </div>\r\n        <h2>{{ section.title }}</h2>\r\n        <p>{{ section.description }}</p>\r\n        <ul class=\"doc-list\">\r\n          <li v-for=\"(item, idx) in section.items\" :key=\"idx\">\r\n            <i class=\"pi pi-check-circle\"></i>\r\n            <span>{{ item }}</span>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'Documentation',\r\n  data() {\r\n    return {\r\n      docSections: [\r\n        {\r\n          icon: 'pi pi-play-circle',\r\n          title: 'Getting Started',\r\n          description: 'Quick start guide to begin using the system',\r\n          items: [\r\n            'System requirements and setup',\r\n            'User registration and login',\r\n            'Dashboard overview',\r\n            'Navigation basics'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-upload',\r\n          title: 'Data Upload',\r\n          description: 'Learn how to upload and manage daily reports',\r\n          items: [\r\n            'Excel file format requirements',\r\n            'Upload process step-by-step',\r\n            'Data validation rules',\r\n            'Error handling and troubleshooting'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-chart-line',\r\n          title: 'Reports & Analytics',\r\n          description: 'Generate and analyze performance reports',\r\n          items: [\r\n            'PSR report generation',\r\n            'Daily status reports',\r\n            'Advanced analytics dashboard',\r\n            'Export options (Excel, PDF)'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-calendar',\r\n          title: 'Scheduled Reports',\r\n          description: 'Automate report generation and delivery',\r\n          items: [\r\n            'Creating scheduled reports',\r\n            'Setting up email notifications',\r\n            'Managing report schedules',\r\n            'Viewing execution history'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-users',\r\n          title: 'User Management',\r\n          description: 'Manage users and permissions',\r\n          items: [\r\n            'User roles and permissions',\r\n            'Adding and editing users',\r\n            'Access control settings',\r\n            'Audit logs and tracking'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-cog',\r\n          title: 'System Settings',\r\n          description: 'Configure system preferences',\r\n          items: [\r\n            'Theme customization',\r\n            'User profile settings',\r\n            'Password management',\r\n            'Notification preferences'\r\n          ]\r\n        }\r\n      ]\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.documentation-page {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);\r\n  padding: 100px 20px 80px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.animated-bg {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.bg-shape {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  filter: blur(80px);\r\n  opacity: 0.15;\r\n  animation: float 20s ease-in-out infinite;\r\n}\r\n\r\n.shape-1 {\r\n  width: 500px;\r\n  height: 500px;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  top: -200px;\r\n  left: -200px;\r\n}\r\n\r\n.shape-2 {\r\n  width: 400px;\r\n  height: 400px;\r\n  background: linear-gradient(135deg, #ec4899 0%, #f59e0b 100%);\r\n  bottom: -150px;\r\n  right: -150px;\r\n  animation-delay: 5s;\r\n}\r\n\r\n.shape-3 {\r\n  width: 350px;\r\n  height: 350px;\r\n  background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation-delay: 10s;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% { transform: translate(0, 0) scale(1); }\r\n  33% { transform: translate(100px, -100px) scale(1.1); }\r\n  66% { transform: translate(-100px, 100px) scale(0.9); }\r\n}\r\n\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.header-icon {\r\n  width: 100px;\r\n  height: 100px;\r\n  margin: 0 auto 30px;\r\n  border-radius: 30px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 3rem;\r\n  color: #60a5fa;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n  animation: iconPulse 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes iconPulse {\r\n  0%, 100% { transform: scale(1); }\r\n  50% { transform: scale(1.05); }\r\n}\r\n\r\n.glowing-text {\r\n  font-size: 4rem;\r\n  font-weight: 900;\r\n  background: linear-gradient(135deg, #ffffff 0%, #60a5fa 50%, #a78bfa 100%);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  background-clip: text;\r\n  margin: 0 0 20px 0;\r\n  letter-spacing: -2px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 1.5rem;\r\n  color: #cbd5e1;\r\n  margin: 0;\r\n  font-weight: 300;\r\n}\r\n\r\n.docs-container {\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\r\n  gap: 40px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.doc-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(255, 255, 255, 0.05) 0%, \r\n    rgba(255, 255, 255, 0.02) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  padding: 40px;\r\n  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n  animation: fadeInUp 0.6s ease-out backwards;\r\n}\r\n\r\n@keyframes fadeInUp {\r\n  from { opacity: 0; transform: translateY(30px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n.doc-card-glass:hover {\r\n  transform: translateY(-10px) scale(1.02);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 30px 80px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.doc-icon {\r\n  width: 80px;\r\n  height: 80px;\r\n  margin-bottom: 24px;\r\n  border-radius: 20px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 2.5rem;\r\n  color: #60a5fa;\r\n  transition: all 0.4s ease;\r\n}\r\n\r\n.doc-card-glass:hover .doc-icon {\r\n  transform: scale(1.1) rotate(5deg);\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.3) 0%, rgba(139, 92, 246, 0.3) 100%);\r\n}\r\n\r\n.doc-card-glass h2 {\r\n  font-size: 2rem;\r\n  color: white !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.doc-card-glass p {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  margin: 0 0 24px 0;\r\n}\r\n\r\n.doc-list {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.doc-list li {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 12px 0;\r\n  color: #e2e8f0 !important;\r\n  font-size: 1rem;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.doc-list li:hover {\r\n  transform: translateX(10px);\r\n  color: #60a5fa;\r\n}\r\n\r\n.doc-list li i {\r\n  color: #10b981;\r\n  font-size: 1.125rem;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Back Button Top Left */\r\n.back-button-top-left {\r\n  position: fixed;\r\n  top: 30px;\r\n  left: 30px;\r\n  z-index: 1000;\r\n}\r\n\r\n.btn-back-glass-small {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 12px 24px;\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.3) 0%, \r\n    rgba(139, 92, 246, 0.3) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 12px;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.btn-back-glass-small:hover {\r\n  transform: translateX(-5px);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 12px 40px rgba(59, 130, 246, 0.5);\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.4) 0%, \r\n    rgba(139, 92, 246, 0.4) 100%);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .docs-container {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .glowing-text {\r\n    font-size: 2.5rem;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAsDA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,IAAI,WAAJA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,WAAW,EAAE,CACX;QACEC,IAAI,EAAE,mBAAmB;QACzBC,KAAK,EAAE,iBAAiB;QACxBC,WAAW,EAAE,6CAA6C;QAC1DC,KAAK,EAAE,CACL,+BAA+B,EAC/B,6BAA6B,EAC7B,oBAAoB,EACpB,mBAAkB;MAEtB,CAAC,EACD;QACEH,IAAI,EAAE,cAAc;QACpBC,KAAK,EAAE,aAAa;QACpBC,WAAW,EAAE,8CAA8C;QAC3DC,KAAK,EAAE,CACL,gCAAgC,EAChC,6BAA6B,EAC7B,uBAAuB,EACvB,oCAAmC;MAEvC,CAAC,EACD;QACEH,IAAI,EAAE,kBAAkB;QACxBC,KAAK,EAAE,qBAAqB;QAC5BC,WAAW,EAAE,0CAA0C;QACvDC,KAAK,EAAE,CACL,uBAAuB,EACvB,sBAAsB,EACtB,8BAA8B,EAC9B,6BAA4B;MAEhC,CAAC,EACD;QACEH,IAAI,EAAE,gBAAgB;QACtBC,KAAK,EAAE,mBAAmB;QAC1BC,WAAW,EAAE,yCAAyC;QACtDC,KAAK,EAAE,CACL,4BAA4B,EAC5B,gCAAgC,EAChC,2BAA2B,EAC3B,2BAA0B;MAE9B,CAAC,EACD;QACEH,IAAI,EAAE,aAAa;QACnBC,KAAK,EAAE,iBAAiB;QACxBC,WAAW,EAAE,8BAA8B;QAC3CC,KAAK,EAAE,CACL,4BAA4B,EAC5B,0BAA0B,EAC1B,yBAAyB,EACzB,yBAAwB;MAE5B,CAAC,EACD;QACEH,IAAI,EAAE,WAAW;QACjBC,KAAK,EAAE,iBAAiB;QACxBC,WAAW,EAAE,8BAA8B;QAC3CC,KAAK,EAAE,CACL,qBAAqB,EACrB,uBAAuB,EACvB,qBAAqB,EACrB,0BAAyB;MAE7B;IAEJ,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}