span>Back to Home</span>\r\n      </router-link>\r\n    </div>\r\n\r\n    <!-- Header -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"header-icon\">\r\n          <i class=\"pi pi-file-edit\"></i>\r\n        </div>\r\n        <h1 class=\"glowing-text\">Terms of Service</h1>\r\n        <p class=\"subtitle\">Please read these terms carefully</p>\r\n        <p class=\"last-updated\">Last Updated: February 2026</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Content -->\r\n    <div class=\"content-container\">\r\n      <div class=\"content-card-glass\">\r\n        <div v-for=\"(section, index) in sections\" :key=\"index\" class=\"section\">\r\n          <h2>{{ section.title }}</h2>\r\n          <p v-for=\"(paragraph, idx) in section.content\" :key=\"idx\">{{ paragraph }}</p>\r\n          <ul v-if=\"section.list\">\r\n            <li v-for=\"(item, idx) in section.list\" :key=\"idx\">{{ item }}</li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'TermsOfService',\r\n  data() {\r\n    return {\r\n      sections: [\r\n        {\r\n          title: '1. Acceptance of Terms',\r\n          content: [\r\n            'By accessing and using the GPD Reporting System, you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the system.'\r\n          ]\r\n        },\r\n        {\r\n          title: '2. User Accounts',\r\n          content: [\r\n            'Access to the system requires a valid user account. You are responsible for:'\r\n          ],\r\n          list: [\r\n            'Maintaining the confidentiality of your login credentials',\r\n            'All activities that occur under your account',\r\n            'Notifying us immediately of any unauthorized access',\r\n            'Ensuring your account information is accurate and up-to-date'\r\n          ]\r\n        },\r\n        {\r\n          title: '3. Acceptable Use',\r\n          content: [\r\n            'You agree to use the system only for authorized purposes. Prohibited activities include:'\r\n          ],\r\n          list: [\r\n            'Attempting to gain unauthorized access to the system',\r\n            'Uploading malicious code or harmful content',\r\n            'Interfering with system operations or other users',\r\n            'Sharing your account credentials with unauthorized persons',\r\n            'Using the system for any illegal purposes'\r\n          ]\r\n        },\r\n        {\r\n          title: '4. Data Accuracy',\r\n          content: [\r\n            'Users are responsible for ensuring the accuracy and completeness of data uploaded to the system. Intentional submission of false or misleading data may result in account suspension and disciplinary action.'\r\n          ]\r\n        },\r\n        {\r\n          title: '5. Intellectual Property',\r\n          content: [\r\n            'The system and its content are the property of the National Power Corporation. Users may not reproduce, distribute, or create derivative works without explicit permission.'\r\n          ]\r\n        },\r\n        {\r\n          title: '6. System Availability',\r\n          content: [\r\n            'While we strive for maximum uptime, we do not guarantee uninterrupted access to the system. Scheduled maintenance and updates will be communicated in advance when possible.'\r\n          ]\r\n        },\r\n        {\r\n          title: '7. Limitation of Liability',\r\n          content: [\r\n            'The system is provided \"as is\" without warranties of any kind. NPC shall not be liable for any damages arising from system use or inability to use the system.'\r\n          ]\r\n        },\r\n        {\r\n          title: '8. Termination',\r\n          content: [\r\n            'We reserve the right to suspend or terminate user accounts that violate these terms or for any other reason at our discretion.'\r\n          ]\r\n        },\r\n        {\r\n          title: '9. Changes to Terms',\r\n          content: [\r\n            'We may modify these terms at any time. Continued use of the system after changes constitutes acceptance of the modified terms.'\r\n          ]\r\n        },\r\n        {\r\n          title: '10. Contact',\r\n          content: [\r\n            'For questions about these terms, please contact your system administrator or the GPD management office.'\r\n          ]\r\n        }\r\n      ]\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.terms-page {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);\r\n  padding: 100px 20px 80px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.animated-bg {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.bg-shape {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  filter: blur(80px);\r\n  opacity: 0.15;\r\n  animation: float 20s ease-in-out infinite;\r\n}\r\n\r\n.shape-1 {\r\n  width: 500px;\r\n  height: 500px;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  top: -200px;\r\n  left: -200px;\r\n}\r\n\r\n.shape-2 {\r\n  width: 400px;\r\n  height: 400px;\r\n  background: linear-gradient(135deg, #ec4899 0%, #f59e0b 100%);\r\n  bottom: -150px;\r\n  right: -150px;\r\n  animation-delay: 5s;\r\n}\r\n\r\n.shape-3 {\r\n  width: 350px;\r\n  height: 350px;\r\n  background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation-delay: 10s;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% { transform: translate(0, 0) scale(1); }\r\n  33% { transform: translate(100px, -100px) scale(1.1); }\r\n  66% { transform: translate(-100px, 100px) scale(0.9); }\r\n}\r\n\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.header-icon {\r\n  width: 100px;\r\n  height: 100px;\r\n  margin: 0 auto 30px;\r\n  border-radius: 30px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 3rem;\r\n  color: #60a5fa;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n  animation: iconPulse 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes iconPulse {\r\n  0%, 100% { transform: scale(1); }\r\n  50% { transform: scale(1.05); }\r\n}\r\n\r\n.glowing-text {\r\n  font-size: 4rem;\r\n  font-weight: 900;\r\n  background: linear-gradient(135deg, #ffffff 0%, #60a5fa 50%, #a78bfa 100%);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  background-clip: text;\r\n  margin: 0 0 20px 0;\r\n  letter-spacing: -2px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 1.5rem;\r\n  color: #cbd5e1;\r\n  margin: 0 0 12px 0;\r\n  font-weight: 300;\r\n}\r\n\r\n.last-updated {\r\n  font-size: 1rem;\r\n  color: #94a3b8;\r\n  margin: 0;\r\n  font-style: italic;\r\n}\r\n\r\n.content-container {\r\n  max-width: 1000px;\r\n  margin: 0 auto 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.content-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(255, 255, 255, 0.05) 0%, \r\n    rgba(255, 255, 255, 0.02) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  padding: 60px;\r\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n.section {\r\n  margin-bottom: 40px;\r\n}\r\n\r\n.section:last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\n.section h2 {\r\n  font-size: 1.75rem;\r\n  color: #ffffff !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.section p {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  margin: 0 0 16px 0;\r\n}\r\n\r\n.section ul {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 16px 0 0 0;\r\n}\r\n\r\n.section ul li {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  padding: 8px 0 8px 32px;\r\n  position: relative;\r\n}\r\n\r\n.section ul li::before {\r\n  content: '•';\r\n  position: absolute;\r\n  left: 12px;\r\n  color: #60a5fa;\r\n  font-size: 1.5rem;\r\n}\r\n\r\n.back-button-container {\r\n  text-align: center;\r\n  margin-top: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.btn-back-glass {\r\n  position: relative;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 18px 40px;\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.2) 0%, \r\n    rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 16px;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 1.125rem;\r\n  font-weight: 600;\r\n  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n  overflow: hidden;\r\n  box-shadow: 0 10px 40px rgba(59, 130, 246, 0.2);\r\n}\r\n\r\n.btn-back-glass:hover {\r\n  transform: translateY(-5px) scale(1.05);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.4);\r\n}\r\n\r\n.btn-shine {\r\n  position: absolute;\r\n  top: 0;\r\n  left: -100%;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: linear-gradient(90deg, \r\n    transparent, \r\n    rgba(255, 255, 255, 0.2), \r\n    transparent);\r\n  transition: left 0.6s ease;\r\n}\r\n\r\n.btn-back-glass:hover .btn-shine {\r\n  left: 100%;\r\n}\r\n\r\n/* Back Button Top Left */\r\n.back-button-top-left {\r\n  position: fixed;\r\n  top: 30px;\r\n  left: 30px;\r\n  z-index: 1000;\r\n}\r\n\r\n.btn-back-glass-small {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 12px 24px;\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.3) 0%, \r\n    rgba(139, 92, 246, 0.3) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 12px;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.btn-back-glass-small:hover {\r\n  transform: translateX(-5px);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 12px 40px rgba(59, 130, 246, 0.5);\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.4) 0%, \r\n    rgba(139, 92, 246, 0.4) 100%);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .content-card-glass {\r\n    padding: 40px 30px;\r\n  }\r\n  \r\n  .glowing-text {\r\n    font-size: 2.5rem;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,KAAK,EAAC;AAAY;;EAShBA,KAAK,EAAC;AAAsB;;EAoB5BA,KAAK,EAAC;AAAmB;;EACvBA,KAAK,EAAC;AAAoB;;;;;;uBA9BnCC,mBAAA,CAyCM,OAzCNC,UAyCM,G,0BAvCJC,mBAAA,CAIM;IAJDH,KAAK,EAAC;EAAa,IACtBG,mBAAA,CAAoC;IAA/BH,KAAK,EAAC;EAAkB,IAC7BG,mBAAA,CAAoC;IAA/BH,KAAK,EAAC;EAAkB,IAC7BG,mBAAA,CAAoC;IAA/BH,KAAK,EAAC;EAAkB,G,QAI/BG,mBAAA,CAKM,OALNC,UAKM,GAJJC,YAAA,CAGcC,sBAAA;IAHDC,EAAE,EAAC,GAAG;IAACP,KAAK,EAAC;;sBACxB,MAAgC,KAAAQ,MAAA,QAAAA,MAAA,OAAhCL,mBAAA,CAAgC;MAA7BH,KAAK,EAAC;IAAkB,cAC3BG,mBAAA,CAAyB,cAAnB,cAAY,M;;ydAiBtBA,mBAAA,CAUM,OAVNM,UAUM,GATJN,mBAAA,CAQM,OARNO,UAQM,I,kBAPJT,mBAAA,CAMMU,SAAA,QAAAC,WAAA,CAN0BC,KAAA,CAAAC,QAAQ,GAA3BC,OAAO,EAAEC,KAAK;yBAA3Bf,mBAAA,CAMM;MANqCgB,GAAG,EAAED,KAAK;MAAEhB,KAAK,EAAC;QAC3DG,mBAAA,CAA4B,YAAAe,gBAAA,CAArBH,OAAO,CAACI,KAAK,Q,kBACpBlB,mBAAA,CAA6EU,SAAA,QAAAC,WAAA,CAA/CG,OAAO,CAACK,OAAO,GAAlCC,SAAS,EAAEC,GAAG;2BAAzBrB,mBAAA,CAA6E;QAA7BgB,GAAG,EAAEK;MAAG,GAAAJ,gBAAA,CAAKG,SAAS;eAC5DN,OAAO,CAACQ,IAAI,I,cAAtBtB,mBAAA,CAEK,MAAAuB,UAAA,I,kBADHvB,mBAAA,CAAkEU,SAAA,QAAAC,WAAA,CAAxCG,OAAO,CAACQ,IAAI,GAA1BE,IAAI,EAAEH,GAAG;2BAArBrB,mBAAA,CAAkE;QAAzBgB,GAAG,EAAEK;MAAG,GAAAJ,gBAAA,CAAKO,IAAI","ignoreList":[]},"meta