{"ast":null,"code":"import _regenerator from \"C:/Users/eladiong/Desktop/OJT Intern_v2/npc-reporting-system/frontend/node_modules/@babel/runtime/helpers/esm/regenerator.js\";\nimport _asyncToGenerator from \"C:/Users/eladiong/Desktop/OJT Intern_v2/npc-reporting-system/frontend/node_modules/@babel/runtime/helpers/esm/asyncToGenerator.js\";\nimport \"core-js/modules/es.array.from.js\";\nimport \"core-js/modules/es.date.to-string.js\";\nimport \"core-js/modules/es.number.constructor.js\";\nimport \"core-js/modules/es.number.to-fixed.js\";\nimport \"core-js/modules/es.string.iterator.js\";\nimport AppLayout from './AppLayout.vue';\nimport { Chart as ChartJS, Title, Tooltip, Legend, ArcElement, CategoryScale, LinearScale, PointElement, LineElement, Filler } from 'chart.js';\nimport { Pie, Doughnut, Line as LineChart } from 'vue-chartjs';\nimport api from '../services/api';\nChartJS.register(Title, Tooltip, Legend, ArcElement, CategoryScale, LinearScale, PointElement, LineElement, Filler);\nexport default {\n  name: 'DashboardView',\n  components: {\n    AppLayout: AppLayout,\n    PieChart: Pie,\n    DoughnutChart: Doughnut,\n    LineChart: LineChart\n  },\n  data: function data() {\n    return {\n      currentDate: new Date().toLocaleDateString('en-US', {\n        weekday: 'long',\n        year: 'numeric',\n        month: 'long',\n        day: 'numeric'\n      }),\n      availablePlants: ['Agus 1 HPP', 'Agus 2 HPP', 'Agus 4 HPP', 'Agus 5 HPP', 'Agus 6 HPP', 'Agus 7 HPP', 'Pulangi IV HPP'],\n      selectedPlant: 'Agus 1 HPP',\n      selectedYear: '2026',\n      selectedMonth: 'March',\n      stats: {\n        avgCapacityFactor: 59.0\n      },\n      // Gauge Base Options\n      gaugeOptions: {\n        responsive: true,\n        maintainAspectRatio: false,\n        cutout: '75%',\n        circumference: 180,\n        rotation: 270,\n        plugins: {\n          legend: {\n            display: false\n          },\n          tooltip: {\n            enabled: false\n          }\n        }\n      },\n      // Pie Chart\n      pieOptions: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: {\n          legend: {\n            display: false\n          }\n        }\n      },\n      capacityContributionData: {\n        labels: ['Other Companies', 'MinGen'],\n        datasets: [{\n          data: [2965, 448],\n          backgroundColor: ['#c4b5fd', '#a855f7'],\n          borderWidth: 0\n        }]\n      },\n      // Area Chart\n      areaOptions: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: {\n          legend: {\n            display: true,\n            position: 'top',\n            labels: {\n              boxWidth: 10,\n              usePointStyle: true\n            }\n          }\n        },\n        scales: {\n          y: {\n            beginAtZero: true,\n            max: 5000,\n            ticks: {\n              callback: function callback(val) {\n                return val / 1000 + 'K';\n              }\n            }\n          },\n          x: {\n            grid: {\n              display: false\n            }\n          }\n        },\n        elements: {\n          point: {\n            radius: 0\n          }\n        }\n      },\n      mindanaoContributionData: {\n        labels: Array.from({\n          length: 29\n        }, function (_, i) {\n          return i + 1;\n        }),\n        datasets: [{\n          label: 'MINGEN',\n          data: Array.from({\n            length: 29\n          }, function () {\n            return 400 + Math.random() * 100;\n          }),\n          backgroundColor: 'rgba(59, 130, 246, 0.8)',\n          borderColor: '#2563eb',\n          fill: true\n        }, {\n          label: 'Other Companies',\n          data: Array.from({\n            length: 29\n          }, function () {\n            return 2500 + Math.random() * 200;\n          }),\n          backgroundColor: 'rgba(199, 210, 254, 0.5)',\n          borderColor: '#818cf8',\n          fill: true\n        }]\n      },\n      // Line Chart (Load Profile)\n      loadProfileOptions: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: {\n          legend: {\n            display: true,\n            position: 'top',\n            labels: {\n              boxWidth: 20\n            }\n          }\n        },\n        scales: {\n          y: {\n            min: 400,\n            max: 600\n          },\n          x: {\n            ticks: {\n              maxRotation: 0,\n              font: {\n                size: 9\n              }\n            }\n          }\n        },\n        elements: {\n          point: {\n            radius: 0\n          }\n        }\n      },\n      loadProfileData: {\n        labels: ['1:00 AM', '3:00 AM', '6:00 AM', '9:00 AM', '12:00 PM', '3:00 PM', '6:00 PM', '9:00 PM', '12:00 AM'],\n        datasets: [{\n          label: 'Nominated Load',\n          data: [520, 510, 500, 520, 515, 525, 560, 530, 480],\n          borderColor: '#94a3b8',\n          borderDash: [5, 5]\n        }, {\n          label: 'Re-nominated Load',\n          data: [510, 500, 490, 510, 500, 510, 550, 520, 470],\n          borderColor: '#ef4444'\n        }, {\n          label: 'Market Desired Load',\n          data: [540, 530, 520, 540, 530, 540, 580, 550, 500],\n          borderColor: '#3b82f6'\n        }, {\n          label: 'Actual Load',\n          data: [530, 520, 510, 530, 520, 530, 570, 540, 490],\n          borderColor: '#10b981'\n        }]\n      },\n      // Lake Stats\n      lakeStatsOptions: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: {\n          legend: {\n            display: false\n          }\n        },\n        scales: {\n          y: {\n            min: 699,\n            max: 702\n          }\n        }\n      },\n      lakeStatsData: {\n        labels: ['Mar 01', 'Mar 08', 'Mar 15', 'Mar 22', 'Mar 29'],\n        datasets: [{\n          label: 'Maximum Operating Level',\n          data: [701.8, 701.8, 701.8, 701.8, 701.8],\n          borderColor: '#1e3a8a',\n          borderDash: [5, 5],\n          pointRadius: 0\n        }, {\n          label: 'Upper Rule Curve',\n          data: [701.5, 701.4, 701.3, 701.2, 701.1],\n          borderColor: '#94a3b8',\n          borderDash: [5, 5],\n          pointRadius: 0\n        }, {\n          label: 'Actual Elevation',\n          data: [700.9, 700.8, 700.7, 700.6, 700.5],\n          borderColor: '#22c55e',\n          borderWidth: 3\n        }, {\n          label: 'Minimum Operating Level',\n          data: [699.5, 699.5, 699.5, 699.5, 699.5],\n          borderColor: '#ef4444',\n          borderDash: [5, 5],\n          pointRadius: 0\n        }]\n      },\n      pulangiStatsOptions: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: {\n          legend: {\n            display: false\n          }\n        },\n        scales: {\n          y: {\n            min: 282,\n            max: 286\n          }\n        }\n      },\n      pulangiStatsData: {\n        labels: ['Mar 01', 'Mar 08', 'Mar 15', 'Mar 22', 'Mar 29'],\n        datasets: [{\n          label: 'Maximum Operating Level',\n          data: [285.5, 285.5, 285.5, 285.5, 285.5],\n          borderColor: '#ef4444',\n          borderDash: [5, 5],\n          pointRadius: 0\n        }, {\n          label: 'Actual Elevation',\n          data: [284, 283, 284.5, 283.5, 283, 283.2, 282.8, 284.2, 283],\n          borderColor: '#22c55e',\n          borderWidth: 3\n        }, {\n          label: 'Minimum Operating Level',\n          data: [282.5, 282.5, 282.5, 282.5, 282.5],\n          borderColor: '#1e3a8a',\n          borderDash: [5, 5],\n          pointRadius: 0\n        }]\n      }\n    };\n  },\n  methods: {\n    getGaugeData: function getGaugeData(value, max, color) {\n      return {\n        datasets: [{\n          data: [value, max - value],\n          backgroundColor: [color, '#e2e8f0'],\n          borderWidth: 0,\n          borderRadius: 5\n        }]\n      };\n    },\n    formatNumber: function formatNumber(val) {\n      return Number(val).toFixed(2);\n    }\n  },\n  mounted: function mounted() {\n    var _this = this;\n    return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n      var response, _t;\n      return _regenerator().w(function (_context) {\n        while (1) switch (_context.p = _context.n) {\n          case 0:\n            _context.p = 0;\n            _context.n = 1;\n            return api.getReportSummary();\n          case 1:\n            response = _context.v;\n            if (response.data && response.data.avg_capacity_factor) {\n              _this.stats.avgCapacityFactor = response.data.avg_capacity_factor;\n            }\n            _context.n = 3;\n            break;\n          case 2:\n            _context.p = 2;\n            _t = _context.v;\n            console.error(_t);\n          case 3:\n            return _context.a(2);\n        }\n      }, _callee, null, [[0, 2]]);\n    }))();\n  }\n};","map":{"version":3,"names":["AppLayout","Chart","ChartJS","Title","Tooltip","Legend","ArcElement","CategoryScale","LinearScale","PointElement","LineElement","Filler","Pie","Doughnut","Line","LineChart","api","register","name","components","PieChart","DoughnutChart","data","currentDate","Date","toLocaleDateString","weekday","year","month","day","availablePlants","selectedPlant","selectedYear","selectedMonth","stats","avgCapacityFactor","gaugeOptions","responsive","maintainAspectRatio","cutout","circumference","rotation","plugins","legend","display","tooltip","enabled","pieOptions","capacityContributionData","labels","datasets","backgroundColor","borderWidth","areaOptions","position","boxWidth","usePointStyle","scales","y","beginAtZero","max","ticks","callback","val","x","grid","elements","point","radius","mindanaoContributionData","Array","from","length","_","i","label","Math","random","borderColor","fill","loadProfileOptions","min","maxRotation","font","size","loadProfileData","borderDash","lakeStatsOptions","lakeStatsData","pointRadius","pulangiStatsOptions","pulangiStatsData","methods","getGaugeData","value","color","borderRadius","formatNumber","Number","toFixed","mounted","_this","_asyncToGenerator","_regenerator","m","_callee","response","_t","w","_context","p","n","getReportSummary","v","avg_capacity_factor","console","error","a"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\Dashboard.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n    <div class=\"mgg-dashboard\">\r\n      <!-- HEADER -->\r\n      <div class=\"mgg-header\">\r\n        <h1>MINDANAO GENERATION GROUP (MGG) DASHBOARD</h1>\r\n        <p>{{ currentDate }}</p>\r\n      </div>\r\n\r\n      <!-- MINGEN SNAPSHOT SECTION -->\r\n      <div class=\"mgg-section\">\r\n        <div class=\"section-title-badge\">MINGEN SNAPSHOT</div>\r\n        <div class=\"logo-container\">\r\n          <img src=\"@/assets/NPC-logo.png\" alt=\"NPC Logo\" class=\"npc-logo\" />\r\n          <div class=\"go-logo\">go</div>\r\n        </div>\r\n        \r\n        <div class=\"snapshot-content\">\r\n          <!-- TOP ROW: Gauges and KPIs -->\r\n          <div class=\"kpi-row\">\r\n            <!-- Pie Chart -->\r\n            <div class=\"kpi-card pie-card\">\r\n              <h5>MW Capacity Contribution to Mindanao</h5>\r\n              <div class=\"chart-wrapper pie-wrapper\">\r\n                <PieChart :data=\"capacityContributionData\" :options=\"pieOptions\" />\r\n              </div>\r\n              <div class=\"pie-labels\">\r\n                <span class=\"dot other\"></span> Other Companies\r\n                <span class=\"dot mingen\"></span> MinGen\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Gauges -->\r\n            <div class=\"kpi-card\">\r\n              <h5>Unit in Operations</h5>\r\n              <div class=\"chart-wrapper gauge-wrapper\">\r\n                <DoughnutChart :data=\"getGaugeData(15, 20, '#facc15')\" :options=\"gaugeOptions\" />\r\n                <div class=\"gauge-value\">15</div>\r\n              </div>\r\n              <div class=\"kpi-unit\">Units</div>\r\n            </div>\r\n\r\n            <div class=\"kpi-card\">\r\n              <h5>Unit in Shutdown</h5>\r\n              <div class=\"chart-wrapper gauge-wrapper\">\r\n                <DoughnutChart :data=\"getGaugeData(5, 20, '#ef4444')\" :options=\"gaugeOptions\" />\r\n                <div class=\"gauge-value\">5</div>\r\n              </div>\r\n              <div class=\"kpi-unit\">Units</div>\r\n            </div>\r\n\r\n            <div class=\"kpi-card\">\r\n              <h5>Dependable Capacity</h5>\r\n              <div class=\"chart-wrapper gauge-wrapper\">\r\n                <DoughnutChart :data=\"getGaugeData(759.0, 1001.1, '#22c55e')\" :options=\"gaugeOptions\" />\r\n                <div class=\"gauge-value\">759.0</div>\r\n              </div>\r\n              <div class=\"gauge-labels\"><span>0.0</span><span>1001.1</span></div>\r\n              <div class=\"kpi-unit\">MW</div>\r\n            </div>\r\n\r\n            <div class=\"kpi-card\">\r\n              <h5>Capacity Factor</h5>\r\n              <div class=\"chart-wrapper gauge-wrapper\">\r\n                <DoughnutChart :data=\"getGaugeData(stats.avgCapacityFactor, 100, '#d946ef')\" :options=\"gaugeOptions\" />\r\n                <div class=\"gauge-value\">{{ formatNumber(stats.avgCapacityFactor) }}%</div>\r\n              </div>\r\n              <div class=\"gauge-labels\"><span>0%</span><span>100%</span></div>\r\n              <div class=\"kpi-unit\">%</div>\r\n            </div>\r\n\r\n            <div class=\"kpi-card\">\r\n              <h5>Total Load</h5>\r\n              <div class=\"chart-wrapper gauge-wrapper\">\r\n                <DoughnutChart :data=\"getGaugeData(448.0, 759.0, '#3b82f6')\" :options=\"gaugeOptions\" />\r\n                <div class=\"gauge-value\">448.0</div>\r\n              </div>\r\n              <div class=\"gauge-labels\"><span>0.00</span><span>759.00</span></div>\r\n              <div class=\"kpi-unit\">MW</div>\r\n            </div>\r\n\r\n            <div class=\"kpi-card\">\r\n              <h5>GCG Force Outage</h5>\r\n              <div class=\"chart-wrapper gauge-wrapper\">\r\n                <DoughnutChart :data=\"getGaugeData(3.19, 24, '#ef4444')\" :options=\"gaugeOptions\" />\r\n                <div class=\"gauge-value\">3.19</div>\r\n              </div>\r\n              <div class=\"gauge-labels\"><span>0</span><span>24</span></div>\r\n              <div class=\"kpi-unit\">Hours</div>\r\n            </div>\r\n\r\n            <!-- YTD Progress -->\r\n            <div class=\"ytd-progress-card\">\r\n              <div class=\"ytd-item\">\r\n                <h6>GCG YTD Progress</h6>\r\n                <div class=\"ytd-percent\">26.87%</div>\r\n                <div class=\"ytd-value\">1,214,926.00 MWH</div>\r\n                <div class=\"ytd-label\">GCG Target</div>\r\n                <div class=\"ytd-value\">4,521,514.90 MWH</div>\r\n                <div class=\"ytd-label\">Accomplishment by<br/>Dec. 25, 2026</div>\r\n                <div class=\"ytd-target-percent\">99.50%</div>\r\n              </div>\r\n              <div class=\"ytd-item\">\r\n                <h6>PPM YTD Progress</h6>\r\n                <div class=\"ytd-percent\">24.54%</div>\r\n                <div class=\"ytd-value\">1,214,926.00 MWH</div>\r\n                <div class=\"ytd-label\">PPM Target</div>\r\n                <div class=\"ytd-value\">4,950,939.38 MWH</div>\r\n                <div class=\"ytd-label\">Accomplishment by<br/>Dec. 25, 2026</div>\r\n                <div class=\"ytd-target-percent\">90.87%</div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- MIDDLE ROW: Tables and Line Charts -->\r\n          <div class=\"middle-row\">\r\n            <div class=\"panel summary-shutdown\">\r\n              <div class=\"panel-header\">Summary of Shutdown</div>\r\n              <table class=\"mgg-table\">\r\n                <thead>\r\n                  <tr>\r\n                    <th>PLANT NAME</th>\r\n                    <th>UNIT</th>\r\n                    <th>STATUS</th>\r\n                    <th>COMPLETION</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody>\r\n                  <tr><td>Agus 1 HPP</td><td>Unit 2 @ 40 MW</td><td>Planned Outage</td><td>10 Apr 2026</td></tr>\r\n                  <tr><td>Agus 4 HPP</td><td>Unit 1 @ 52.7 MW</td><td>Extended GOMP</td><td>15 May 2026</td></tr>\r\n                  <tr><td>Agus 6 HPP</td><td>Unit 3 @ 50 MW</td><td>Extended GOMP</td><td>31 Mar 2026</td></tr>\r\n                  <tr><td>Agus 6 HPP</td><td>Unit 4 @ 50 MW</td><td>Maintenance Outage</td><td>31 Mar 2026</td></tr>\r\n                  <tr><td>Pulangi IV HPP</td><td>Unit 3 @ 85 MW</td><td>Outside Management Control Outage</td><td>30 Mar 2026</td></tr>\r\n                </tbody>\r\n              </table>\r\n            </div>\r\n\r\n            <div class=\"panel mindanao-contribution\">\r\n              <div class=\"panel-header\">Mindanao MW Contribution</div>\r\n              <div class=\"chart-wrapper area-wrapper\">\r\n                <LineChart :data=\"mindanaoContributionData\" :options=\"areaOptions\" />\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"panel load-profile\">\r\n              <div class=\"panel-header\">Yesterday's 24-Hour Load Profile</div>\r\n              <div class=\"chart-wrapper line-wrapper\">\r\n                <LineChart :data=\"loadProfileData\" :options=\"loadProfileOptions\" />\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- PLANT SNAPSHOT SECTION -->\r\n      <div class=\"mgg-section plant-snapshot-section\">\r\n        <div class=\"section-title-badge plant-badge\">PLANT SNAPSHOT</div>\r\n        \r\n        <div class=\"plant-snapshot-layout\">\r\n          <!-- Left Sidebar -->\r\n          <div class=\"plant-sidebar\">\r\n            <div class=\"sidebar-block\">\r\n              <div class=\"sidebar-title\">Select Plant</div>\r\n              <ul class=\"plant-list\">\r\n                <li v-for=\"plant in availablePlants\" :key=\"plant\" :class=\"{ active: selectedPlant === plant }\" @click=\"selectedPlant = plant\">\r\n                  {{ plant }}\r\n                </li>\r\n              </ul>\r\n            </div>\r\n            \r\n            <div class=\"sidebar-block\">\r\n              <div class=\"sidebar-title\">Select Year</div>\r\n              <ul class=\"year-list\">\r\n                <li :class=\"{ active: selectedYear === '2024' }\" @click=\"selectedYear = '2024'\">2024</li>\r\n                <li :class=\"{ active: selectedYear === '2025' }\" @click=\"selectedYear = '2025'\">2025</li>\r\n                <li :class=\"{ active: selectedYear === '2026' }\" @click=\"selectedYear = '2026'\">2026</li>\r\n              </ul>\r\n            </div>\r\n\r\n            <div class=\"sidebar-block\">\r\n              <div class=\"sidebar-title\">Select Month</div>\r\n              <select v-model=\"selectedMonth\" class=\"month-select\">\r\n                <option value=\"January\">January</option>\r\n                <option value=\"February\">February</option>\r\n                <option value=\"March\">March</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Main Content -->\r\n          <div class=\"plant-main-content\">\r\n            <div class=\"plant-kpi-row\">\r\n              <div class=\"kpi-card plant-kpi\">\r\n                <h5>Dependable Capacity</h5>\r\n                <div class=\"chart-wrapper gauge-wrapper small\">\r\n                  <DoughnutChart :data=\"getGaugeData(35.0, 50, '#22c55e')\" :options=\"gaugeOptions\" />\r\n                  <div class=\"gauge-value\">35.00</div>\r\n                </div>\r\n                <div class=\"gauge-labels\"><span>0.0</span><span>50.0</span></div>\r\n              </div>\r\n\r\n              <div class=\"kpi-card plant-kpi\">\r\n                <h5>Capacity Factor</h5>\r\n                <div class=\"chart-wrapper gauge-wrapper small\">\r\n                  <DoughnutChart :data=\"getGaugeData(80.0, 100, '#d946ef')\" :options=\"gaugeOptions\" />\r\n                  <div class=\"gauge-value\">80.0%</div>\r\n                </div>\r\n                <div class=\"gauge-labels\"><span>0.0%</span><span>100.0%</span></div>\r\n              </div>\r\n\r\n              <div class=\"kpi-card plant-kpi forced-outage-card\">\r\n                <h5>Forced Outage</h5>\r\n                <div class=\"forced-outage-value\">0.49</div>\r\n                <div class=\"kpi-unit\">Hours</div>\r\n                <div class=\"gauge-labels\"><span>0</span><span>24</span></div>\r\n              </div>\r\n\r\n              <div class=\"kpi-card plant-kpi\">\r\n                <h5>Total Load</h5>\r\n                <div class=\"chart-wrapper gauge-wrapper small\">\r\n                  <DoughnutChart :data=\"getGaugeData(28.0, 50, '#3b82f6')\" :options=\"gaugeOptions\" />\r\n                  <div class=\"gauge-value\">28.00</div>\r\n                </div>\r\n                <div class=\"gauge-labels\"><span>0</span><span>50.0</span></div>\r\n                <div class=\"kpi-unit\">MW</div>\r\n              </div>\r\n\r\n              <div class=\"elevation-blocks\">\r\n                <div class=\"elevation-card\">\r\n                  <h5>Lake Elevation</h5>\r\n                  <div class=\"elevation-value\">700.38</div>\r\n                  <div class=\"elevation-status success\"><i class=\"pi pi-check-square\"></i> Within Rule Curve</div>\r\n                </div>\r\n                <div class=\"elevation-card\">\r\n                  <h5>Pulangi Elevation</h5>\r\n                  <div class=\"elevation-value\">283.15</div>\r\n                  <div class=\"elevation-status success\"><i class=\"pi pi-check-square\"></i> Within Operating Limit</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Unit Status and Map -->\r\n            <div class=\"status-map-row\">\r\n              <div class=\"panel unit-status\">\r\n                <div class=\"panel-header\">Unit Status</div>\r\n                <table class=\"mgg-table\">\r\n                  <thead>\r\n                    <tr>\r\n                      <th>Date</th>\r\n                      <th>As of</th>\r\n                      <th>Unit/Rated</th>\r\n                      <th>Load</th>\r\n                      <th>Status</th>\r\n                      <th>Remarks</th>\r\n                    </tr>\r\n                  </thead>\r\n                  <tbody>\r\n                    <tr>\r\n                      <td>3/29/2026</td>\r\n                      <td>6:00 PM</td>\r\n                      <td>Unit 1 @ 40 MW</td>\r\n                      <td>28.00</td>\r\n                      <td class=\"status-op\"><i class=\"pi pi-check\"></i> OPERATIONAL</td>\r\n                      <td>Limited to 35 MW as required by the SCC for Agus 2 to avoid flooding in the Baloi plains</td>\r\n                    </tr>\r\n                    <tr>\r\n                      <td>3/29/2026</td>\r\n                      <td>6:00 PM</td>\r\n                      <td>Unit 2 @ 40 MW</td>\r\n                      <td class=\"text-red\">0.00</td>\r\n                      <td class=\"status-sd\"><i class=\"pi pi-times\"></i> SHUTDOWN</td>\r\n                      <td>Planned Outage, Duration: 26 Mar. - 10 Apr. 2026 (16 days)</td>\r\n                    </tr>\r\n                  </tbody>\r\n                </table>\r\n              </div>\r\n              <div class=\"panel map-panel\">\r\n                <div class=\"panel-header\">Plant Location</div>\r\n                <div class=\"map-placeholder\">\r\n                  <img src=\"@/assets/NPC-logo.png\" alt=\"Map\" class=\"map-bg\" />\r\n                  <div class=\"map-dot\"></div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Bar Charts -->\r\n            <div class=\"bar-charts-row\">\r\n              <div class=\"panel bar-panel\">\r\n                <div class=\"panel-header\">GCG YTD Status</div>\r\n                <div class=\"custom-bar-chart\">\r\n                  <div class=\"bar-row\"><span class=\"bar-label\">TARGET</span> <div class=\"bar-track\"><div class=\"bar-fill target\" style=\"width: 100%\">421,702.50</div></div></div>\r\n                  <div class=\"bar-row\"><span class=\"bar-label actual\">ACTUAL</span> <div class=\"bar-track\"><div class=\"bar-fill actual\" style=\"width: 30%\">117,254.13</div></div></div>\r\n                </div>\r\n              </div>\r\n              <div class=\"panel bar-panel\">\r\n                <div class=\"panel-header\">PPM YTD Status</div>\r\n                <div class=\"custom-bar-chart\">\r\n                  <div class=\"bar-row\"><span class=\"bar-label\">TARGET</span> <div class=\"bar-track\"><div class=\"bar-fill target\" style=\"width: 100%\">461,753.10</div></div></div>\r\n                  <div class=\"bar-row\"><span class=\"bar-label actual\">ACTUAL</span> <div class=\"bar-track\"><div class=\"bar-fill actual\" style=\"width: 30%\">117,254.13</div></div></div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Line Charts -->\r\n            <div class=\"line-charts-row\">\r\n              <div class=\"panel line-panel\">\r\n                <div class=\"panel-header\">Monthly Lake Lanao Statistics</div>\r\n                <div class=\"chart-wrapper small-line\">\r\n                  <LineChart :data=\"lakeStatsData\" :options=\"lakeStatsOptions\" />\r\n                </div>\r\n              </div