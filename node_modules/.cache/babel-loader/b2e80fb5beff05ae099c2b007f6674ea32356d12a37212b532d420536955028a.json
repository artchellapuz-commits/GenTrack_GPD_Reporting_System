{"ast":null,"code":"import \"core-js/modules/es.number.constructor.js\";\nimport \"core-js/modules/es.parse-float.js\";\nimport { Doughnut } from 'vue-chartjs';\nimport { Chart as ChartJS, ArcElement, Tooltip, Legend } from 'chart.js';\nChartJS.register(ArcElement, Tooltip, Legend);\nexport default {\n  name: 'GaugeChart',\n  components: {\n    Doughnut: Doughnut\n  },\n  props: {\n    label: {\n      type: String,\n      required: true\n    },\n    value: {\n      type: [Number, String],\n      required: true\n    },\n    maxValue: {\n      type: Number,\n      required: true\n    },\n    unit: {\n      type: String,\n      required: true\n    },\n    color: {\n      type: String,\n      \"default\": '#3b82f6'\n    }\n  },\n  computed: {\n    chartData: function chartData() {\n      var val = parseFloat(this.value) || 0;\n      var remaining = Math.max(0, this.maxValue - val);\n      return {\n        datasets: [{\n          data: [val, remaining],\n          backgroundColor: [this.color, '#e2e8f0'],\n          borderWidth: 0,\n          circumference: 180,\n          rotation: 270\n        }]\n      };\n    },\n    chartOptions: function chartOptions() {\n      return {\n        responsive: true,\n        maintainAspectRatio: false,\n        cutout: '75%',\n        plugins: {\n          legend: {\n            display: false\n          },\n          tooltip: {\n            enabled: false\n          }\n        },\n        animation: {\n          duration: 1000,\n          easing: 'easeOutQuart'\n        }\n      };\n    }\n  }\n};","map":{"version":3,"names":["Doughnut","Chart","ChartJS","ArcElement","Tooltip","Legend","register","name","components","props","label","type","String","required","value","Number","maxValue","unit","color","computed","chartData","val","parseFloat","remaining","Math","max","datasets","data","backgroundColor","borderWidth","circumference","rotation","chartOptions","responsive","maintainAspectRatio","cutout","plugins","legend","display","tooltip","enabled","animation","duration","easing"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\charts\\GaugeChart.vue"],"sourcesContent":["<template>\n  <div class=\"gauge-container\">\n    <div class=\"gauge-header\">\n      {{ label }}\n    </div>\n    <div class=\"gauge-body\">\n      <Doughnut :data=\"chartData\" :options=\"chartOptions\" />\n      <div class=\"gauge-value-center\">\n        <span class=\"value\">{{ value }}</span>\n      </div>\n    </div>\n    <div class=\"gauge-footer\">\n      <div class=\"gauge-min-max\">\n        <span>0</span>\n        <span>{{ maxValue }}</span>\n      </div>\n      <div class=\"gauge-unit\">\n        {{ unit }}\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { Doughnut } from 'vue-chartjs';\nimport { Chart as ChartJS, ArcElement, Tooltip, Legend } from 'chart.js';\n\nChartJS.register(ArcElement, Tooltip, Legend);\n\nexport default {\n  name: 'GaugeChart',\n  components: { Doughnut },\n  props: {\n    label: { type: String, required: true },\n    value: { type: [Number, String], required: true },\n    maxValue: { type: Number, required: true },\n    unit: { type: String, required: true },\n    color: { type: String, default: '#3b82f6' }\n  },\n  computed: {\n    chartData() {\n      const val = parseFloat(this.value) || 0;\n      const remaining = Math.max(0, this.maxValue - val);\n      \n      return {\n        datasets: [{\n          data: [val, remaining],\n          backgroundColor: [this.color, '#e2e8f0'],\n          borderWidth: 0,\n          circumference: 180,\n          rotation: 270,\n        }]\n      };\n    },\n    chartOptions() {\n      return {\n        responsive: true,\n        maintainAspectRatio: false,\n        cutout: '75%',\n        plugins: {\n          legend: { display: false },\n          tooltip: { enabled: false }\n        },\n        animation: {\n          duration: 1000,\n          easing: 'easeOutQuart'\n        }\n      };\n    }\n  }\n};\n</script>\n\n<style scoped>\n.gauge-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 8px;\n  padding: 10px;\n  width: 100%;\n  height: 100%;\n}\n\n.gauge-header {\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: #1e40af;\n  margin-bottom: 5px;\n  text-align: center;\n  border-bottom: 1px solid #dbeafe;\n  width: 100%;\n  padding-bottom: 5px;\n}\n\n.gauge-body {\n  position: relative;\n  width: 100%;\n  height: 100px;\n  display: flex;\n  justify-content: center;\n  align-items: flex-end;\n}\n\n.gauge-value-center {\n  position: absolute;\n  bottom: 10px;\n  left: 50%;\n  transform: translateX(-50%);\n  text-align: center;\n}\n\n.gauge-value-center .value {\n  font-size: 1.5rem;\n  font-weight: 700;\n  color: #1e293b;\n}\n\n.gauge-footer {\n  width: 100%;\n  margin-top: 5px;\n}\n\n.gauge-min-max {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.7rem;\n  color: #64748b;\n  padding: 0 10px;\n}\n\n.gauge-unit {\n  text-align: center;\n  font-size: 0.8rem;\n  font-weight: 600;\n  color: #475569;\n  margin-top: 5px;\n}\n</style>\n"],"mappings":";;AAwBA,SAASA,QAAO,QAAS,aAAa;AACtC,SAASC,KAAI,IAAKC,OAAO,EAAEC,UAAU,EAAEC,OAAO,EAAEC,MAAK,QAAS,UAAU;AAExEH,OAAO,CAACI,QAAQ,CAACH,UAAU,EAAEC,OAAO,EAAEC,MAAM,CAAC;AAE7C,eAAe;EACbE,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IAAER,QAAO,EAAPA;EAAS,CAAC;EACxBS,KAAK,EAAE;IACLC,KAAK,EAAE;MAAEC,IAAI,EAAEC,MAAM;MAAEC,QAAQ,EAAE;IAAK,CAAC;IACvCC,KAAK,EAAE;MAAEH,IAAI,EAAE,CAACI,MAAM,EAAEH,MAAM,CAAC;MAAEC,QAAQ,EAAE;IAAK,CAAC;IACjDG,QAAQ,EAAE;MAAEL,IAAI,EAAEI,MAAM;MAAEF,QAAQ,EAAE;IAAK,CAAC;IAC1CI,IAAI,EAAE;MAAEN,IAAI,EAAEC,MAAM;MAAEC,QAAQ,EAAE;IAAK,CAAC;IACtCK,KAAK,EAAE;MAAEP,IAAI,EAAEC,MAAM;MAAE,WAAS;IAAU;EAC5C,CAAC;EACDO,QAAQ,EAAE;IACRC,SAAS,WAATA,SAASA,CAAA,EAAG;MACV,IAAMC,GAAE,GAAIC,UAAU,CAAC,IAAI,CAACR,KAAK,KAAK,CAAC;MACvC,IAAMS,SAAQ,GAAIC,IAAI,CAACC,GAAG,CAAC,CAAC,EAAE,IAAI,CAACT,QAAO,GAAIK