{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.number.constructor.js\";\nimport Skeleton from 'primevue/skeleton';\nexport default {\n  name: 'AppSkeleton',\n  components: {\n    Skeleton: Skeleton\n  },\n  props: {\n    type: {\n      type: String,\n      \"default\": 'card',\n      // 'table', 'card', 'form'\n      validator: function validator(value) {\n        return ['table', 'card', 'form'].includes(value);\n      }\n    },\n    rows: {\n      type: Number,\n      \"default\": 5 // For table type\n    },\n    cols: {\n      type: Number,\n      \"default\": 4 // For table type\n    },\n    count: {\n      type: Number,\n      \"default\": 1 // For card/form types (number of cards or form fields)\n    }\n  }\n};","map":{"version":3,"names":["Skeleton","name","components","props","type","String","validator","value","includes","rows","Number","cols","count"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\common\\AppSkeleton.vue"],"sourcesContent":["<template>\n  <div class=\"skeleton-wrapper\" :class=\"[type + '-skeleton']\">\n    <!-- TABLE SKELETON -->\n    <div v-if=\"type === 'table'\" class=\"table-skeleton-container\">\n      <div class=\"table-header\">\n        <Skeleton width=\"200px\" height=\"24px\" class=\"mb-3\" />\n        <div class=\"header-actions\">\n          <Skeleton width=\"40px\" height=\"32px\" borderRadius=\"8px\" />\n          <Skeleton width=\"120px\" height=\"32px\" borderRadius=\"8px\" />\n        </div>\n      </div>\n      <table class=\"skeleton-table\">\n        <thead>\n          <tr>\n            <th v-for=\"i in cols\" :key=\"'th-' + i\">\n              <Skeleton width=\"80%\" height=\"20px\" />\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr v-for=\"r in rows\" :key=\"'tr-' + r\">\n            <td v-for=\"c in cols\" :key=\"'td-' + c\">\n              <Skeleton width=\"100%\" height=\"24px\" />\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <!-- CARD / DASHBOARD SKELETON -->\n    <div v-else-if=\"type === 'card'\" class=\"card-skeleton-container\">\n      <div class=\"skeleton-card\" v-for=\"i in count\" :key=\"'card-' + i\">\n        <div class=\"card-header-sk\">\n          <Skeleton shape=\"circle\" size=\"3rem\" class=\"mr-3\" />\n          <div class=\"card-title-sk\">\n            <Skeleton width=\"60%\" height=\"16px\" class=\"mb-2\" />\n            <Skeleton width=\"40%\" height=\"12px\" />\n          </div>\n        </div>\n        <div class=\"card-body-sk\">\n          <Skeleton width=\"100%\" height=\"120px\" borderRadius=\"12px\" />\n        </div>\n        <div class=\"card-footer-sk\">\n          <Skeleton width=\"100px\" height=\"32px\" borderRadius=\"8px\" />\n          <Skeleton width=\"100px\" height=\"32px\" borderRadius=\"8px\" />\n        </div>\n      </div>\n    </div>\n\n    <!-- FORM SKELETON -->\n    <div v-else-if=\"type === 'form'\" class=\"form-skeleton-container\">\n      <div class=\"form-header-sk\">\n        <Skeleton width=\"150px\" height=\"28px\" class=\"mb-2\" />\n        <Skeleton width=\"250px\" height=\"14px\" />\n      </div>\n      <div class=\"form-body-sk\">\n        <div class=\"form-field-sk\" v-for=\"i in count\" :key=\"'field-' + i\">\n          <Skeleton width=\"100px\" height=\"16px\" class=\"mb-2\" />\n          <Skeleton width=\"100%\" height=\"48px\" borderRadius=\"8px\" />\n        </div>\n        <div class=\"form-actions-sk\">\n          <Skeleton width=\"140px\" height=\"48px\" borderRadius=\"8px\" />\n        </div>\n      </div>\n    </div>\n\n    <!-- CHART PLACEHOLDER (dashboards, chart widgets) -->\n    <div v-else-if=\"type === 'chart'\" class=\"chart-skeleton-container\">\n      <Skeleton width=\"100%\" :height=\"chartHeight\" borderRadius=\"12px\" />\n    </div>\n\n    <!-- COMPACT LIST (search results, menus) -->\n    <div v-else-if=\"type === 'list'\" class=\"list-skeleton-container\">\n      <div class=\"list-row-sk\" v-for=\"i in rows\" :key=\"'list-' + i\">\n        <Skeleton shape=\"circle\" size=\"2.25rem\" class=\"list-avatar-sk\" />\n        <div class=\"list-text-sk\">\n          <Skeleton width=\"70%\" height=\"16px\" class=\"mb-2\" />\n          <Skeleton width=\"45%\" height=\"12px\" />\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport Skeleton from 'primevue/skeleton';\n\nexport default {\n  name: 'AppSkeleton',\n  components: {\n    Skeleton\n  },\n  props: {\n    type: {\n      type: String,\n      default: 'card', // 'table', 'card', 'form'\n      validator: (value) => ['table', 'card', 'form'].includes(value)\n    },\n    rows: {\n      type: Number,\n      default: 5 // For table type\n    },\n    cols: {\n      type: Number,\n      default: 4 // For table type\n    },\n    count: {\n      type: Number,\n      default: 1 // For card/form types (number of cards or form fields)\n    }\n  }\n};\n</script>\n\n<style scoped>\n/* Base fade-in animation for smooth transition */\n.skeleton-wrapper {\n  animation: fadeIn 0.3s ease-in-out;\n  width: 100%;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(5px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* Utility classes mimicking Tailwind (since Tailwind isn't installed) */\n.mb-2 { margin-bottom: 0.5rem; }\n.mb-3 { margin-bottom: 0.75rem; }\n.mr-3 { margin-right: 0.75rem; }\n\n/* ---------------- Table Skeleton ---------------- */\n.table-skeleton-container {\n  background: white;\n  border-radius: 16px;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n  padding: 1.5rem;\n  border: 1px solid #e5e7eb;\n}\n\n.table-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1.5rem;\n}\n\n.header-actions {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.skeleton-table {\n  width: 100%;\n  border-collapse: separate;\n  border-spacing: 0;\n}\n\n.skeleton-table th, .skeleton-table td {\n  padding: 1rem;\n  border-bottom: 1px solid #f3f4f6;\n  text-align: left;\n}\n\n.skeleton-table th {\n  background: #f8fafc;\n}\n\n.skeleton-table th:first-child { border-top-left-radius: 8px; }\n.skeleton-table th:last-child { border-top-right-radius: 8px; }\n\n/* ---------------- Card Skeleton ---------------- */\n.card-skeleton-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 1.5rem;\n}\n\n.skeleton-card {\n  background: white;\n  border-radius: 16px;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n  padding: 1.5rem;\n  border: 1px solid #e5e7eb;\n}\n\n.card-header-sk {\n  display: flex;\n  align-items: center;\n  margin-bottom: 1.5rem;\n}\n\n.card-title-sk {\n  flex: 1;\n}\n\n.card-body-sk {\n  margin-bottom: 1.5rem;\n}\n\n.card-footer-sk {\n  display: flex;\n  justify-content: flex-end;\n  gap: 0.75rem;\n  padding-top: 1rem;\n  border-top: 1px solid #f3f4f6;\n}\n\n/* ---------------- Form Skeleton ---------------- */\n.form-skeleton-container {\n  background: white;\n  border-radius: 16px;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n  padding: 2rem;\n  border: 1px solid #e5e7eb;\n  max-width: 900px;\n  margin: 0 auto;\n}\n\n.form-header-sk {\n  margin-bottom: 2rem;\n  padding-bottom: 1rem;\n  border-bottom: 1px solid #f3f4f6;\n}\n\n.form-body-sk {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.form-field-sk {\n  display: flex;\n  flex-direction: column;\n}\n\n.form-actions-sk {\n  display: flex;\n  justify-content: flex-start;\n  margin-top: 1rem;\n}\n\n/* ---------------- Chart skeleton ---------------- */\n.chart-skeleton-container {\n  width: 100%;\n  min-height: 120px;\n}\n\n/* ---------------- List skeleton ---------------- */\n.list-skeleton-container {\n  padding: 0.5rem 0;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.list-row-sk {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n.list-avatar-sk {\n  flex-shrink: 0;\n}\n\n.list-text-sk {\n  flex: 1;\n  min-width: 0;\n}\n</style>\n"],"mappings":";;AAqFA,OAAOA,QAAO,MAAO,mBAAmB;AAExC,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IACVF,QAAO,EAAPA;EACF,CAAC;EACDG,KAAK,EAAE;IACLC,IAAI,EAAE;MACJA,IAAI,EAAEC,MAAM;MACZ,WAAS,MAAM;MAAE;MACjBC,SAAS,EAAE,SAAXA,SAASA,CAAGC,KAAK;QAAA,OAAK,CAAC,OAAO,EAAE,MAAM,EAAE,MAAM,CAAC,CAACC,QAAQ,CAACD,KAAK;MAAA;IAChE,CAAC;IACDE,IAAI,EAAE;MACJL,IAAI,EAAEM,MAAM;MACZ,WAAS,EAAE;IACb,CAAC;IACDC,IAAI,EAAE;MACJP,IAAI,EAAEM,MAAM;MACZ,WAAS,EAAE;IACb,CAAC;IACDE,KAAK,EAAE;MACLR,IAAI,EAAEM,MAAM;MACZ,WAAS,EAAE;IACb;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}