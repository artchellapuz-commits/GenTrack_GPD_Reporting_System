ted_6), [[_vModelCheckbox, $data.selectedPlants]]), _createElementVNode(\"div\", _hoisted_7, [_createElementVNode(\"span\", _hoisted_8, _toDisplayString(plant.name), 1 /* TEXT */), _createElementVNode(\"span\", _hoisted_9, _toDisplayString(plant.code), 1 /* TEXT */)]), $data.selectedPlants.includes(plant.code) ? (_openBlock(), _createElementBlock(\"i\", _hoisted_10)) : _createCommentVNode(\"v-if\", true)], 2 /* CLASS */);\n    }), 128 /* KEYED_FRAGMENT */))])]), _createCommentVNode(\" Date Range \"), _createElementVNode(\"div\", _hoisted_11, [_createElementVNode(\"div\", _hoisted_12, [_createElementVNode(\"label\", _hoisted_13, [_cache[6] || (_cache[6] = _createElementVNode(\"i\", {\n      class: \"pi pi-calendar\"\n    }, null, -1 /* CACHED */)), _createTextVNode(\" \" + _toDisplayString($data.reportType === 'daily_status' ? 'Report Date' : 'Start Date'), 1 /* TEXT */)]), _withDirectives(_createElementVNode(\"input\", {\n      type: \"date\",\n      \"onUpdate:modelValue\": _cache[1] || (_cache[1] = $event => $data.startDate = $event),\n      class: \"date-input glass-input\",\n      required: \"\"\n    }, null, 512 /* NEED_PATCH */), [[_vModelText, $data.startDate]]), $data.reportType === 'daily_status' ? (_openBlock(), _createElementBlock(\"p\", _hoisted_14, [...(_cache[7] || (_cache[7] = [_createElementVNode(\"i\", {\n      class: \"pi pi-info-circle\"\n    }, null, -1 /* CACHED */), _createTextVNode(\" Daily report will be generated for this specific date \", -1 /* CACHED */)]))])) : _createCommentVNode(\"v-if\", true)]), $data.reportType !== 'daily_status' ? (_openBlock(), _createElementBlock(\"div\", _hoisted_15, [_cache[8] || (_cache[8] = _createElementVNode(\"label\", {\n      class: \"field-label\"\n    }, [_createElementVNode(\"i\", {\n      class: \"pi pi-calendar\"\n    }), _createTextVNode(\" End Date \")], -1 /* CACHED */)), _withDirectives(_createElementVNode(\"input\", {\n      type: \"date\",\n      \"onUpdate:modelValue\": _cache[2] || (_cache[2] = $event => $data.endDate = $event),\n      class: \"date-input glass-input\",\n      required: \"\"\n    }, null, 512 /* NEED_PATCH */), [[_vModelText, $data.endDate]])])) : _createCommentVNode(\"v-if\", true)]), _createCommentVNode(\" Report Type \"), _createElementVNode(\"div\", _hoisted_16, [_cache[9] || (_cache[9] = _createElementVNode(\"label\", {\n      class: \"field-label\"\n    }, [_createElementVNode(\"i\", {\n      class: \"pi pi-file\"\n    }), _createTextVNode(\" Report Type \")], -1 /* CACHED */)), _createElementVNode(\"div\", _hoisted_17, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.reportTypes, type => {\n      return _openBlock(), _createElementBlock(\"label\", {\n        key: type.value,\n        class: _normalizeClass([\"report-type-option\", {\n          'active': $data.reportType === type.value\n        }])\n      }, [_withDirectives(_createElementVNode(\"input\", {\n        type: \"radio\",\n        value: type.value,\n        \"onUpdate:modelValue\": _cache[3] || (_cache[3] = $event => $data.reportType = $event),\n        class: \"radio-input\"\n      }, null, 8 /* PROPS */, _hoisted_18), [[_vModelRadio, $data.reportType]]), _createElementVNode(\"div\", _hoisted_19, [_createElementVNode(\"i\", {\n        class: _normalizeClass(type.icon)\n      }, null, 2 /* CLASS */), _createElementVNode(\"div\", _hoisted_20, [_createElementVNode(\"span\", _hoisted_21, _toDisplayString(type.label), 1 /* TEXT */), _createElementVNode(\"span\", _hoisted_22, _toDisplayString(type.description), 1 /* TEXT */)])])], 2 /* CLASS */);\n    }), 128 /* KEYED_FRAGMENT */))])]), _createCommentVNode(\" Generate Button \"), _createElementVNode(\"button\", {\n      type: \"submit\",\n      disabled: !$options.canGenerate || $data.generating,\n      class: \"btn-generate glass-button\"\n    }, [!$data.generating ? (_openBlock(), _createElementBlock(\"i\", _hoisted_24)) : (_openBlock(), _createElementBlock(\"i\", _hoisted_25)), _createElementVNode(\"span\", null, _toDisplayString($data.generating ? 'Generating...' : 'Generate Report'), 1 /* TEXT */)], 8 /* PROPS */, _hoisted_23)], 32 /* NEED_HYDRATION */)])]), _createCommentVNode(\" Alert Messages \"), _createVNode(_Transition, {\n      name: \"fade\"\n    }, {\n      default: _withCtx(() => [_ctx.message ? (_openBlock(), _createElementBlock(\"div\", {\n        key: 0,\n        class: _normalizeClass(['alert', `alert-${_ctx.messageType}`])\n      }, [_createElementVNode(\"i\", {\n        class: _normalizeClass(['pi', _ctx.messageType === 'success' ? 'pi-check-circle' : 'pi-times-circle'])\n      }, null, 2 /* CLASS */), _createElementVNode(\"span\", null, _toDisplayString(_ctx.message), 1 /* TEXT */)], 2 /* CLASS */)) : _createCommentVNode(\"v-if\", true)]),\n      _: 1 /* STABLE */\n    })])]),\n    _: 1 /* STABLE */\n  });\n}","map":{"version":3,"names":["class","_createBlock","_component_AppLayout","_createElementVNode","_hoisted_1","_createCommentVNode","_hoisted_2","_hoisted_3","onSubmit","_cache","_withModifiers","args","$options","generateReport","_hoisted_4","_hoisted_5","_createElementBlock","_Fragment","_renderList","$data","plants","plant","key","code","_normalizeClass","selectedPlants","includes","type","value","$event","_hoisted_7","_hoisted_8","_toDisplayString","name","_hoisted_9","_hoisted_10","_hoisted_11","_hoisted_12","_hoisted_13","reportType","startDate","required","_hoisted_14","_hoisted_15","endDate","_hoisted_16","_hoisted_17","reportTypes","_hoisted_19","icon","_hoisted_20","_hoisted_21","label","_hoisted_22","description","disabled","canGenerate","generating","_hoisted_24","_hoisted_25","_createVNode","_Transition","_ctx","message","messageType"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\GenerateReport.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n    <div class=\"generate-report-page glass-background\">\r\n    <!-- Page Header -->\r\n    <div class=\"page-header\">\r\n      <h2 class=\"page-title\">Generate Excel Report</h2>\r\n      <p class=\"page-description\">\r\n        Create and download customized generation reports\r\n      </p>\r\n    </div>\r\n\r\n    <!-- Main Form Card -->\r\n    <div class=\"card glass-card glass-fade-in\r\n    \">\r\n      <div class=\"card-body\">\r\n        <form @submit.prevent=\"generateReport\" class=\"report-form\">\r\n          <!-- Plant Selection -->\r\n          <div class=\"form-section\">\r\n            <label class=\"section-label\">\r\n              <i class=\"pi pi-building\"></i>\r\n              Select Plants\r\n            </label>\r\n            <div class=\"plants-grid\">\r\n              <label \r\n                v-for=\"plant in plants\" \r\n                :key=\"plant.code\"\r\n                class=\"plant-checkbox\"\r\n                :class=\"{ 'selected': selectedPlants.includes(plant.code) }\"\r\n              >\r\n                <input \r\n                  type=\"checkbox\" \r\n                  :value=\"plant.code\" \r\n                  v-model=\"selectedPlants\"\r\n                  class=\"checkbox-input\"\r\n                />\r\n                <div class=\"plant-info\">\r\n                  <span class=\"plant-name\">{{ plant.name }}</span>\r\n                  <span class=\"plant-code\">{{ plant.code }}</span>\r\n                </div>\r\n                <i v-if=\"selectedPlants.includes(plant.code)\" class=\"pi pi-check check-icon\"></i>\r\n              </label>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Date Range -->\r\n          <div class=\"form-row\">\r\n            <div class=\"form-field\">\r\n              <label class=\"field-label\">\r\n                <i class=\"pi pi-calendar\"></i>\r\n                {{ reportType === 'daily_status' ? 'Report Date' : 'Start Date' }}\r\n              </label>\r\n              <input \r\n                type=\"date\" \r\n                v-model=\"startDate\" \r\n                class=\"date-input glass-input\"\r\n                required\r\n              />\r\n              <p v-if=\"reportType === 'daily_status'\" class=\"field-hint\">\r\n                <i class=\"pi pi-info-circle\"></i>\r\n                Daily report will be generated for this specific date\r\n              </p>\r\n            </div>\r\n\r\n            <div v-if=\"reportType !== 'daily_status'\" class=\"form-field\">\r\n              <label class=\"field-label\">\r\n                <i class=\"pi pi-calendar\"></i>\r\n                End Date\r\n              </label>\r\n              <input \r\n                type=\"date\" \r\n                v-model=\"endDate\" \r\n                class=\"date-input glass-input\"\r\n                required\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Report Type -->\r\n          <div class=\"form-field\">\r\n            <label class=\"field-label\">\r\n              <i class=\"pi pi-file\"></i>\r\n              Report Type\r\n            </label>\r\n            <div class=\"report-types\">\r\n              <label \r\n                v-for=\"type in reportTypes\" \r\n                :key=\"type.value\"\r\n                class=\"report-type-option\"\r\n                :class=\"{ 'active': reportType === type.value }\"\r\n              >\r\n                <input \r\n                  type=\"radio\" \r\n                  :value=\"type.value\" \r\n                  v-model=\"reportType\"\r\n                  class=\"radio-input\"\r\n                />\r\n                <div class=\"type-content\">\r\n                  <i :class=\"type.icon\"></i>\r\n                  <div class=\"type-text\">\r\n                    <span class=\"type-name\">{{ type.label }}</span>\r\n                    <span class=\"type-desc\">{{ type.description }}</span>\r\n                  </div>\r\n                </div>\r\n              </label>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Generate Button -->\r\n          <button \r\n            type=\"submit\"\r\n            :disabled=\"!canGenerate || generating\"\r\n            class=\"btn-generate glass-button\"\r\n          >\r\n            <i v-if=\"!generating\" class=\"pi pi-download\"></i>\r\n            <i v-else class=\"pi pi-spin pi-spinner\"></i>\r\n            <span>{{ generating ? 'Generating...' : 'Generate Report' }}</span>\r\n          </button>\r\n        </form>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Alert Messages -->\r\n    <transition name=\"fade\">\r\n      <div v-if=\"message\" :class=\"['alert', `alert-${messageType}`]\">\r\n        <i :class=\"['pi', messageType === 'success' ? 'pi-check-circle' : 'pi-times-circle']\"></i>\r\n        <span>{{ message }}</span>\r\n      </div>\r\n    </transition>\r\n  </div>\r\n  </AppLayout>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api';\r\nimport AppLayout from './AppLayout.vue';\r\nimport toast from '../utils/toast';\r\n\r\nexport default {\r\n  name: 'GenerateReport',\r\n  components: {\r\n    AppLayout,\r\n  },\r\n  data() {\r\n    return {\r\n      plants: [],\r\n      selectedPlants: [],\r\n      startDate: '',\r\n      endDate: '',\r\n      reportType: 'psr',\r\n      generating: false,\r\n      reportTypes: [\r\n        {\r\n          value: 'psr',\r\n          label: 'Plant Status Report (PSR)',\r\n          description: 'Official PSR format for Mindanao plants',\r\n          icon: 'pi pi-file-excel'\r\n        },\r\n        {\r\n          value: 'daily_status',\r\n          label: 'Daily Plant Status Report',\r\n          description: 'Daily status with capacity, load, and lake elevations',\r\n          icon: 'pi pi-calendar'\r\n        }\r\n      ]\r\n    };\r\n  },\r\n  computed: {\r\n    canGenerate() {\r\n      // For daily status report, only start date is required\r\n      if (this.reportType === 'daily_status') {\r\n        return this.selectedPlants.length > 0 && this.startDate;\r\n      }\r\n      // For other reports, both dates are required\r\n      return this.selectedPlants.length > 0 && this.startDate && this.endDate;\r\n    },\r\n  },\r\n  mounted() {\r\n    this.loadPlants();\r\n  },\r\n  methods: {\r\n    async loadPlants() {\r\n      try {\r\n        const response = await api.getPlants();\r\n        // Handle both paginated and non-paginated responses\r\n        this.plants = response.data.results || response.data;\r\n        console.log('Loaded plants:', this.plants);\r\n      } catch (error) {\r\n        console.error('Error loading plants:', error);\r\n        toast.error('Error loading plants: ' + (error.message || 'Unknown error'));\r\n      }\r\n    },\r\n    async generateReport() {\r\n      if (!this.canGenerate) return;\r\n\r\n      this.generating = true;\r\n\r\n      try {\r\n        // For daily status report, automatically set end_date = start_date\r\n        const endDateToUse = this.reportType === 'daily_status' ? this.startDate : this.endDate;\r\n        \r\n        const response = await api.generateReport({\r\n          plant_codes: this.selectedPlants,\r\n          start_date: this.startDate,\r\n          end_date: endDateToUse,\r\n          report_type: this.reportType,\r\n        });\r\n\r\n        // Create download link\r\n        const url = window.URL.createObjectURL(new Blob([response.data]));\r\n        const link = document.createElement('a');\r\n        link.href = url;\r\n        \r\n        // Set filename based on report type\r\n        const dateStr = this.startDate.replace(/-/g, '');\r\n        let filename;\r\n        if (this.reportType === 'daily_status') {\r\n          filename = `DAILY_PLANT_STATUS_${dateStr}.xlsx`;\r\n        } else {\r\n          filename = `PLANT_STATUS_${dateStr}.xlsx`;\r\n        }\r\n        \r\n        link.setAttribute('download', filename);\r\n        document.body.appendChild(link);\r\n        link.click();\r\n        link.remove();\r\n\r\n        toast.success('Report generated successfully!');\r\n      } catch (error) {\r\n        console.error('Generate report error:', error);\r\n        let errorMsg = 'Failed to generate report';\r\n        \r\n        // Handle blob response errors\r\n        if (error.response?.data instanceof Blob) {\r\n          try {\r\n            const text = await error.response.data.text();\r\n            const errorData = JSON.parse(text);\r\n            errorMsg = errorData.error || errorMsg;\r\n            \r\n            // Add helpful hint if no data found\r\n            if (errorMsg.includes('No data found')) {\r\n              errorMsg += '. Please upload Excel files first in the Upload Excel Reports page.';\r\n            }\r\n          } catch (e) {\r\n            errorMsg = error.response?.statusText || errorMsg;\r\n          }\r\n        } else if (error.response?.data?.error) {\r\n          errorMsg = error.response.data.error;\r\n          if (errorMsg.includes('No data found')) {\r\n            errorMsg += '. Please upload Excel files first in the Upload Excel Reports page.';\r\n          }\r\n        } else if (error.message) {\r\n          errorMsg = error.message;\r\n        }\r\n        \r\n        toast.error(errorMsg, 6000);\r\n      } finally {\r\n        this.generating = false;\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.generate-report-page {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n}\r\n\r\n/* Header */\r\n.page-header {\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n.page-title {\r\n  font-size: 1.75rem;\r\n  font-weight: 600;\r\n  color: #1a202c;\r\n  margin: 0 0 0.5rem 0;\r\n  letter-spacing: -0.025em;\r\n}\r\n\r\n.page-description {\r\n  color: #718096;\r\n  font-size: 0.9375rem;\r\n  margin: 0;\r\n}\r\n\r\n/* Form */\r\n.report-form {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2rem;\r\n}\r\n\r\n.form-section,\r\n.form-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.75rem;\r\n}\r\n\r\n.section-label,\r\n.field-label {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  font-size: 0.875rem;\r\n  font-weight: 600;\r\n  color: #2d3748;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n}\r\n\r\n.section-label i,\r\n.field-label i {\r\n  color: var(--npc-primary);\r\n  font-size: 1rem;\r\n}\r\n\r\n/* Plants Grid */\r\n.plants-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\r\n  gap: 0.75rem;\r\n}\r\n\r\n.plant-checkbox {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.75rem;\r\n  padding: 1rem;\r\n  background: #f7fafc;\r\n  border: 2px solid #e2e8f0;\r\n  border-radius: 0.5rem;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.plant-checkbox:hover {\r\n  border-color: var(--npc-primary);\r\n  background: #edf2f7;\r\n}\r\n\r\n.plant-checkbox.selected {\r\n  border-color: var(--npc-primary);\r\n  background: rgba(0, 61, 130, 0.04);\r\n}\r\n\r\n.checkbox-input {\r\n  position: absolute;\r\n  opacity: 0;\r\n  width: 0;\r\n  height: 0;\r\n}\r\n\r\n.plant-info {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.25rem;\r\n}\r\n\r\n.plant-name {\r\n  font-size: 0.875rem;\r\n  font-weight: 500;\r\n  color: #2d3748;\r\n}\r\n\r\n.plant-code {\r\n  font-size: 0.75rem;\r\n  color: #718096;\r\n  font-weight: 600;\r\n  letter-spacing: 0.05em;\r\n}\r\n\r\n.check-icon {\r\n  color: var(--npc-primary);\r\n  font-size: 1.125rem;\r\n  font-weight: bold;\r\n}\r\n\r\n/* Form Row */\r\n.form-row {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\r\n  gap: 1rem;\r\n}\r\n\r\n/* Date Input */\r\n.date-input {\r\n  padding: 0.75rem 1rem;\r\n  border: 2px solid #e2e8f0;\r\n  border-radius: 0.5rem;\r\n  font-size: 0.9375rem;\r\n  color: #2d3748;\r\n  background: white;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.date-input:hover {\r\n  border-color: #cbd5e0;\r\n}\r\n\r\n.date-input:focus {\r\n  outline: none;\r\n  border-color: var(--npc-