{"ast":null,"code":"import { createElementVNode as _createElementVNode, openBlock as _openBlock, createElementBlock as _createElementBlock, createCommentVNode as _createCommentVNode } from \"vue\";\nconst _hoisted_1 = {\n  key: 0,\n  class: \"pwa-install-prompt\"\n};\nconst _hoisted_2 = {\n  class: \"prompt-content\"\n};\nconst _hoisted_3 = {\n  class: \"prompt-actions\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return $setup.showPrompt ? (_openBlock(), _createElementBlock(\"div\", _hoisted_1, [_createElementVNode(\"div\", _hoisted_2, [_cache[2] || (_cache[2] = _createElementVNode(\"i\", {\n    class: \"pi pi-mobile\",\n    style: {\n      \"font-size\": \"2rem\",\n      \"color\": \"#3b82f6\"\n    }\n  }, null, -1)), _cache[3] || (_cache[3] = _createElementVNode(\"div\", {\n    class: \"prompt-text\"\n  }, [_createElementVNode(\"h3\", null, \"Install NPC Reports\"), _createElementVNode(\"p\", null, \"Install our app for quick access and offline support\")], -1)), _createElementVNode(\"div\", _hoisted_3, [_createElementVNode(\"button\", {\n    onClick: _cache[0] || (_cache[0] = (...args) => $setup.install && $setup.install(...args)),\n    class: \"btn-install\"\n  }, \"Install\"), _createElementVNode(\"button\", {\n    onClick: _cache[1] || (_cache[1] = (...args) => $setup.dismiss && $setup.dismiss(...args)),\n    class: \"btn-dismiss\"\n  }, \"Not Now\")])])])) : _createCommentVNode(\"\", true);\n}","map":{"version":3,"names":["class","$setup","showPrompt","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","style","_hoisted_3","onClick","_cache","args","install","dismiss"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern\\npc-reporting-system\\frontend\\src\\components\\PWAInstallPrompt.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"showPrompt\" class=\"pwa-install-prompt\">\r\n    <div class=\"prompt-content\">\r\n      <i class=\"pi pi-mobile\" style=\"font-size: 2rem; color: #3b82f6;\"></i>\r\n      <div class=\"prompt-text\">\r\n        <h3>Install NPC Reports</h3>\r\n        <p>Install our app for quick access and offline support</p>\r\n      </div>\r\n      <div class=\"prompt-actions\">\r\n        <button @click=\"install\" class=\"btn-install\">Install</button>\r\n        <button @click=\"dismiss\" class=\"btn-dismiss\">Not Now</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport pwaUtils from '../utils/pwaUtils';\r\n\r\nexport default {\r\n  name: 'PWAInstallPrompt',\r\n  setup() {\r\n    const showPrompt = ref(false);\r\n    let deferredPrompt = null;\r\n\r\n    onMounted(() => {\r\n      // Listen for beforeinstallprompt event\r\n      window.addEventListener('beforeinstallprompt', (e) => {\r\n        e.preventDefault();\r\n        deferredPrompt = e;\r\n        \r\n        // Show prompt if not already installed and user hasn't dismissed\r\n        if (!pwaUtils.isPWA() && !localStorage.getItem('pwa_prompt_dismissed')) {\r\n          showPrompt.value = true;\r\n        }\r\n      });\r\n\r\n      // Check if already installed\r\n      window.addEventListener('appinstalled', () => {\r\n        showPrompt.value = false;\r\n        deferredPrompt = null;\r\n      });\r\n    });\r\n\r\n    const install = async () => {\r\n      if (deferredPrompt) {\r\n        const accepted = await pwaUtils.promptInstall(deferredPrompt);\r\n        if (accepted) {\r\n          showPrompt.value = false;\r\n          deferredPrompt = null;\r\n        }\r\n      }\r\n    };\r\n\r\n    const dismiss = () => {\r\n      showPrompt.value = false;\r\n      localStorage.setItem('pwa_prompt_dismissed', 'true');\r\n    };\r\n\r\n    return {\r\n      showPrompt,\r\n      install,\r\n      dismiss\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.pwa-install-prompt {\r\n  position: fixed;\r\n  bottom: 20px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  z-index: 9999;\r\n  animation: slideUp 0.3s ease-out;\r\n}\r\n\r\n.prompt-content {\r\n  background: white;\r\n  border-radius: 12px;\r\n  padding: 20px;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 15px;\r\n  max-width: 500px;\r\n}\r\n\r\n.prompt-text h3 {\r\n  margin: 0 0 5px 0;\r\n  font-size: 1.1rem;\r\n  color: #1e293b;\r\n}\r\n\r\n.prompt-text p {\r\n  margin: 0;\r\n  font-size: 0.9rem;\r\n  color: #64748b;\r\n}\r\n\r\n.prompt-actions {\r\n  display: flex;\r\n  gap: 10px;\r\n  margin-left: auto;\r\n}\r\n\r\n.btn-install, .btn-dismiss {\r\n  padding: 8px 16px;\r\n  border: none;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n  font-size: 0.9rem;\r\n  transition: all 0.2s;\r\n}\r\n\r\n.btn-install {\r\n  background: #3b82f6;\r\n  color: white;\r\n}\r\n\r\n.btn-install:hover {\r\n  background: #2563eb;\r\n}\r\n\r\n.btn-dismiss {\r\n  background: #f1f5f9;\r\n  color: #64748b;\r\n}\r\n\r\n.btn-dismiss:hover {\r\n  background: #e2e8f0;\r\n}\r\n\r\n@keyframes slideUp {\r\n  from {\r\n    transform: translateX(-50%) translateY(100px);\r\n    opacity: 0;\r\n  }\r\n  to {\r\n    transform: translateX(-50%) translateY(0);\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .pwa-install-prompt {\r\n    left: 10px;\r\n    right: 10px;\r\n    transform: none;\r\n  }\r\n  \r\n  .prompt-content {\r\n    flex-direction: column;\r\n    text-align: center;\r\n  }\r\n  \r\n  .prompt-actions {\r\n    margin-left: 0;\r\n    width: 100%;\r\n  }\r\n  \r\n  .btn-install, .btn-dismiss {\r\n    flex: 1;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;;EACyBA,KAAK,EAAC;;;EACtBA,KAAK,EAAC;AAAgB;;EAMpBA,KAAK,EAAC;AAAgB;;SAPpBC,MAAA,CAAAC,UAAU,I,cAArBC,mBAAA,CAYM,OAZNC,UAYM,GAXJC,mBAAA,CAUM,OAVNC,UAUM,G,0BATJD,mBAAA,CAAqE;IAAlEL,KAAK,EAAC,cAAc;IAACO,KAAwC,EAAxC;MAAA;MAAA;IAAA;2CACxBF,mBAAA,CAGM;IAHDL,KAAK,EAAC;EAAa,IACtBK,mBAAA,CAA4B,YAAxB,qBAAmB,GACvBA,mBAAA,CAA2D,WAAxD,sDAAoD,E,QAEzDA,mBAAA,CAGM,OAHNG,UAGM,GAFJH,mBAAA,CAA6D;IAApDI,OAAK,EAA