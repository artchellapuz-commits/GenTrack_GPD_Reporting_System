a-v-644cb835><div class=\\\"opportunities-card-glass\\\" data-v-644cb835><h2 data-v-644cb835>Interested in Joining NPC?</h2><p data-v-644cb835>For career opportunities with the National Power Corporation, please visit the official NPC website or contact the Human Resources department at your nearest NPC office</p><div class=\\\"contact-info\\\" data-v-644cb835><div class=\\\"info-item\\\" data-v-644cb835><i class=\\\"pi pi-building\\\" data-v-644cb835></i><span data-v-644cb835>Visit NPC Official Website</span></div></div></div></div>\", 1))]);\n}","map":{"version":3,"names":["_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","_createVNode","_component_router_link","to","_toConsumableArray","_cache","_hoisted_3","_Fragment","_renderList","$data","benefits","benefit","index","key","style","_normalizeStyle","animationDelay","concat","_hoisted_4","_normalizeClass","icon","_toDisplayString","title","description"],"sources":["C:\\Users\\rigan\\OneDrive\\Desktop\\OJT Intern_v2 (2)\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\Careers.vue"],"sourcesContent":["<template>\r\n  <div class=\"careers-page\">\r\n    <!-- Animated Background -->\r\n    <div class=\"animated-bg\">\r\n      <div class=\"bg-shape shape-1\"></div>\r\n      <div class=\"bg-shape shape-2\"></div>\r\n      <div class=\"bg-shape shape-3\"></div>\r\n    </div>\r\n\r\n    <!-- Back Button Top Left -->\r\n    <div class=\"back-button-top-left\">\r\n      <router-link to=\"/\" class=\"btn-back-glass-small\">\r\n        <i class=\"pi pi-arrow-left\"></i>\r\n        <span>Back to Home</span>\r\n      </router-link>\r\n    </div>\r\n\r\n    <!-- Header -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"header-icon\">\r\n          <i class=\"pi pi-briefcase\"></i>\r\n        </div>\r\n        <h1 class=\"glowing-text\">Careers at GPD</h1>\r\n        <p class=\"subtitle\">Join our team and power the future</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Why Join Us -->\r\n    <div class=\"why-join-section\">\r\n      <div class=\"section-card-glass\">\r\n        <h2>Why Join GPD?</h2>\r\n        <p>Be part of a team that powers Mindanao's energy future. We offer competitive benefits, professional growth opportunities, and a collaborative work environment.</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Benefits -->\r\n    <div class=\"benefits-container\">\r\n      <div \r\n        v-for=\"(benefit, index) in benefits\" \r\n        :key=\"index\"\r\n        class=\"benefit-card-glass\"\r\n        :style=\"{ animationDelay: `${index * 0.1}s` }\"\r\n      >\r\n        <div class=\"benefit-icon\">\r\n          <i :class=\"benefit.icon\"></i>\r\n        </div>\r\n        <h3>{{ benefit.title }}</h3>\r\n        <p>{{ benefit.description }}</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Contact for Opportunities -->\r\n    <div class=\"opportunities-section\">\r\n      <div class=\"opportunities-card-glass\">\r\n        <h2>Interested in Joining NPC?</h2>\r\n        <p>For career opportunities with the National Power Corporation, please visit the official NPC website or contact the Human Resources department at your nearest NPC office</p>\r\n        <div class=\"contact-info\">\r\n          <div class=\"info-item\">\r\n            <i class=\"pi pi-building\"></i>\r\n            <span>Visit NPC Official Website</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'Careers',\r\n  data() {\r\n    return {\r\n      benefits: [\r\n        {\r\n          icon: 'pi pi-dollar',\r\n          title: 'Competitive Salary',\r\n          description: 'Industry-standard compensation packages with performance bonuses'\r\n        },\r\n        {\r\n          icon: 'pi pi-heart',\r\n          title: 'Health Benefits',\r\n          description: 'Comprehensive health insurance for you and your family'\r\n        },\r\n        {\r\n          icon: 'pi pi-chart-line',\r\n          title: 'Career Growth',\r\n          description: 'Professional development programs and advancement opportunities'\r\n        },\r\n        {\r\n          icon: 'pi pi-users',\r\n          title: 'Team Culture',\r\n          description: 'Collaborative and supportive work environment'\r\n        },\r\n        {\r\n          icon: 'pi pi-calendar',\r\n          title: 'Work-Life Balance',\r\n          description: 'Flexible schedules and generous leave policies'\r\n        },\r\n        {\r\n          icon: 'pi pi-graduation-cap',\r\n          title: 'Training Programs',\r\n          description: 'Continuous learning and skills development opportunities'\r\n        }\r\n      ]\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.careers-page {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);\r\n  padding: 100px 20px 80px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.animated-bg {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.bg-shape {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  filter: blur(80px);\r\n  opacity: 0.15;\r\n  animation: float 20s ease-in-out infinite;\r\n}\r\n\r\n.shape-1 {\r\n  width: 500px;\r\n  height: 500px;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  top: -200px;\r\n  left: -200px;\r\n}\r\n\r\n.shape-2 {\r\n  width: 400px;\r\n  height: 400px;\r\n  background: linear-gradient(135deg, #ec4899 0%, #f59e0b 100%);\r\n  bottom: -150px;\r\n  right: -150px;\r\n  animation-delay: 5s;\r\n}\r\n\r\n.shape-3 {\r\n  width: 350px;\r\n  height: 350px;\r\n  background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation-delay: 10s;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% { transform: translate(0, 0) scale(1); }\r\n  33% { transform: translate(100px, -100px) scale(1.1); }\r\n  66% { transform: translate(-100px, 100px) scale(0.9); }\r\n}\r\n\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.header-icon {\r\n  width: 100px;\r\n  height: 100px;\r\n  margin: 0 auto 30px;\r\n  border-radius: 30px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 3rem;\r\n  color: #60a5fa;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n  animation: iconPulse 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes iconPulse {\r\n  0%, 100% { transform: scale(1); }\r\n  50% { transform: scale(1.05); }\r\n}\r\n\r\n.glowing-text {\r\n  font-size: 4rem;\r\n  font-weight: 900;\r\n  background: linear-gradient(135deg, #ffffff 0%, #60a5fa 50%, #a78bfa 100%);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  background-clip: text;\r\n  margin: 0 0 20px 0;\r\n  letter-spacing: -2px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 1.5rem;\r\n  color: #cbd5e1;\r\n  margin: 0;\r\n  font-weight: 300;\r\n}\r\n\r\n.why-join-section {\r\n  max-width: 900px;\r\n  margin: 0 auto 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.section-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.1) 0%, \r\n    rgba(139, 92, 246, 0.1) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(96, 165, 250, 0.3);\r\n  padding: 50px;\r\n  text-align: center;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.section-card-glass h2 {\r\n  font-size: 2.5rem;\r\n  color: white !important;\r\n  margin: 0 0 24px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.section-card-glass p {\r\n  font-size: 1.25rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  margin: 0;\r\n}\r\n\r\n.benefits-container {\r\n  max-width: 1200px;\r\n  margin: 0 auto 80px;\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\r\n  gap: 30px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.benefit-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(255, 255, 255, 0.05) 0%, \r\n    rgba(255, 255, 255, 0.02) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  padding: 40px;\r\n  text-align: center;\r\n  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n  animation: fadeInUp 0.6s ease-out backwards;\r\n}\r\n\r\n@keyframes fadeInUp {\r\n  from { opacity: 0; transform: translateY(30px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n.benefit-card-glass:hover {\r\n  transform: translateY(-10px) scale(1.02);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 30px 80px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.benefit-icon {\r\n  width: 80px;\r\n  height: 80px;\r\n  margin: 0 auto 24px;\r\n  border-radius: 20px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 2.5rem;\r\n  color: #60a5fa;\r\n  transition: all 0.4s ease;\r\n}\r\n\r\n.benefit-card-glass:hover .benefit-icon {\r\n  transform: scale(1.1) rotate(5deg);\r\n}\r\n\r\n.benefit-card-glass h3 {\r\n  font-size: 1.5rem;\r\n  color: white !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.benefit-card-glass p {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  margin: 0;\r\n}\r\n\r\n.opportunities-section {\r\n  max-width: 900px;\r\n  margin: 0 auto 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.opportunities-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.1) 0%, \r\n    rgba(139, 92, 246, 0.1) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(96, 165, 250, 0.3);\r\n  padding: 50px;\r\n  text-align: center;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.opportunities-card-glass h2 {\r\n  font-size: 2.5rem;\r\n  color: white !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.opportunities-card-glass p {\r\n  font-size: 1.25rem;\r\n  color: #cbd5e1 !important;\r\n  margin: 0 0 40px 0;\r\n}\r\n\r\n.contact-info {\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 40px;\r\n}\r\n\r\n.info-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  font-size: 1.25rem;\r\n  color: #e2e8f0 !important;\r\n}\r\n\r\n.info-item i {\r\n  font-size: 1.5rem;\r\n  color: #60a5fa;\r\n}\r\n\r\n/* Back Button Top Left */\r\n.back-button-top-left {\r\n  position: fixed;\r\n  top: 30px;\r\n  left: 30px;\r\n  z-index: 1000;\r\n}\r\n\r\n.btn-back-glass-small {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 12px 24px;\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.3) 0%, \r\n    rgba(139, 92, 246, 0.3) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 12px;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.btn-back-glass-small:hover {\r\n  transform: translateX(-5px);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 12px 40px rgba(59, 130, 246, 0.5);\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.4) 0%, \r\n    rgba(139, 92, 246, 0.4) 100%);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .benefits-container {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .glowing-text {\r\n    font-size: 2.5rem;\r\n  }\r\n  \r\n  .contact-info {\r\n    flex-direction: column;\r\n    gap: 20px;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;;;;EACO,SAAM;AAAc;;EASlB,SAAM;AAAsB;;EA2B5B,SAAM;AAAoB;;EAOtB,SAAM;AAAc;;;uBA3C/BA,mBAAA,CAiEM,OAjENC,UAiEM,GAhEJC,mBAAA,yBAA4B,E,0BAC5BC,mBAAA,CAIM;IAJD,SAAM;EAAa,IACtBA,mBAAA,CAAoC;IAA/B,SAAM;EAAkB,IAC7BA,mBAAA,CAAoC;IAA/B,SAAM;EAAkB,IAC7BA,mBAAA,CAAoC;IAA/B,SAAM;EAAkB,G,qBAG/BD,mBAAA,0BAA6B,EAC7BC,mBAAA,CAKM,OALNC,UAKM,GAJJC,YAAA,CAGcC,sBAAA;IAHDC,EAAE,EAAC,GAAG;IAAC,SAAM;;wBACxB;MAAA,OAAAC,kBAAA,CAAgCC,MAAA,QAAAA,MAAA,OAAhCN,mBAAA,CAAgC;QAA7B,SAAM;MAAkB,2BAC3BA,mBAAA,CAAyB,cAAnB,cAAY,mB;;;QAItBD,mBAAA,YAAe,E,uYAWfA,mBAAA,iBAAoB,E,0BACpBC,mBAAA,CAKM;IALD,SAAM;EAAkB,IAC3BA,mBAAA,CAGM;IAHD,SAAM;EAAoB,IAC7BA,mBAAA,CAAsB,YAAlB,eAAa,GACjBA,mBAAA,CAAsK,WAAnK,iKAA+J,E,uBAItKD,mBAAA,cAAiB,EACjBC,mBAAA,CAaM,OAbNO,UAaM,I,kBAZJV,mBAAA,CAWMW,SAAA,QAAAC,WAAA,CAVuBC,KAAA,CAAAC,QAAQ,YAA3BC,OAAO,EAAEC,KAAK;yBADxBhB,mBAAA,CAWM;MATHiB,GAAG,EAAED,KAAK;MACX,SAAM,oBAAoB;MACzBE,KAAK,EAAAC,eAAA;QAAAC,cAAA,KAAAC,MAAA,CAAuBL,KAAK;MAAA;QAElCb,mBAAA,CAEM,OAFNmB,UAEM,GADJnB,mBAAA,CAA6B;MAAzB,SAAKoB,eAAA,CAAER,OAAO,CAACS,IAAI;+BAEzBrB,mBAAA,CAA4B,YAAAsB,gBAAA,CAArBV,OAAO,CAACW,KAAK,kBACpBvB,mBAAA,CAAgC,WAAAsB,gBAAA,CAA1BV,OAAO,CAACY,WAAW,iB;oCAI7BzB,mBAAA,+BAAkC,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}