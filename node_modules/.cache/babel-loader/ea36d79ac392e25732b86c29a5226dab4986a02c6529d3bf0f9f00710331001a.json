username = savedUsername;\n        this.rememberMe = true;\n      }\n      // Password field stays empty after logout\n    } else {\n      // Normal page load - load saved credentials if Remember Me was checked\n      var _savedUsername = localStorage.getItem('rememberedUsername');\n      var savedPassword = localStorage.getItem('rememberedPassword');\n      var _wasRemembered = localStorage.getItem('rememberMe') === 'true';\n      if (_wasRemembered && _savedUsername) {\n        this.credentials.username = _savedUsername;\n        if (savedPassword) {\n          this.credentials.password = atob(savedPassword); // Decode from base64\n        }\n        this.rememberMe = true;\n      }\n    }\n  },\n  beforeUnmount: function beforeUnmount() {},\n  methods: {\n    generateParticleStyle: function generateParticleStyle(index) {\n      var size = Math.random() * 4 + 2;\n      var left = Math.random() * 100;\n      var top = Math.random() * 100;\n      var duration = Math.random() * 15 + 10;\n      var delay = Math.random() * -15;\n      return {\n        width: \"\".concat(size, \"px\"),\n        height: \"\".concat(size, \"px\"),\n        left: \"\".concat(left, \"%\"),\n        top: \"\".concat(top, \"%\"),\n        animationDuration: \"\".concat(duration, \"s\"),\n        animationDelay: \"\".concat(delay, \"s\"),\n        opacity: Math.random() * 0.4 + 0.1\n      };\n    },\n    submitResetRequest: function submitResetRequest() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var _t;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.resetRequestLoading = true;\n              _this.resetRequestError = null;\n              _context.p = 1;\n              _context.n = 2;\n              return axios.post(\"\".concat(process.env.VUE_APP_API_URL, \"/auth/password_reset_request/\"), {\n                use