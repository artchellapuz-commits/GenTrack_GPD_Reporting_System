w your signature here</span>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"signature-info\">\r\n      <small class=\"signature-hint\">\r\n        <i class=\"pi pi-info-circle\"></i>\r\n        Use your mouse or touch to draw your signature. Click \"Save\" when finished.\r\n      </small>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'SignaturePad',\r\n  props: {\r\n    title: {\r\n      type: String,\r\n      default: 'Digital Signature'\r\n    },\r\n    width: {\r\n      type: Number,\r\n      default: 400\r\n    },\r\n    height: {\r\n      type: Number,\r\n      default: 150\r\n    },\r\n    strokeColor: {\r\n      type: String,\r\n      default: '#000080'\r\n    },\r\n    strokeWidth: {\r\n      type: Number,\r\n      default: 2\r\n    }\r\n  },\r\n  emits: ['signature-saved', 'signature-cleared'],\r\n  data() {\r\n    return {\r\n      isDrawing: false,\r\n      hasSignature: false,\r\n      lastX: 0,\r\n      lastY: 0,\r\n      ctx: null\r\n    };\r\n  },\r\n  mounted() {\r\n    this.initCanvas();\r\n  },\r\n  methods: {\r\n    initCanvas() {\r\n      const canvas = this.$refs.canvas;\r\n      this.ctx = canvas.getContext('2d');\r\n      \r\n      // Set canvas size\r\n      canvas.width = this.width;\r\n      canvas.height = this.height;\r\n      \r\n      // Set drawing properties\r\n      this.ctx.strokeStyle = this.strokeColor;\r\n      this.ctx.lineWidth = this.strokeWidth;\r\n      this.ctx.lineCap = 'round';\r\n      this.ctx.lineJoin = 'round';\r\n      \r\n      // Set white background\r\n      this.ctx.fillStyle = 'white';\r\n      this.ctx.fillRect(0, 0, canvas.width, canvas.height);\r\n    },\r\n    \r\n    getEventPos(e) {\r\n      const canvas = this.$refs.canvas;\r\n      const rect = canvas.getBoundingClientRect();\r\n      \r\n      let clientX, clientY;\r\n      \r\n      if (e.touches && e.touches.length > 0) {\r\n        // Touch event\r\n        clientX = e.touches[0].clientX;\r\n        clientY = e.touches[0].clientY;\r\n      } else {\r\n        // Mouse event\r\n        clientX = e.clientX;\r\n        clientY = e.clientY;\r\n      }\r\n      \r\n      return {\r\n        x: clientX - rect.left,\r\n        y: clientY - rect.top\r\n      };\r\n    },\r\n    \r\n    startDrawing(e) {\r\n      e.preventDefault();\r\n      this.isDrawing = true;\r\n      \r\n      const pos = this.getEventPos(e);\r\n      this.lastX = pos.x;\r\n      this.lastY = pos.y;\r\n      \r\n      // Start a new path\r\n      this.ctx.beginPath();\r\n      this.ctx.moveTo(this.lastX, this.lastY);\r\n    },\r\n    \r\n    draw(e) {\r\n      if (!this.isDrawing) return;\r\n      \r\n      e.preventDefault();\r\n      const pos = this.getEventPos(e);\r\n      \r\n      // Draw line from last position to current position\r\n      this.ctx.lineTo(pos.x, pos.y);\r\n      this.ctx.stroke();\r\n      \r\n      this.lastX = pos.x;\r\n      this.lastY = pos.y;\r\n      \r\n      this.hasSignature = true;\r\n    },\r\n    \r\n    stopDrawing(e) {\r\n      if (!this.isDrawing) return;\r\n      \r\n      e.preventDefault();\r\n      this.isDrawing = false;\r\n      this.ctx.beginPath();\r\n    },\r\n    \r\n    clearSignature() {\r\n      const canvas = this.$refs.canvas;\r\n      this.ctx.clearRect(0, 0, canvas.width, canvas.height);\r\n      \r\n      // Reset white background\r\n      this.ctx.fillStyle = 'white';\r\n      this.ctx.fillRect(0, 0, canvas.width, canvas.height);\r\n      \r\n      this.hasSignature = false;\r\n      this.$emit('signature-cleared');\r\n    },\r\n    \r\n    saveSignature() {\r\n      if (!this.hasSignature) return;\r\n      \r\n      const canvas = this.$refs.canvas;\r\n      const signatureData = canvas.toDataURL('image/png');\r\n      \r\n      this.$emit('signature-saved', {\r\n        dataURL: signatureData,\r\n        blob: this.dataURLToBlob(signatureData)\r\n      });\r\n    },\r\n    \r\n    dataURLToBlob(dataURL) {\r\n      const arr = dataURL.split(',');\r\n      const mime = arr[0].match(/:(.*?);/)[1];\r\n      const bstr = atob(arr[1]);\r\n      let n = bstr.length;\r\n      const u8arr = new Uint8Array(n);\r\n      \r\n      while (n--) {\r\n        u8arr[n] = bstr.charCodeAt(n);\r\n      }\r\n      \r\n      return new Blob([u8arr], { type: mime });\r\n    },\r\n    \r\n    getSignatureData() {\r\n      if (!this.hasSignature) return null;\r\n      \r\n      const canvas = this.$refs.canvas;\r\n      return {\r\n        dataURL: canvas.toDataURL('image/png'),\r\n        blob: this.dataURLToBlob(canvas.toDataURL('image/png'))\r\n      };\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.signature-pad-container {\r\n  border: 2px solid #e2e8f0;\r\n  border-radius: 0.5rem;\r\n  background: white;\r\n  overflow: hidden;\r\n}\r\n\r\n.signature-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 1rem;\r\n  background: #f7fafc;\r\n  border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.signature-title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  margin: 0;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  color: #2d3748;\r\n}\r\n\r\n.signature-title i {\r\n  color: var(--npc-primary);\r\n  font-size: 1.125rem;\r\n}\r\n\r\n.signature-actions {\r\n  display: flex;\r\n  gap: 0.5rem;\r\n}\r\n\r\n.btn-clear,\r\n.btn-save {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.375rem;\r\n  padding: 0.5rem 0.75rem;\r\n  border: 1px solid;\r\n  border-radius: 0.375rem;\r\n  font-size: 0.875rem;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.btn-clear {\r\n  background: white;\r\n  color: #ef4444;\r\n  border-color: #ef4444;\r\n}\r\n\r\n.btn-clear:hover {\r\n  background: #ef4444;\r\n  color: white;\r\n}\r\n\r\n.btn-save {\r\n  background: var(--npc-primary);\r\n  color: white;\r\n  border-color: var(--npc-primary);\r\n}\r\n\r\n.btn-save:hover:not(:disabled) {\r\n  background: #004a9f;\r\n  border-color: #004a9f;\r\n}\r\n\r\n.btn-save:disabled {\r\n  opacity: 0.5;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.signature-canvas-container {\r\n  position: relative;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 1rem;\r\n  background: #fafafa;\r\n}\r\n\r\n.signature-canvas {\r\n  border: 2px dashed #cbd5e0;\r\n  border-radius: 0.375rem;\r\n  background: white;\r\n  cursor: crosshair;\r\n  touch-action: none;\r\n}\r\n\r\n.signature-canvas:hover {\r\n  border-color: var(--npc-primary);\r\n}\r\n\r\n.signature-placeholder {\r\n  position: absolute;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  color: #a0aec0;\r\n  font-size: 0.875rem;\r\n  pointer-events: none;\r\n  z-index: 1;\r\n}\r\n\r\n.signature-placeholder i {\r\n  font-size: 2rem;\r\n  color: #cbd5e0;\r\n}\r\n\r\n.signature-info {\r\n  padding: 0.75rem 1rem;\r\n  background: #f7fafc;\r\n  border-top: 1px solid #e2e8f0;\r\n}\r\n\r\n.signature-hint {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.375rem;\r\n  color: #718096;\r\n  font-size: 0.8125rem;\r\n}\r\n\r\n.signature-hint i {\r\n  color: var(--npc-primary);\r\n  font-size: 0.875rem;\r\n}\r\n\r\n/* Mobile responsiveness */\r\n@media (max-width: 640px) {\r\n  .signature-header {\r\n    flex-direction: column;\r\n    gap: 0.75rem;\r\n    align-items: stretch;\r\n  }\r\n  \r\n  .signature-actions {\r\n    justify-content: center;\r\n  }\r\n  \r\n  .signature-canvas {\r\n    max-width: 100%;\r\n    height: auto;\r\n  }\r\n}\r\n</style>"],"mappings":"AAyDA,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDG,MAAM,EAAE;MACNL,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDI,WAAW,EAAE;MACXN,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDK,WAAW,EAAE;MACXP,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX;EACF,CAAC;EACDM,KAAK,EAAE,CAAC,iBAAiB,EAAE,mBAAm