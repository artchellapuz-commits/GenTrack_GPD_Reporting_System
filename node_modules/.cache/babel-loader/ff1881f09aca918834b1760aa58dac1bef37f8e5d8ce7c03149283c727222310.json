{"ast":null,"code":"export default {\n  name: 'SignaturePad',\n  props: {\n    title: {\n      type: String,\n      default: 'Digital Signature'\n    },\n    width: {\n      type: Number,\n      default: 400\n    },\n    height: {\n      type: Number,\n      default: 150\n    },\n    strokeColor: {\n      type: String,\n      default: '#000080'\n    },\n    strokeWidth: {\n      type: Number,\n      default: 2\n    }\n  },\n  emits: ['signature-saved', 'signature-cleared'],\n  data() {\n    return {\n      isDrawing: false,\n      hasSignature: false,\n      lastX: 0,\n      lastY: 0,\n      ctx: null\n    };\n  },\n  mounted() {\n    this.initCanvas();\n  },\n  methods: {\n    initCanvas() {\n      const canvas = this.$refs.canvas;\n      this.ctx = canvas.getContext('2d');\n\n      // Set canvas size\n      canvas.width = this.width;\n      canvas.height = this.height;\n\n      // Set drawing properties\n      this.ctx.strokeStyle = this.strokeColor;\n      this.ctx.lineWidth = this.strokeWidth;\n      this.ctx.lineCap = 'round';\n      this.ctx.lineJoin = 'round';\n\n      // Set white background\n      this.ctx.fillStyle = 'white';\n      this.ctx.fillRect(0, 0, canvas.width, canvas.height);\n    },\n    getEventPos(e) {\n      const canvas = this.$refs.canvas;\n      const rect = canvas.getBoundingClientRect();\n      let clientX, clientY;\n      if (e.touches && e.touches.length > 0) {\n        // Touch event\n        clientX = e.touches[0].clientX;\n        clientY = e.touches[0].clientY;\n      } else {\n        // Mouse event\n        clientX = e.clientX;\n        clientY = e.clientY;\n      }\n      return {\n        x: clientX - rect.left,\n        y: clientY - rect.top\n      };\n    },\n    startDrawing(e) {\n      e.preventDefault();\n      this.isDrawing = true;\n      const pos = this.getEventPos(e);\n      this.lastX = pos.x;\n      this.lastY = pos.y;\n\n      // Start a new path\n      this.ctx.beginPath();\n      this.ctx.moveTo(this.lastX, this.lastY);\n    },\n    draw(e) {\n      if (!this.isDrawing) return;\n      e.preventDefault();\n      const pos = this.getEventPos(e);\n\n      // Draw line from last position to current position\n      this.ctx.lineTo(pos.x, pos.y);\n      this.ctx.stroke();\n      this.lastX = pos.x;\n      this.lastY = pos.y;\n      this.hasSignature = true;\n    },\n    stopDrawing(e) {\n      if (!this.isDrawing) return;\n      e.preventDefault();\n      this.isDrawing = false;\n      this.ctx.beginPath();\n    },\n    clearSignature() {\n      const canvas = this.$refs.canvas;\n      this.ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n      // Reset white background\n      this.ctx.fillStyle = 'white';\n      this.ctx.fillRect(0, 0, canvas.width, canvas.height);\n      this.hasSignature = false;\n      this.$emit('signature-cleared');\n    },\n    saveSignature() {\n      if (!this.hasSignature) return;\n      const canvas = this.$refs.canvas;\n      const signatureData = canvas.toDataURL('image/png');\n      this.$emit('signature-saved', {\n        dataURL: signatureData,\n        blob: this.dataURLToBlob(signatureData)\n      });\n    },\n    dataURLToBlob(dataURL) {\n      const arr = dataURL.split(',');\n      const mime = arr[0].match(/:(.*?);/)[1];\n      const bstr = atob(arr[1]);\n      let n = bstr.length;\n      const u8arr = new Uint8Array(n);\n      while (n--) {\n        u8arr[n] = bstr.charCodeAt(n);\n      }\n      return new Blob([u8arr], {\n        type: mime\n      });\n    },\n    getSignatureData() {\n      if (!this.hasSignature) return null;\n      const canvas = this.$refs.canvas;\n      return {\n        dataURL: canvas.toDataURL('image/png'),\n        blob: this.dataURLToBlob(canvas.toDataURL('image/png'))\n      };\n    }\n  }\n};","map":{"version":3,"names":["name","props","title","type","String","default","width","Number","height","strokeColor","strokeWidth","emits","data","isDrawing","hasSignature","lastX","lastY","ctx","mounted","initCanvas",