: 20px; background: white; margin: 20px;\">\r\n    <h2>Debug User Data</h2>\r\n    \r\n    <div style=\"margin: 20px 0;\">\r\n      <h3>LocalStorage User Data:</h3>\r\n      <pre style=\"background: #f5f5f5; padding: 15px; border-radius: 8px; overflow: auto;\">{{ userData }}</pre>\r\n    </div>\r\n    \r\n    <div style=\"margin: 20px 0;\">\r\n      <h3>Auth Checks:</h3>\r\n      <ul>\r\n        <li>isAdmin(): {{ isAdminCheck }}</li>\r\n        <li>getUserRole(): {{ userRoleCheck }}</li>\r\n        <li>isAuthenticated(): {{ isAuthCheck }}</li>\r\n        <li>canManageUsers(): {{ canManageCheck }}</li>\r\n      </ul>\r\n    </div>\r\n    \r\n    <div style=\"margin: 20px 0;\">\r\n      <button @click=\"refreshData\" style=\"padding: 10px 20px; background: #667eea; color: white; border: none; border-radius: 8px; cursor: pointer;\">\r\n        Refresh Data\r\n      </button>\r\n      \r\n      <button @click=\"fixAdminStatus\" style=\"padding: 10px 20px; background: #f56565; color: white; border: none; border-radius: 8px; cursor: pointer; margin-left: 10px;\">\r\n        Force Admin Status\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { isAdmin, getUserRole, isAuthenticated, canManageUsers } from '../utils/auth';\r\n\r\nexport default {\r\n  name: 'DebugUser',\r\n  data() {\r\n    return {\r\n      userData: null,\r\n      isAdminCheck: false,\r\n      userRoleCheck: '',\r\n      isAuthCheck: false,\r\n      canManageCheck: false\r\n    };\r\n  },\r\n  mounted() {\r\n    this.refreshData();\r\n  },\r\n  methods: {\r\n    refreshData() {\r\n      const userStr = localStorage.getItem('user');\r\n      this.userData = userStr ? JSON.parse(userStr) : null;\r\n      this.isAdminCheck = isAdmin();\r\n      this.userRoleCheck = getUserRole();\r\n      this.isAuthCheck = isAuthenticated();\r\n      this.canManageCheck = canManageUsers();\r\n    },\r\n    fixAdminStatus() {\r\n      const user = JSON.parse(localStorage.getItem('user') || '{}');\r\n      user.is_staff = true;\r\n      if (!user.profile) user.profile = {};\r\n      user.profile.role = 'ADMIN';\r\n      localStorage.setItem('user', JSON.stringify(user));\r\n      alert('Admin status set! Reloading page...');\r\n      setTimeout(() => location.reload(), 1000);\r\n    }\r\n  }\r\n};\r\n</script>\r\n"],"mappings":";;;;;AAgCA,SAASA,OAAO,EAAEC,WAAW,EAAEC,eAAe,EAAEC,cAAa,QAAS,eAAe;AAErF,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAI,WAAJA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,IAAI;MACdC,YAAY,EAAE,KAAK;MACnBC,aAAa,EAAE,EAAE;MACjBC,WAAW,EAAE,KAAK;MAClBC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EACDC,OAAO,WAAPA,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,WAAW,CAAC,CAAC;EACpB,CAAC;EACDC,OAAO,EAAE;IACPD,WAAW,WAAXA,WAAWA,CAAA,EAAG;MACZ,IAAME,OAAM,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM,CAAC;MAC5C,IAAI,CAACV,QAAO,GAAIQ,OAAM,GAAIG,IAAI,CAACC,KAAK,CAACJ,OAAO,IAAI,IAAI;MACpD,IAAI,CAACP,YAAW,GAAIP,OAAO,CAAC,CAAC;MAC7B,IAAI,CAACQ,aAAY,GAAIP,WAAW,CAAC,CAAC;MAClC,IAAI,CAACQ,WAAU,GAAIP,eAAe,CAAC,CAAC;MACpC,IAAI,CAACQ,cAAa,GAAIP,cAAc,CAAC,CAAC;IACxC,CAAC;IACDgB,cAAc,WAAdA,cAAcA,CAAA,EAAG;MACf,IAAMC,IAAG,GAAIH,IAAI,CAACC,KAAK,CAACH,YAAY,CAACC,OAAO,CAAC,MAAM,KAAK,IAAI,CAAC;MAC7DI,IAAI,CAACC,QAAO,GAAI,IAAI;MACpB,IAAI,CAACD,IAAI,CAACE,OAAO,EAAEF,IAAI,CAACE,OAAM,GAAI,CAAC,CAAC;MACpCF,IAAI,CAACE,OAAO,CAACC,IAAG,GAAI,OAAO;MAC3BR,YAAY,CAACS,OAAO,CAAC,MAAM,EAAEP,IAAI,CAACQ,SAAS,CAACL,IAAI,CAAC,CAAC;MAClDM,KAAK,CAAC,qCAAqC,CAAC;MAC5CC,UAAU,CAAC;QAAA,OAAMC,QAAQ,CAACC,MAAM,CAAC,CAAC;MAAA,GAAE,IAAI,CAAC;IAC3C;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}