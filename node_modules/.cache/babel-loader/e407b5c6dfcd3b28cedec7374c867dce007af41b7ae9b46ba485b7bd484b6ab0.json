{"ast":null,"code":"import axios from 'axios';\nimport AppLayout from './AppLayout.vue';\nexport default {\n  name: 'PasswordResetRequests',\n  components: {\n    AppLayout\n  },\n  data() {\n    return {\n      requests: [],\n      selectedRequest: null,\n      loading: false,\n      filters: {\n        status: '',\n        search: ''\n      },\n      stats: {\n        pending: 0,\n        approved: 0,\n        rejected: 0,\n        completed: 0\n      },\n      searchTimeout: null\n    };\n  },\n  created() {\n    this.loadRequests();\n  },\n  methods: {\n    async loadRequests() {\n      this.loading = true;\n      try {\n        const params = {};\n        if (this.filters.status) params.status = this.filters.status;\n        if (this.filters.search) params.search = this.filters.search;\n        const response = await axios.get(`${process.env.VUE_APP_API_URL}/password-reset-requests/`, {\n          params,\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('access_token')}`\n          }\n        });\n        if (Array.isArray(response.data)) {\n          this.requests = response.data;\n        } else if (response.data && Array.isArray(response.data.results)) {\n          this.requests = response.data.results;\n        } else {\n          this.requests = [];\n        }\n        this.calculateStats();\n      } catch (error) {\n        console.error('Error loading requests:', error);\n        this.requests = [];\n        this.calculateStats();\n        alert('Failed to load password reset requests. Please try again.');\n      } finally {\n        this.loading = false;\n      }\n    },\n    calculateStats() {\n      if (!Array.isArray(this.requests)) {\n        this.stats = {\n          pending: 0,\n          approved: 0,\n          rejected: 0,\n          completed: 0\n        };\n        return;\n      }\n      this.stats = {\n        pending: this.requests.filter(r => r.status === 'PENDING').length,\n        approved: this.requests.filter(r => r.status === 'APPROVED').length,\n        rejected: this.requests.filter(r => r.status === 'REJECTED').length,\n        completed: this.requests.filter(r => r.status === 'COMPLETED').length\n      };\n    },\n    debounceSearch() {\n      clearTimeout(this.searchTimeout);\n      this.searchTimeout = setTimeout(() => {\n        this.loadRequests();\n      }, 500);\n    },\n    viewRequest(request) {\n      this.selectedRequest = request;\n    },\n    async approveRequest(request) {\n      if (!confirm(`Approve password reset request for ${request.username}?`)) return;\n      try {\n        console.log('Approving request:', request.id);\n        const response = await axios.patch(`${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`, {\n          status: 'APPROVED'\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('access_token')}`\n          }\n        });\n        console.log('Approve response:', response.data);\n        alert('Request approved successfully');\n        this.selectedRequest = null;\n        this.loadRequests();\n      } catch (error) {\n        console.error('Error approving request:', error);\n        console.error('Error response:', error.response?.data);\n        alert(`Failed to approve request: ${error.response?.data?.detail || error.message}`);\n      }\n    },\n    async rejectRequest(request) {\n      const reason = prompt(`Reject password reset request for ${request.username}?\\n\\nEnter rejection reason (optional):`);\n      if (reason === null) return;\n      try {\n        console.log('Rejecting request:', request.id);\n        const response = await axios.patch(`${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`, {\n          status: 'REJECTED',\n          admin_notes: reason || 'Request rejected'\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('access_token')}`\n          }\n        });\n        console.log('Reject response:', response.data);\n        alert('Request rejected');\n        this.selectedRequest = null;\n        this.loadRequests();\n      } catch (error) {\n        console.error('Error rejecting request:', error);\n        console.error('Error response:', error.response?.data);\n        alert(`Failed to reject request: ${error.response?.data?.detail || error.message}`);\n      }\n    },\n    async completeRequest(request) {\n      if (!confirm(`Mark password reset as completed for ${request.username}?`)) return;\n      try {\n        console.log('Completing request:', request.id);\n        const response = await axios.patch(`${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`, {\n          status: 'COMPLETED'\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('access_token')}`\n          }\n        });\n        console.log('Complete response:', response.data);\n        alert('Request marked as completed');\n        this.selectedRequest = null;\n        this.loadRequests();\n      } catch (error) {\n        console.error('Error completing request:', error);\n        console.error('Error response:', error.response?.data);\n        alert(`Failed to complete request: ${error.response?.data?.detail || error.message}`);\n      }\n    },\n    getStatusClass(status) {\n      if (!status) return 'status-unknown';\n      const statusMap = {\n        'PENDING': 'status-pending',\n        'APPROVED': 'status-approved',\n        'REJECTED': 'status-rejected',\n        'COMPLETED': 'status-completed'\n      };\n      return statusMap[status] || 'status-unknown';\n    },\n    formatDate(dateString) {\n      if (!dateString) return 'N/A';\n      const date = new Date(dateString);\n      return date.toLocaleDateString('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric'\n      });\n    },\n    formatDateTime(dateString) {\n      if (!dateString) return 'N/A';\n      const date = new Date(dateString);\n      return date.toLocaleString('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","AppLayout","name","components","data","requests","selectedRequest","loading","filters","status","search","stats","pending","approved","rejected","completed","searchTimeout","created","loadRequests","methods","params","response","get","process","env","VUE_APP_API_URL","headers","Authorization","localStorage","getItem","Array","isArray","results","calculateStats","error","console","alert","filter","r","length","debounceSearch","clearTimeout","setTimeout","viewRequest","request","approveRequest","confirm","username","log","id","patch","detail","message","rejectRequest","reason","prompt","admin_notes","completeRequest","getStatusClass","statusMap","formatDate","dateString","date","Date","toLocaleDateString","year","month","day","formatDateTime","toLocaleString","hour","minute"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\PasswordResetRequests.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n    <div class=\"password-reset-requests\">\r\n      <!-- Page Header -->\r\n      <div class=\"page-header\">\r\n        <h1>Password Reset Requests</h1>\r\n        <button @click=\"loadRequests\" class=\"btn-primary\" :disabled=\"loading\">\r\n          <i class=\"pi\" :class=\"loading ? 'pi-spin pi-spinner' : 'pi-refresh'\"></i>\r\n          <span>Refresh</span>\r\n        </button>\r\n      </div>\r\n\r\n      <!-- Stats Cards -->\r\n      <div class=\"stats-grid\">\r\n        <div class=\"stat-card\">\r\n          <div class=\"stat-icon orange\">\r\n            <i class=\"pi pi-clock\"></i>\r\n          </div>\r\n          <div class=\"stat-content\">\r\n            <div class=\"stat-value\">{{ stats.pending }}</div>\r\n            <div class=\"stat-label\">Pending</div>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"stat-card\">\r\n          <div class=\"stat-icon green\">\r\n            <i class=\"pi pi-check-circle\"></i>\r\n          </div>\r\n          <div class=\"stat-content\">\r\n            <div class=\"stat-value\">{{ stats.approved }}</div>\r\n            <div class=\"stat-label\">Approved</div>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"stat-card\">\r\n          <div class=\"stat-icon red\">\r\n            <i class=\"pi pi-times-circle\"></i>\r\n          </div>\r\n          <div class=\"stat-content\">\r\n            <div class=\"stat-value\">{{ stats.rejected }}</div>\r\n            <div class=\"stat-label\">Rejected</div>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"stat-card\">\r\n          <div class=\"stat-icon blue\">\r\n            <i class=\"pi pi-check\"></i>\r\n          </div>\r\n          <div class=\"stat-content\">\r\n            <div class=\"stat-value\">{{ stats.completed }}</div>\r\n            <div class=\"stat-label\">Completed</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Filters -->\r\n      <div class=\"filters-section\">\r\n        <div class=\"filter-group\">\r\n          <label>Search</label>\r\n          <input \r\n            type=\"text\" \r\n            v-model=\"filters.search\" \r\n            @input=\"debounceSearch\"\r\n            placeholder=\"Search by username...\"\r\n            class=\"search-input\"\r\n          >\r\n        </div>\r\n        \r\n        <div class=\"filter-group\">\r\n          <label>Status</label>\r\n          <select v-model=\"filters.status\" @change=\"loadRequests\">\r\n            <option value=\"\">All Status</option>\r\n            <option value=\"PENDING\">Pending</option>\r\n            <option value=\"APPROVED\">Approved</option>\r\n            <option value=\"REJECTED\">Rejected</option>\r\n            <option value=\"COMPLETED\">Completed</option>\r\n          </select>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Requests Table -->\r\n      <div class=\"table-container\">\r\n        <div v-if=\"loading\" class=\"loading-state\">\r\n          <i class=\"pi pi-spin pi-spinner\"></i> Loading requests...\r\n        </div>\r\n\r\n        <table v-else-if=\"requests.length > 0\" class=\"requests-table\">\r\n          <thead>\r\n            <tr>\r\n              <th>Username</th>\r\n              <th>Reason</th>\r\n              <th>Status</th>\r\n              <th>Requested</th>\r\n              <th>IP Address</th>\r\n              <th>Actions</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody>\r\n            <tr v-for=\"request in requests\" :key=\"request.id\">\r\n              <td>\r\n                <div class=\"user-info\">\r\n                  <i class=\"pi pi-user\"></i>\r\n                  <span>{{ request.username }}</span>\r\n                </div>\r\n              </td>\r\n              <td>{{ request.reason || 'No reason provided' }}</td>\r\n              <td>\r\n                <span class=\"status-badge\" :class=\"getStatusClass(request.status)\">\r\n                  {{ request.status || 'N/A' }}\r\n                </span>\r\n              </td>\r\n              <td>{{ formatDate(request.created_at) }}</td>\r\n              <td>{{ request.ip_address || 'N/A' }}</td>\r\n              <td>\r\n                <div class=\"action-buttons\">\r\n                  <button @click=\"viewRequest(request)\" class=\"btn-icon btn-view\" title=\"View\">\r\n                    <i class=\"pi pi-eye\"></i>\r\n                  </button>\r\n                  <button \r\n                    v-if=\"request.status === 'PENDING'\"\r\n                    @click=\"approveRequest(request)\" \r\n                    class=\"btn-icon btn-approve\" \r\n                    title=\"Approve\"\r\n                  >\r\n                    <i class=\"pi pi-check\"></i>\r\n                  </button>\r\n                  <button \r\n                    v-if=\"request.status === 'PENDING'\"\r\n                    @click=\"rejectRequest(request)\" \r\n                    class=\"btn-icon btn-reject\" \r\n                    title=\"Reject\"\r\n                  >\r\n                    <i class=\"pi pi-times\"></i>\r\n                  </button>\r\n                  <button \r\n                    v-if=\"request.status === 'APPROVED'\"\r\n                    @click=\"completeRequest(request)\" \r\n                    class=\"btn-icon btn-complete\" \r\n                    title=\"Complete\"\r\n                  >\r\n                    <i class=\"pi pi-check-circle\"></i>\r\n                  </button>\r\n                </div>\r\n              </td>\r\n            </tr>\r\n          </tbody>\r\n        </table>\r\n\r\n        <div v-else class=\"empty-state\">\r\n          <i class=\"pi pi-inbox\"></i>\r\n          <p>No password reset requests found</p>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Detail Modal -->\r\n      <div v-if=\"selectedRequest\" class=\"modal-overlay\" @click.self=\"selectedRequest = null\">\r\n        <div class=\"modal-content\">\r\n          <div class=\"modal-header\">\r\n            <h3>Request Details</h3>\r\n            <button @click=\"selectedRequest = null\" class=\"btn-close\">&times;</button>\r\n          </div>\r\n\r\n          <div class=\"modal-body\">\r\n            <div class=\"detail-grid\">\r\n              <div class=\"detail-item\">\r\n                <label>Username</label>\r\n                <div class=\"detail-value\">\r\n                  <i class=\"pi pi-user\"></i>\r\n                  {{ selectedRequest.username }}\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"detail-item\">\r\n                <label>Status</label>\r\n                <span class=\"status-badge\" :class=\"getStatusClass(selectedRequest.status)\">\r\n                  {{ selectedRequest.status || 'N/A' }}\r\n                </span>\r\n              </div>\r\n              \r\n              <div class=\"detail-item full-width\">\r\n                <label>Reason</label>\r\n                <div class=\"detail-value\">\r\n                  {{ selectedRequest.reason || 'No reason provided' }}\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"detail-item\">\r\n                <label>IP Address</label>\r\n                <div class=\"detail-value\">\r\n                  <i class=\"pi pi-map-marker\"></i>\r\n                  {{ selectedRequest.ip_address || 'N/A' }}\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"detail-item\">\r\n                <label>Requested At</label>\r\n                <div class=\"detail-value\">\r\n                  <i class=\"pi pi-calendar\"></i>\r\n                  {{ formatDateTime(selectedRequest.created_at) }}\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"detail-item\" v-if=\"selectedRequest.processed_by_username\">\r\n                <label>Processed By</label>\r\n                <div class=\"detail-value\">\r\n                  <i class=\"pi pi-user\"></i>\r\n                  {{ selectedRequest.processed_by_username }}\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"detail-item\" v-if=\"selectedRequest.processed_at\">\r\n                <label>Processed At</label>\r\n                <div class=\"detail-value\">\r\n                  <i class=\"pi pi-calendar\"></i>\r\n                  {{ formatDateTime(selectedRequest.processed_at) }}\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"detail-item full-width\" v-if=\"selectedRequest.admin_notes\">\r\n                <label>Admin Notes</label>\r\n                <div class=\"detail-value\">\r\n                  {{ selectedRequest.admin_notes }}\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"modal-actions\">\r\n              <button \r\n                v-if=\"selectedRequest.status === 'PENDING'\"\r\n                @click=\"approveRequest(selectedRequest)\" \r\n                class=\"btn-primary\"\r\n              >\r\n                <i class=\"pi pi-check\"></i>\r\n                Approve Request\r\n              </button>\r\n              <button \r\n                v-if=\"selectedRequest.status === 'PENDING'\"\r\n                @click=\"rejectRequest(selectedRequest)\" \r\n                class=\"btn-danger\"\r\n              >\r\n                <i class=\"pi pi-times\"></i>\r\n                Reject Request\r\n              </button>\r\n              <button \r\n                v-if=\"selectedRequest.status === 'APPROVED'\"\r\n                @click=\"completeRequest(selectedRequest)\" \r\n                class=\"btn-primary\"\r\n              >\r\n                <i class=\"pi pi-check-circle\"></i>\r\n                Mark as Completed\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </AppLayout>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport AppLayout from './AppLayout.vue';\r\n\r\nexport default {\r\n  name: 'PasswordResetRequests',\r\n  components: {\r\n    AppLayout\r\n  },\r\n  data() {\r\n    return {\r\n      requests: [],\r\n      selectedRequest: null,\r\n      loading: false,\r\n      filters: {\r\n        status: '',\r\n        search: ''\r\n      },\r\n      stats: {\r\n        pending: 0,\r\n        approved: 0,\r\n        rejected: 0,\r\n        completed: 0\r\n      },\r\n      searchTimeout: null\r\n    };\r\n  },\r\n  created() {\r\n    this.loadRequests();\r\n  },\r\n  methods: {\r\n    async loadRequests() {\r\n      this.loading = true;\r\n      try {\r\n        const params = {};\r\n        if (this.filters.status) params.status = this.filters.status;\r\n        if (this.filters.search) params.search = this.filters.search;\r\n        \r\n        const response = await axios.get(\r\n          `${process.env.VUE_APP_API_URL}/password-reset-requests/`,\r\n          { \r\n            params,\r\n            headers: { Authorization: `Bearer ${localStorage.getItem('access_token')}` }\r\n          }\r\n        );\r\n        \r\n        if (Array.isArray(response.data)) {\r\n          this.requests = response.data;\r\n        } else if (response.data && Array.isArray(response.data.results)) {\r\n          this.requests = response.data.results;\r\n        } else {\r\n          this.requests = [];\r\n        }\r\n        \r\n        this.calculateStats();\r\n      } catch (error) {\r\n        console.error('Error loading requests:', error);\r\n        this.requests = [];\r\n        this.calculateStats();\r\n        alert('Failed to load password reset requests. Please try again.');\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    \r\n    calculateStats() {\r\n      if (!Array.isArray(this.requests)) {\r\n        this.stats = { pending: 0, approved: 0, rejected: 0, completed: 0 };\r\n        return;\r\n      }\r\n      this.stats = {\r\n        pending: this.requests.filter(r => r.status === 'PENDING').length,\r\n        approved: this.requests.filter(r => r.status === 'APPROVED').length,\r\n        rejected: this.requests.filter(r => r.status === 'REJECTED').length,\r\n        completed: this.requests.filter(r => r.status === 'COMPLETED').length\r\n      };\r\n    },\r\n    \r\n    debounceSearch() {\r\n      clearTimeout(this.searchTimeout);\r\n      this.searchTimeout = setTimeout(() => {\r\n        this.loadRequests();\r\n      }, 500);\r\n    },\r\n    \r\n    viewRequest(request) {\r\n      this.selectedRequest = request;\r\n    },\r\n    \r\n    async approveRequest(request) {\r\n      if (!confirm(`Approve password reset request for ${request.username}?`)) return;\r\n      \r\n      try {\r\n        console.log('Approving request:', request.id);\r\n        const response = await axios.patch(\r\n          `${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`,\r\n          { status: 'APPROVED' },\r\n          { headers: { Authorization: `Bearer ${localStorage.getItem('access_token')}` }}\r\n        );\r\n        \r\n        console.log('Approve response:', response.data);\r\n        alert('Request approved successfully');\r\n        this.selectedRequest = null;\r\n        this.loadRequests();\r\n      } catch (error) {\r\n        console.error('Error approving request:', error);\r\n        console.error('Error response:', error.response?.data);\r\n        alert(`Failed to approve request: ${error.response?.data?.detail || error.message}`);\r\n      }\r\n    },\r\n    \r\n    async rejectRequest(request) {\r\n      const reason = prompt(`Reject password reset request for ${request.username}?\\n\\nEnter rejection reason (optional):`);\r\n      if (reason === null) return;\r\n      \r\n      try {\r\n        console.log('Rejecting request:', request.id);\r\n        const response = await axios.patch(\r\n          `${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`,\r\n          { \r\n            status: 'REJECTED',\r\n            admin_notes: reason || 'Request rejected'\r\n          },\r\n          { headers: { Authorization: `Bearer ${localStorage.getItem('access_token')}` }}\r\n        );\r\n        \r\n        console.log('Reject response:', response.data);\r\n        alert('Request rejected');\r\n        this.selectedRequest = null;\r\n        this.loadRequests();\r\n      } catch (error) {\r\n        console.error('Error rejecting request:', error);\r\n        console.error('Error response:', error.response?.data);\r\n        alert(`Failed to reject request: ${error.response?.data?.detail || error.message}`);\r\n      }\r\n    },\r\n    \r\n    async completeRequest(request) {\r\n      if (!confirm(`Mark password reset as completed for ${request.username}?`)) return;\r\n      \r\n      try {\r\n        console.log('Completing request:', request.id);\r\n        const response = await axios.patch(\r\n          `${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`,\r\n          { status: 'COMPLETED' },\r\n          { headers: { Authorization: `Bearer ${localStorage.getItem('access_token')}` }}\r\n        );\r\n        \r\n        console.log('Complete response:', response.data);\r\n        alert('Request marked as completed');\r\n        this.selectedRequest = null;\r\n        this.loadRequests();\r\n      } catch (error) {\r\n        console.error('Error completing request:', error);\r\n        console.error('Error response:', error.response?.data);\r\n        alert(`Failed to complete request: ${error.response?.data?.detail || error.message}`);\r\n      }\r\n    },\r\n    \r\n    getStatusClass(status) {\r\n      if (!status) return 'status-unknown';\r\n      const statusMap = {\r\n        'PENDING': 'status-pending',\r\n        'APPROVED': 'status-approved',\r\n        'REJECTED': 'status-rejected',\r\n        'COMPLETED': 'status-completed'\r\n      };\r\n      return statusMap[status] || 'status-unknown';\r\n    },\r\n    \r\n    formatDate(dateString) {\r\n      if (!dateString) return 'N/A';\r\n      const date = new Date(dateString);\r\n      return date.toLocaleDateString('en-US', { \r\n        year: 'numeric', \r\n        month: 'short', \r\n        day: 'numeric' \r\n      });\r\n    },\r\n    \r\n    formatDateTime(dateString) {\r\n      if (!dateString) return 'N/A';\r\n      const date = new Date(dateString);\r\n      return date.toLocaleString('en-US', { \r\n        year: 'numeric', \r\n        month: 'short', \r\n        day: 'numeric',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.password-reset-requests {\r\n  padding: 20px;\r\n}\r\n\r\n.page-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.page-header h1 {\r\n  font-size: 28px;\r\n  font-weight: 700;\r\n  color: #1e293b;\r\n  margin: 0;\r\n}\r\n\r\n.stats-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 20px;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n@media (max-width: 1200px) {\r\n  .stats-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n.stat-card {\r\n  background: white;\r\n  border-radius: 12px;\r\n  padding: 20px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 15px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);\r\n  transition: transform 0.3s ease;\r\n}\r\n\r\n.stat-card:hover {\r\n  transform: translateY(-4px);\r\n}\r\n\r\n.stat-icon {\r\n  width: 50px;\r\n  height: 50px;\r\n  border-radius: 10px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 22px;\r\n  color: white;\r\n}\r\n\r\n.stat-icon.blue { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }\r\n.stat-icon.green { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }\r\n.stat-icon.orange { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }\r\n.stat-icon.red { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }\r\n\r\n.stat-value {\r\n  font-size: 28px;\r\n  font-weight: 700;\r\n  color: #1e293b;\r\n}\r\n\r\n.stat-label {\r\n  font-size: 13px;\r\n  color: #64748b;\r\n}\r\n\r\n.filters-section {\r\n  display: grid;\r\n  grid-template-columns: 2fr 1fr;\r\n  gap: 20px;\r\n  margin-bottom: 20px;\r\n  padding: 20px;\r\n  background: white;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);\r\n}\r\n\r\n.filter-group label {\r\n  display: block;\r\n  margin-bottom: 8px;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: #475569;\r\n}\r\n\r\n.search-input