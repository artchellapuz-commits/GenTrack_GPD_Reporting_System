rs.date_to) params.end_date = _this3.filters.date_to;\n                queryString = new URLSearchParams(params).toString();\n                url = \"http://localhost:8000/api/audit-logs/export/?\".concat(queryString); // Create a temporary link and trigger download\n                link = document.createElement('a');\n                link.href = url;\n                link.download = \"Audit_Logs_\".concat(new Date().toISOString().split('T')[0], \".xlsx\");\n                link.style.display = 'none';\n                document.body.appendChild(link);\n                link.click();\n                document.body.removeChild(link);\n                alert('Audit logs exported successfully!');\n              } catch (error) {\n                console.error('Error exporting audit logs:', error);\n                alert('Failed to export audit logs');\n              }\n            case 1:\n              return _context2.a(2);\n          }\n        }, _callee2);\n      }))();\n    },\n    formatDateTime: function formatDateTime(datetime) {\n      return new Date(datetime).toLocaleString('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit',\n        hour12: true\n      });\n    },\n    getActionClass: function getActionClass(action) {\n      var classes = {\n        'CREATE': 'success',\n        'UPDATE': 'info',\n        'DELETE': 'danger',\n        'UPLOAD': 'primary',\n        'EXPORT': 'secondary',\n        'APPROVE': 'success',\n        'REJECT': 'danger',\n        'LOGIN': 'info',\n        'LOGOUT': 'warning'\n      };\n      return classes[action] || 'secondary';\n    }\n  }\n};","map":{"version":3,"names":["axios","AppLayout","Paginator","name","components","data","logs","loading","filters","action","username","date_from","date_to","currentPage","entriesPerPage","totalEntries","sortField","sortOrder","computed","sortedLogs","_this","_toConsumableArray","sort","a","b","_a$description","_b$description","aVal","bVal","Date","timestamp","user_full_name","toLowerCase","action_display","model_display_name","model_name","description","ip_address","location_display","totalPages","Math","ceil","startEntry","length","endEntry","min","mounted","loadLogs","methods","sortBy","field","getSortIcon","_this2","_asyncToGenerator","_regenerator","m","_callee","params","response","_t","w","_context","p","n","page","page_size","get","v","results","count","console","error","alert","f","onPageChange","event","changeEntriesPerPage","clearFilters","exportLogs","_this3","_callee2","queryString","url","link","_context2","start_date","end_date","URLSearchParams","toString","concat","document","createElement","href","download","toISOString","split","style","display","body","appendChild","click","removeChild","formatDateTime","datetime","toLocaleString","year","month","day","hour","minute","second","hour12","getActionClass","classes"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\AuditLogs.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n  <div class=\"audit-logs-container\">\r\n    <!-- Stats Overview -->\r\n    <div class=\"content-section\">\r\n      <div class=\"stats-grid\">\r\n        <div class=\"stat-card total\">\r\n          <div class=\"stat-icon\"><i class=\"pi pi-list\"></i></div>\r\n          <div class=\"stat-content\">\r\n            <span class=\"stat-label\">Total Activities</span>\r\n            <span class=\"stat-value\">{{ totalEntries.toLocaleString() }}</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"stat-card security\">\r\n          <div class=\"stat-icon\"><i class=\"pi pi-shield\"></i></div>\r\n          <div class=\"stat-content\">\r\n            <span class=\"stat-label\">Security Alerts</span>\r\n            <span class=\"stat-value\">{{ securityAlertsCount }}</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"stat-card success\">\r\n          <div class=\"stat-icon\"><i class=\"pi pi-check-circle\"></i></div>\r\n          <div class=\"stat-content\">\r\n            <span class=\"stat-label\">Success Rate</span>\r\n            <span class=\"stat-value\">{{ successRate }}%</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"stat-card system\">\r\n          <div class=\"stat-icon\"><i class=\"pi pi-server\"></i></div>\r\n          <div class=\"stat-content\">\r\n            <span class=\"stat-label\">System Events</span>\r\n            <span class=\"stat-value\">{{ systemEventsCount }}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Filters -->\r\n    <div class=\"content-section\">\r\n      <div class=\"filters-card glass-panel\">\r\n        <div class=\"filters-grid\">\r\n          <div class=\"filter-group\">\r\n            <label><i class=\"pi pi-tag\"></i> Action Type</label>\r\n            <select v-model=\"filters.action\" class=\"custom-select\">\r\n              <option value=\"\">All Actions</option>\r\n              <optgroup label=\"Authentication\">\r\n                <option value=\"LOGIN\">Login</option>\r\n                <option value=\"LOGOUT\">Logout</option>\r\n                <option value=\"LOGIN_FAILED\">Login Failed</option>\r\n              </optgroup>\r\n              <optgroup label=\"Data Operations\">\r\n                <option value=\"CREATE\">Create</option>\r\n                <option value=\"UPDATE\">Update</option>\r\n                <option value=\"DELETE\">Delete</option>\r\n              </optgroup>\r\n              <optgroup label=\"System\">\r\n                <option value=\"UPLOAD\">Upload</option>\r\n                <option value=\"EXPORT\">Export</option>\r\n                <option value=\"REPORT_GENERATE\">Report Generation</option>\r\n              </optgroup>\r\n            </select>\r\n          </div>\r\n          \r\n          <div class=\"filter-group\">\r\n            <label><i class=\"pi pi-user\"></i> User</label>\r\n            <input type=\"text\" v-model=\"filters.username\" placeholder=\"Search by name...\" class=\"custom-input\">\r\n          </div>\r\n          \r\n          <div class=\"filter-group\">\r\n            <label><i class=\"pi pi-calendar\"></i> Time Range</label>\r\n            <div class=\"date-range-inputs\">\r\n              <input type=\"date\" v-model=\"filters.date_from\" class=\"custom-input small\">\r\n              <span class=\"date-sep\">to</span>\r\n              <input type=\"date\" v-model=\"filters.date_to\" class=\"custom-input small\">\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"filter-actions\">\r\n            <button @click=\"clearFilters\" class=\"btn-action btn-clear\" v-tooltip.top=\"'Reset all filters'\">\r\n              <i class=\"pi pi-refresh\"></i> Reset\r\n            </button>\r\n            <button @click=\"exportLogs\" class=\"btn-action btn-export\">\r\n              <i class=\"pi pi-file-excel\"></i> Export Excel\r\n            </button>\r\n            <button @click=\"loadLogs\" class=\"btn-action btn-search\">\r\n              <i class=\"pi pi-search\"></i> Search Logs\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Audit Logs Table -->\r\n    <div class=\"content-section\">\r\n      <div v-if=\"loading\" class=\"loading-state\">\r\n        <div class=\"loading-spinner\">\r\n          <i class=\"pi pi-spin pi-spinner\"></i>\r\n          <p>Analyzing system logs...</p>\r\n        </div>\r\n      </div>\r\n\r\n      <div v-else-if=\"logs.length === 0\" class=\"empty-state\">\r\n        <div class=\"empty-illustration\">\r\n          <i class=\"pi pi-search-plus\"></i>\r\n        </div>\r\n        <h3>No Activities Found</h3>\r\n        <p>Try adjusting your filters to see more results</p>\r\n      </div>\r\n\r\n      <div v-else class=\"table-wrapper glass-panel\">\r\n        <div class=\"table-header\">\r\n          <div class=\"table-info\">\r\n            Showing <strong>{{ startEntry }}-{{ endEntry }}</strong> of <strong>{{ totalEntries }}</strong> activities\r\n          </div>\r\n          <div class=\"entries-selector\">\r\n            <span>Show</span>\r\n            <select v-model.number=\"entriesPerPage\" @change=\"changeEntriesPerPage\" class=\"entries-dropdown\">\r\n              <option :value=\"10\">10</option>\r\n              <option :value=\"25\">25</option>\r\n              <option :value=\"50\">50</option>\r\n            </select>\r\n            <span>entries</span>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"table-container\">\r\n          <table class=\"audit-table\">\r\n            <thead>\r\n              <tr>\r\n                <th class=\"expand-col\"></th>\r\n                <th class=\"sortable\" @click=\"sortBy('timestamp')\">\r\n                  Timestamp <i :class=\"['pi', getSortIcon('timestamp')]\"></i>\r\n                </th>\r\n                <th class=\"sortable\" @click=\"sortBy('user')\">\r\n                  Initiator <i :class=\"['pi', getSortIcon('user')]\"></i>\r\n                </th>\r\n                <th class=\"sortable\" @click=\"sortBy('action')\">\r\n                  Action <i :class=\"['pi', getSortIcon('action')]\"></i>\r\n                </th>\r\n                <th class=\"sortable\" @click=\"sortBy('model')\">\r\n                  Target <i :class=\"['pi', getSortIcon('model')]\"></i>\r\n                </th>\r\n                <th>Status</th>\r\n                <th>Severity</th>\r\n                <th class=\"sortable\" @click=\"sortBy('ip_address')\">\r\n                  Origin <i :class=\"['pi', getSortIcon('ip_address')]\"></i>\r\n                </th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <template v-for=\"log in sortedLogs\" :key=\"log.id\">\r\n                <tr :class=\"['main-row', { 'expanded': expandedRows.includes(log.id), 'failed-row': !log.success }]\">\r\n                  <td class=\"expand-col\" @click=\"toggleRow(log.id)\">\r\n                    <i :class=\"['pi', expandedRows.includes(log.id) ? 'pi-chevron-down' : 'pi-chevron-right']\"></i>\r\n                  </td>\r\n                  <td class=\"time-col\">\r\n                    <span class=\"date\">{{ formatDate(log.timestamp) }}</span>\r\n                    <span class=\"time\">{{ formatTime(log.timestamp) }}</span>\r\n                  </td>\r\n                  <td>\r\n                    <div class=\"user-cell\">\r\n                      <div class=\"avatar-circle\">{{ (log.user_full_name || 'S').charAt(0) }}</div>\r\n                      <div class=\"user-info\">\r\n                        <span class=\"name\">{{ log.user_full_name || 'System' }}</span>\r\n                        <span class=\"role\">{{ log.category || 'System' }}</span>\r\n                      </div>\r\n                    </div>\r\n                  </td>\r\n                  <td>\r\n                    <span :class=\"['action-chip', getActionClass(log.action)]\">\r\n                      {{ log.action_display || log.action }}\r\n                    </span>\r\n                  </td>\r\n                  <td>\r\n                    <span class=\"target-name\">{{ log.model_display_name || log.model_name || 'System' }}</span>\r\n                  </td>\r\n                  <td>\r\n                    <div :class=\"['status-indicator', log.success ? 'success' : 'failed']\">\r\n                      <i :class=\"['pi', log.success ? 'pi-check-circle' : 'pi-exclamation-circle']\"></i>\r\n                      <span>{{ log.success ? 'Success' : 'Failed' }}</span>\r\n                    </div>\r\n                  </td>\r\n                  <td>\r\n                    <span :class=\"['severity-badge', (log.severity || 'LOW').toLowerCase()]\">\r\n                      {{ log.severity || 'LOW' }}\r\n                    </span>\r\n                  </td>\r\n                  <td>\r\n                    <div class=\"origin-cell\">\r\n                      <span class=\"ip\">{{ log.ip_address || 'Internal' }}</span>\r\n                      <span class=\"loc\" v-tooltip.bottom=\"log.location_display\">\r\n                        <i class=\"pi pi-map-marker\"></i>\r\n                      </span>\r\n                    </div>\r\n                  </td>\r\n                </tr>\r\n                \r\n                <!-- Expanded Details -->\r\n                <tr v-if=\"expandedRows.includes(log.id)\" class=\"detail-row\">\r\n                  <td colspan=\"8\">\r\n                    <div class=\"detail-content\">\r\n                      <div class=\"detail-grid\">\r\n                        <div class=\"detail-item full-width\">\r\n                          <label>Activity Description</label>\r\n                          <p>{{ log.description }}</p>\r\n                        </div>\r\n                        <div class=\"detail-item\">\r\n                          <label>User Agent</label>\r\n                          <p class=\"code-font\">{{ log.user_agent || 'System Service' }}</p>\r\n                        </div>\r\n                        <div class=\"detail-item\">\r\n                          <label>Duration</label>\r\n                          <p>{{ log.duration_ms ? log.duration_ms + 'ms' : 'N/A' }}</p>\r\n                        </div>\r\n                        <div v-if=\"log.request_data && Object.keys(log.request_data).length > 0\" class=\"detail-item full-width\">\r\n                          <label>Request Context</label>\r\n                          <pre class=\"json-display\">{{ formatJSON(log.request_data) }}</pre>\r\n                        </div>\r\n                        <div v-if=\"log.error_message\" class=\"detail-item full-width error-box\">\r\n                          <label>Error Details</label>\r\n                          <p>{{ log.error_message }}</p>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </td>\r\n                </tr>\r\n              </template>\r\n            </tbody>\r\n          </table>\r\n        </div>\r\n\r\n        <Paginator \r\n          :rows=\"entriesPerPage\" \r\n          :totalRecords=\"totalEntries\" \r\n          :first=\"(currentPage - 1) * entriesPerPage\"\r\n          @page=\"onPageChange($event)\"\r\n          template=\"FirstPageLink PrevPageLink PageLinks NextPageLink LastPageLink CurrentPageReport\"\r\n          currentPageReportTemplate=\"{first} to {last} of {totalRecords}\"\r\n          :pageLinkSize=\"5\"\r\n        />\r\n      </div>\r\n    </div>\r\n  </div>\r\n  </AppLayout>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport AppLayout from './AppLayout.vue';\r\nimport Paginator from 'primevue/paginator';\r\n\r\nexport default {\r\n  name: 'AuditLogs',\r\n  components: {\r\n    AppLayout,\r\n    Paginator\r\n  },\r\n  data() {\r\n    return {\r\n      logs: [],\r\n      loading: false,\r\n      filters: {\r\n        action: '',\r\n        username: '',\r\n        date_from: '',\r\n        date_to: ''\r\n      },\r\n      // Pagination\r\n      currentPage: 1,\r\n      entriesPerPage: 10,\r\n      totalEntries: 0,\r\n      // Sorting\r\n      sortField: 'timestamp',\r\n      sortOrder: -1 // -1 for descending, 1 for ascending\r\n    };\r\n  },\r\n  computed: {\r\n    sortedLogs() {\r\n      return [...this.logs].sort((a, b) => {\r\n        let aVal, bVal;\r\n        \r\n        switch(this.sortField) {\r\n          case 'timestamp':\r\n            aVal = new Date(a.timestamp);\r\n            bVal = new Date(b.timestamp);\r\n            break;\r\n          case 'user':\r\n            aVal = (a.user_full_name || 'System').toLowerCase();\r\n            bVal = (b.user_full_name || 'System').toLowerCase();\r\n            break;\r\n          case 'action':\r\n            aVal = (a.action_display || a.action || '').toLowerCase();\r\n            bVal = (b.action_display || b.action || '').toLowerCase();\r\n            break;\r\n          case 'model':\r\n            aVal = (a.model_display_name || a.model_name || '').toLowerCase();\r\n            bVal = (b.model_display_name || b.model_name || '').toLowerCase();\r\n            break;\r\n          case 'description':\r\n            aVal = a.description?.toLowerCase() || '';\r\n            bVal = b.description?.toLowerCase() || '';\r\n            break;\r\n          case 'ip_address':\r\n            aVal = a.ip_address || '';\r\n            bVal = b.ip_address || '';\r\n            break;\r\n          case 'location':\r\n            aVal = (a.location_display || '').toLowerCase();\r\n            bVal = (b.location_display || '').toLowerCase();\r\n            break;\r\n          default:\r\n            return 0;\r\n        }\r\n        \r\n        if (aVal < bVal) return -1 * this.sortOrder;\r\n        if (aVal > bVal) return 1 * this.sortOrder;\r\n        return 0;\r\n      });\r\n    },\r\n    totalPages() {\r\n      return Math.ceil(this.totalEntries / this.entriesPerPage);\r\n    },\r\n    startEntry() {\r\n      return this.logs.length === 0 ? 0 : (this.currentPage - 1) * this.entriesPerPage + 1;\r\n    },\r\n    endEntry() {\r\n      return Math.min(this.currentPage * this.entriesPerPage, this.totalEntries);\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadLogs();\r\n  },\r\n  methods: {\r\n    sortBy(field) {\r\n      if (this.sortField === field) {\r\n        // Toggle sort order if clicking the same field\r\n        this.sortOrder = this.sortOrder * -1;\r\n      } else {\r\n        // Set new field and default to ascending\r\n        this.sortField = field;\r\n        this.sortOrder = 1;\r\n      }\r\n    },\r\n    \r\n    getSortIcon(field) {\r\n      if (this.sortField !== field) {\r\n        return 'pi-sort-alt'; // Neutral sort icon\r\n      }\r\n      return this.sortOrder === 1 ? 'pi-sort-am