ext, $data.formData.email]])]), _createElementVNode(\"div\", _hoisted_13, [_cache[14] || (_cache[14] = _createElementVNode(\"label\", {\n    for: \"password\"\n  }, [_createElementVNode(\"i\", {\n    class: \"pi pi-lock\"\n  }), _createTextVNode(\" Password \")], -1 /* CACHED */)), _createElementVNode(\"div\", _hoisted_14, [_withDirectives(_createElementVNode(\"input\", {\n    id: \"password\",\n    \"onUpdate:modelValue\": _cache[4] || (_cache[4] = $event => $data.formData.password = $event),\n    type: $data.showPassword ? 'text' : 'password',\n    placeholder: \"Create a password\",\n    required: \"\",\n    disabled: $data.loading\n  }, null, 8 /* PROPS */, _hoisted_15), [[_vModelDynamic, $data.formData.password]]), _createElementVNode(\"button\", {\n    type: \"button\",\n    class: \"toggle-password\",\n    onClick: _cache[5] || (_cache[5] = $event => $data.showPassword = !$data.showPassword),\n    disabled: $data.loading\n  }, [_createElementVNode(\"i\", {\n    class: _normalizeClass($data.showPassword ? 'pi pi-eye-slash' : 'pi pi-eye')\n  }, null, 2 /* CLASS */)], 8 /* PROPS */, _hoisted_16)]), _cache[15] || (_cache[15] = _createElementVNode(\"small\", null, \"At least 8 characters\", -1 /* CACHED */))]), _createElementVNode(\"div\", _hoisted_17, [_cache[16] || (_cache[16] = _createElementVNode(\"label\", {\n    for: \"password2\"\n  }, [_createElementVNode(\"i\", {\n    class: \"pi pi-lock\"\n  }), _createTextVNode(\" Confirm Password \")], -1 /* CACHED */)), _createElementVNode(\"div\", _hoisted_18, [_withDirectives(_createElementVNode(\"input\", {\n    id: \"password2\",\n    \"onUpdate:modelValue\": _cache[6] || (_cache[6] = $event => $data.formData.password2 = $event),\n    type: $data.showPassword2 ? 'text' : 'password',\n    placeholder: \"Confirm your password\",\n    required: \"\",\n    disabled: $data.loading\n  }, null, 8 /* PROPS */, _hoisted_19), [[_vModelDynamic, $data.formData.password2]]), _createElementVNode(\"button\", {\n    type: \"butto