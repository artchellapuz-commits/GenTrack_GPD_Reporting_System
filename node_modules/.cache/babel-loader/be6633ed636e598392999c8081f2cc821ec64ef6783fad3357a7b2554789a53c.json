\n        return date.toLocaleDateString('en-US', {\n          year: 'numeric',\n          month: 'long',\n          day: 'numeric',\n          hour: '2-digit',\n          minute: '2-digit'\n        });\n      } catch (error) {\n        return 'Invalid date';\n      }\n    },\n    retryLoad: function retryLoad() {\n      var _this5 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee5() {\n        var _t4;\n        return _regenerator().w(function (_context5) {\n          while (1) switch (_context5.p = _context5.n) {\n            case 0:\n              _this5.error = null;\n              _this5.loading = true;\n              _context5.p = 1;\n              _context5.n = 2;\n              return _this5.loadUserInfo();\n            case 2:\n              _context5.n = 3;\n              return _this5.loadCurrentSignature();\n            case 3:\n              _context5.n = 5;\n              break;\n            case 4:\n              _context5.p = 4;\n              _t4 = _context5.v;\n              console.error('Error retrying load:', _t4);\n              _this5.error = 'Failed to load signature management';\n            case 5:\n              _context5.p = 5;\n              _this5.loading = false;\n              return _context5.f(5);\n            case 6:\n              return _context5.a(2);\n          }\n        }, _callee5, null, [[1, 4, 5, 6]]);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["AppLayout","SignaturePad","api","getUser","toast","require","error","console","warn","success","msg","log","name","components","data","currentSignature","userInfo","isEditing","hasNewSignature","saving","newSignatureData","loading","mounted","_this","_asyncToGenerator","_regenerator","m","_callee","_t","w","_context","p","n","loadUserInfo","loadCurrentSignature","v","f","a","methods","_this2","_callee2","user","_context2","username","_this3","_callee3","response","_t2","_context3","getCurrentUserSignature","signature_image","_objectSpread","editSignature","cancelEdit","$refs","signaturePad","clearSignature","onSignatureSaved","signatureData","onSignatureCleared","saveSignature","_this4","_callee4","formData","_error$response","errorMsg","_t3","_context4","FormData","append","blob","saveUserSignature","message","formatDate","dateString","date","Date","toLocaleDateString","year","month","day","hour","minute","retryLoad","_this5","_callee5","_t4","_context5"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\SignatureManagement.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n    <div class=\"signature-management-page glass-background\">\r\n      <!-- Loading State -->\r\n      <div v-if=\"loading\" class=\"loading-container\">\r\n        <div class=\"loading-spinner\">\r\n          <i class=\"pi pi-spin pi-spinner\"></i>\r\n        </div>\r\n        <p>Loading signature management...</p>\r\n      </div>\r\n\r\n      <!-- Error State -->\r\n      <div v-else-if=\"error\" class=\"error-container\">\r\n        <div class=\"error-message\">\r\n          <i class=\"pi pi-exclamation-triangle\"></i>\r\n          <h3>Error Loading Signature Management</h3>\r\n          <p>{{ error }}</p>\r\n          <button @click=\"retryLoad\" class=\"btn-retry\">\r\n            <i class=\"pi pi-refresh\"></i>\r\n            Retry\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Main Content -->\r\n      <div v-else>\r\n        <!-- Page Header -->\r\n        <div class=\"page-header\">\r\n          <h2 class=\"page-title\">Digital Signature Management</h2>\r\n          <p class=\"page-description\">\r\n            Create and manage your digital signature for PSR reports\r\n          </p>\r\n        </div>\r\n\r\n        <!-- Current Signature Display -->\r\n        <div v-if=\"currentSignature\" class=\"card glass-card glass-fade-in\">\r\n          <div class=\"card-header\">\r\n            <h3 class=\"card-title\">\r\n              <i class=\"pi pi-check-circle\"></i>\r\n              Current Signature\r\n            </h3>\r\n            <button @click=\"editSignature\" class=\"btn-edit\">\r\n              <i class=\"pi pi-pencil\"></i>\r\n              Edit Signature\r\n            </button>\r\n          </div>\r\n          <div class=\"card-body\">\r\n            <div class=\"current-signature-display\">\r\n              <img :src=\"currentSignature\" alt=\"Current Signature\" class=\"signature-image\" />\r\n              <div class=\"signature-info\">\r\n                <p class=\"signature-owner\">{{ userInfo.full_name || userInfo.username }}</p>\r\n                <p class=\"signature-position\">{{ userInfo.position || 'Position not set' }}</p>\r\n                <p class=\"signature-date\">\r\n                  <i class=\"pi pi-calendar\"></i>\r\n                  Last updated: {{ formatDate(userInfo.signature_updated) }}\r\n                </p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Signature Creation/Edit -->\r\n        <div v-if=\"!currentSignature || isEditing\" class=\"card glass-card glass-fade-in\">\r\n          <div class=\"card-header\">\r\n            <h3 class=\"card-title\">\r\n              <i class=\"pi pi-pencil\"></i>\r\n              {{ currentSignature ? 'Update' : 'Create' }} Your Digital Signature\r\n            </h3>\r\n            <button v-if=\"isEditing\" @click=\"cancelEdit\" class=\"btn-cancel\">\r\n              <i class=\"pi pi-times\"></i>\r\n              Cancel\r\n            </button>\r\n          </div>\r\n          <div class=\"card-body\">\r\n            <div class=\"signature-creation-section\">\r\n              <SignaturePad\r\n                ref=\"signaturePad\"\r\n                :title=\"`Signature for ${userInfo.full_name || userInfo.username}`\"\r\n                :width=\"500\"\r\n                :height=\"200\"\r\n                @signature-saved=\"onSignatureSaved\"\r\n                @signature-cleared=\"onSignatureCleared\"\r\n              />\r\n              \r\n              <div class=\"signature-actions\">\r\n                <button \r\n                  @click=\"saveSignature\" \r\n                  :disabled=\"!hasNewSignature || saving\"\r\n                  class=\"btn-save-signature\"\r\n                >\r\n                  <i v-if=\"!saving\" class=\"pi pi-save\"></i>\r\n                  <i v-else class=\"pi pi-spin pi-spinner\"></i>\r\n                  <span>{{ saving ? 'Saving...' : (currentSignature ? 'Update Signature' : 'Save Signature') }}</span>\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Instructions -->\r\n        <div class=\"card glass-card glass-fade-in\">\r\n          <div class=\"card-header\">\r\n            <h3 class=\"card-title\">\r\n              <i class=\"pi pi-info-circle\"></i>\r\n              How to Use Digital Signatures\r\n            </h3>\r\n          </div>\r\n          <div class=\"card-body\">\r\n            <div class=\"instructions-grid\">\r\n              <div class=\"instruction-item\">\r\n                <div class=\"instruction-icon\">\r\n                  <i class=\"pi pi-pencil\"></i>\r\n                </div>\r\n                <div class=\"instruction-content\">\r\n                  <h4>1. Draw Your Signature</h4>\r\n                  <p>Use your mouse or touch screen to draw your signature in the signature pad above.</p>\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"instruction-item\">\r\n                <div class=\"instruction-icon\">\r\n                  <i class=\"pi pi-save\"></i>\r\n                </div>\r\n                <div class=\"instruction-content\">\r\n                  <h4>2. Save Your Signature</h4>\r\n                  <p>Click \"Save Signature\" to store your digital signature securely in the system.</p>\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"instruction-item\">\r\n                <div class=\"instruction-icon\">\r\n                  <i class=\"pi pi-file-excel\"></i>\r\n                </div>\r\n                <div class=\"instruction-content\">\r\n                  <h4>3. Automatic Integration</h4>\r\n                  <p>Your signature will automatically appear in PSR reports when you generate them.</p>\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"instruction-item\">\r\n                <div class=\"instruction-icon\">\r\n                  <i class=\"pi pi-shield\"></i>\r\n                </div>\r\n                <div class=\"instruction-content\">\r\n                  <h4>4. Secure & Legal</h4>\r\n                  <p>Your signature is encrypted and stored securely, providing legal authenticity to reports.</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </AppLayout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from './AppLayout.vue';\r\nimport SignaturePad from './SignaturePad.vue';\r\nimport api from '../services/api';\r\nimport { getUser } from '../utils/auth';\r\n\r\n// Import toast utility with fallback\r\nlet toast;\r\ntry {\r\n  toast = require('../utils/toast').default;\r\n} catch (error) {\r\n  console.warn('Toast utility not available:', error);\r\n  toast = {\r\n    success: (msg) => console.log('SUCCESS:', msg),\r\n    error: (msg) => console.error('ERROR:', msg)\r\n  };\r\n}\r\n\r\nexport default {\r\n  name: 'SignatureManagement',\r\n  components: {\r\n    AppLayout,\r\n    SignaturePad\r\n  },\r\n  data() {\r\n    return {\r\n      currentSignature: null,\r\n      userInfo: {},\r\n      isEditing: false,\r\n      hasNewSignature: false,\r\n      saving: false,\r\n      newSignatureData: null,\r\n      loading: true,\r\n      error: null\r\n    };\r\n  },\r\n  async mounted() {\r\n    try {\r\n      this.loading = true;\r\n      await this.loadUserInfo();\r\n      await this.loadCurrentSignature();\r\n    } catch (error) {\r\n      console.error('Error initializing component:', error);\r\n      this.error = 'Failed to load signature management';\r\n    } finally {\r\n      this.loading = false;\r\n    }\r\n  },\r\n  methods: {\r\n    async loadUserInfo() {\r\n      try {\r\n        const user = getUser();\r\n        if (user) {\r\n          this.userInfo = user;\r\n        } else {\r\n          console.warn('No user data found');\r\n          this.userInfo = { username: 'Unknown User' };\r\n        }\r\n      } catch (error) {\r\n        console.error('Error loading user info:', error);\r\n        this.userInfo = { username: 'Unknown User' };\r\n      }\r\n    },\r\n    \r\n    async loadCurrentSignature() {\r\n      try {\r\n        const response = await api.getCurrentUserSignature();\r\n        if (response.data && response.data.signature_image) {\r\n          this.currentSignature = response.data.signature_image;\r\n          this.userInfo = { ...this.userInfo, ...response.data };\r\n        }\r\n      } catch (error) {\r\n        console.error('Error loading current signature:', error);\r\n        // Don't show error toast for missing signature - it's normal for new users\r\n        // Just continue with no signature\r\n        this.currentSignature = null;\r\n      }\r\n    },\r\n    \r\n    editSignature() {\r\n      this.isEditing = true;\r\n    },\r\n    \r\n    cancelEdit() {\r\n      this.isEditing = false;\r\n      this.hasNewSignature = false;\r\n      this.newSignatureData = null;\r\n      \r\n      // Clear the signature pad\r\n      if (this.$refs.signaturePad) {\r\n        this.$refs.signaturePad.clearSignature();\r\n      }\r\n    },\r\n    \r\n    onSignatureSaved(signatureData) {\r\n      this.hasNewSignature = true;\r\n      this.newSignatureData = signatureData;\r\n    },\r\n    \r\n    onSignatureCleared() {\r\n      this.hasNewSignature = false;\r\n      this.newSignatureData = null;\r\n    },\r\n    \r\n    async saveSignature() {\r\n      if (!this.hasNewSignature || !this.newSignatureData) {\r\n        toast.error('Please draw your signature first');\r\n        return;\r\n      }\r\n      \r\n      this.saving = true;\r\n      \r\n      try {\r\n        // Create FormData to send the signature image\r\n        const formData = new FormData();\r\n        formData.append('signature_image', this.newSignatureData.blob, 'signature.png');\r\n        \r\n        const response = await api.saveUserSignature(formData);\r\n        \r\n        this.currentSignature = response.data.signature_image;\r\n        this.isEditing = false;\r\n        this.hasNewSignature = false;\r\n        this.newSignatureData = null;\r\n        \r\n        toast.success('Signature saved successfully!');\r\n        \r\n        // Update user info\r\n        this.userInfo = { ...this.userInfo, ...response.data };\r\n        \r\n      } catch (error) {\r\n        console.error('Error saving signature:', error);\r\n        let errorMsg = 'Failed to save signature';\r\n        \r\n        if (error.response?.data?.error) {\r\n          errorMsg = error.response.data.error;\r\n        } else if (error.message) {\r\n          errorMsg = error.message;\r\n        }\r\n        \r\n        toast.error(errorMsg);\r\n      } finally {\r\n        this.saving = false;\r\n      }\r\n    },\r\n    \r\n    formatDate(dateString) {\r\n      if (!dateString) return 'Not available';\r\n      \r\n      try {\r\n        const date = new Date(dateString);\r\n        return date.toLocaleDateString('en-US', {\r\n          year: 'numeric',\r\n          month: 'long',\r\n          day: 'numeric',\r\n          hour: '2-digit',\r\n          minute: '2-digit'\r\n        });\r\n      } catch (error) {\r\n        return 'Invalid date';\r\n      }\r\n    },\r\n\r\n    async retryLoad() {\r\n      this.error = null;\r\n      this.loading = true;\r\n      try {\r\n        await this.loadUserInfo();\r\n        await this.loadCurrentSignature();\r\n      } catch (error) {\r\n        console.error('Error retrying load:', error);\r\n        this.error = 'Failed to load signature management';\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.signature-management-page {\r\n  max-width: 900px;\r\n  margin: 0 auto;\r\n}\r\n\r\n/* Header */\r\n.page-header {\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n.page-title {\r\n  font-size: 1.75rem;\r\n  font-weight: 600;\r\n  color: #1a202c;\r\n  margin: 0 0 0.5rem 0;\r\n  letter-spacing: -0.025em;\r\n}\r\n\r\n.page-description {\r\n  color: #718096;\r\n  font-size: 0.9375rem;\r\n  margin: 0;\r\n}\r\n\r\n/* Card Headers */\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 1.5rem;\r\n  border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.card-title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  font-size: 1.125rem;\r\n  font-weight: 600;\r\n  color: #2d3748;\r\n  margin: 0;\r\n}\r\n\r\n.card-title i {\r\n  color: var(--npc-primary);\r\n  font-size: 1.25rem;\r\n}\r\n\r\n/* Buttons */\r\n.btn-edit,\r\n.btn-cancel {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  padding: 0.5rem 1rem;\r\n  border: 1px solid;\r\n  border-radius: 0.375rem;\r\n  font-size: 0.875rem;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.btn-edit {\r\n  background: var(--npc-primary);\r\n  color: white;\r\n  border-color: var(--npc-primary);\r\n}\r\n\r\n.btn-edit:hover {\r\n  background: #004a9f;\r\n  border-color: #004a9f;\r\n}\r\n\r\n.btn-cancel {\r\n  background: white;\r\n  color: #ef4444;\r\n  border-color: #ef4444;\r\n}\r\n\r\n.btn-cancel:hover {\r\n  background: #ef4444;\r\n  color: white;\r\n}\r\n\r\n/* Current Signature Display */\r\n.current-s