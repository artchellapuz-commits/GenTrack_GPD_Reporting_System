{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.number.constructor.js\";\nimport Skeleton from 'primevue/skeleton';\n\n/**\n * Skeleton variants mirror common NPC Reporting layouts (glass cards, tables, forms).\n * Pair with `isLoading` from your fetch logic and `ContentSkeleton` for enter transitions.\n */\nexport default {\n  name: 'AppSkeleton',\n  components: {\n    Skeleton: Skeleton\n  },\n  props: {\n    type: {\n      type: String,\n      \"default\": 'card',\n      validator: function validator(value) {\n        return ['table', 'card', 'form', 'chart', 'list'].includes(value);\n      }\n    },\n    /** Table body rows & list row count */\n    rows: {\n      type: Number,\n      \"default\": 5\n    },\n    /** Table columns */\n    cols: {\n      type: Number,\n      \"default\": 4\n    },\n    /** Card count or number of form field groups */\n    count: {\n      type: Number,\n      \"default\": 1\n    },\n    /** CSS height for chart skeleton, e.g. '280px' */\n    chartHeight: {\n      type: String,\n      \"default\": '260px'\n    }\n  }\n};","map":{"version":3,"names":["Skeleton","name","components","props","type","String","validator","value","includes","rows","Number","cols","count","chartHeight"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\common\\AppSkeleton.vue"],"sourcesContent":["<template>\n  <!--\n    Reusable skeleton layouts using PrimeVue Skeleton + Tailwind.\n    Props:\n      type: 'table' | 'card' | 'form' | 'chart' | 'list'\n      rows, cols: table + list row counts\n      count: cards or form fields\n      chartHeight: CSS height for chart placeholder\n  -->\n  <div\n    class=\"w-full animate-skeleton-enter\"\n    :class=\"[type + '-skeleton']\"\n    data-testid=\"app-skeleton\"\n  >\n    <!-- TABLE -->\n    <div\n      v-if=\"type === 'table'\"\n      class=\"rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900\"\n    >\n      <div class=\"mb-6 flex flex-wrap items-center justify-between gap-3\">\n        <Skeleton width=\"200px\" height=\"24px\" borderRadius=\"6px\" />\n        <div class=\"flex gap-2\">\n          <Skeleton width=\"40px\" height=\"32px\" borderRadius=\"8px\" />\n          <Skeleton width=\"120px\" height=\"32px\" borderRadius=\"8px\" />\n        </div>\n      </div>\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full border-separate border-spacing-0\">\n          <thead>\n            <tr>\n              <th\n                v-for=\"i in cols\"\n                :key=\"'th-' + i\"\n                class=\"border-b border-slate-100 bg-slate-50 px-4 py-3 text-left first:rounded-tl-lg last:rounded-tr-lg dark:border-slate-700 dark:bg-slate-800\"\n              >\n                <Skeleton width=\"80%\" height=\"20px\" borderRadius=\"4px\" />\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr v-for=\"r in rows\" :key=\"'tr-' + r\">\n              <td\n                v-for=\"c in cols\"\n                :key=\"'td-' + c\"\n                class=\"border-b border-slate-100 px-4 py-3 dark:border-slate-800\"\n              >\n                <Skeleton width=\"100%\" height=\"24px\" borderRadius=\"4px\" />\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- CARD / DASHBOARD GRID -->\n    <div\n      v-else-if=\"type === 'card'\"\n      class=\"grid w-full grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-[repeat(auto-fill,minmax(280px,1fr))]\"\n    >\n      <div\n        v-for=\"i in count\"\n        :key=\"'card-' + i\"\n        class=\"rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900\"\n      >\n        <div class=\"mb-6 flex items-center\">\n          <Skeleton shape=\"circle\" size=\"3rem\" class=\"mr-3 shrink-0\" />\n          <div class=\"min-w-0 flex-1\">\n            <div class=\"mb-2\">\n              <Skeleton width=\"60%\" height=\"16px\" borderRadius=\"4px\" />\n            </div>\n            <Skeleton width=\"40%\" height=\"12px\" borderRadius=\"4px\" />\n          </div>\n        </div>\n        <div class=\"mb-6\">\n          <Skeleton width=\"100%\" height=\"120px\" borderRadius=\"12px\" />\n        </div>\n        <div class=\"flex justify-end gap-3 border-t border-slate-100 pt-4 dark:border-slate-800\">\n          <Skeleton width=\"100px\" height=\"32px\" borderRadius=\"8px\" />\n          <Skeleton width=\"100px\" height=\"32px\" borderRadius=\"8px\" />\n        </div>\n      </div>\n    </div>\n\n    <!-- FORM FIELDS -->\n    <div\n      v-else-if=\"type === 'form'\"\n      class=\"mx-auto w-full max-w-3xl rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-700 dark:bg-slate-900\"\n    >\n      <div class=\"mb-8 border-b border-slate-100 pb-6 dark:border-slate-800\">\n        <div class=\"mb-2\">\n          <Skeleton width=\"150px\" height=\"28px\" borderRadius=\"6px\" />\n        </div>\n        <Skeleton width=\"250px\" height=\"14px\" borderRadius=\"4px\" />\n      </div>\n      <div class=\"flex flex-col gap-6\">\n        <div v-for=\"i in count\" :key=\"'field-' + i\" class=\"flex flex-col\">\n          <div class=\"mb-2\">\n            <Skeleton width=\"100px\" height=\"16px\" borderRadius=\"4px\" />\n          </div>\n          <Skeleton width=\"100%\" height=\"48px\" borderRadius=\"8px\" />\n        </div>\n        <div class=\"mt-2 flex justify-start\">\n          <Skeleton width=\"140px\" height=\"48px\" borderRadius=\"8px\" />\n        </div>\n      </div>\n    </div>\n\n    <!-- CHART -->\n    <div v-else-if=\"type === 'chart'\" class=\"w-full min-h-[120px]\">\n      <Skeleton width=\"100%\" :height=\"chartHeight\" borderRadius=\"12px\" />\n    </div>\n\n    <!-- COMPACT LIST (search, menus) -->\n    <div v-else-if=\"type === 'list'\" class=\"flex w-full flex-col gap-4 py-2\">\n      <div v-for=\"i in rows\" :key=\"'list-' + i\" class=\"flex items-center gap-3\">\n        <Skeleton shape=\"circle\" size=\"2.25rem\" class=\"shrink-0\" />\n        <div class=\"min-w-0 flex-1\">\n          <div class=\"mb-2\">\n            <Skeleton width=\"70%\" height=\"16px\" borderRadius=\"4px\" />\n          </div>\n          <Skeleton width=\"45%\" height=\"12px\" borderRadius=\"4px\" />\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport Skeleton from 'primevue/skeleton';\n\n/**\n * Skeleton variants mirror common NPC Reporting layouts (glass cards, tables, forms).\n * Pair with `isLoading` from your fetch logic and `ContentSkeleton` for enter transitions.\n */\nexport default {\n  name: 'AppSkeleton',\n  components: { Skeleton },\n  props: {\n    type: {\n      type: String,\n      default: 'card',\n      validator: (value) =>\n        ['table', 'card', 'form', 'chart', 'list'].includes(value),\n    },\n    /** Table body rows & list row count */\n    rows: {\n      type: Number,\n      default: 5,\n    },\n    /** Table columns */\n    cols: {\n      type: Number,\n      default: 4,\n    },\n    /** Card count or number of form field groups */\n    count: {\n      type: Number,\n      default: 1,\n    },\n    /** CSS height for chart skeleton, e.g. '280px' */\n    chartHeight: {\n      type: String,\n      default: '260px',\n    },\n  },\n};\n</script>\n"],"mappings":";;AAgIA,OAAOA,QAAO,MAAO,mBAAmB;;AAExC;;;;AAIA,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IAAEF,QAAO,EAAPA;EAAS,CAAC;EACxBG,KAAK,EAAE;IACLC,IAAI,EAAE;MACJA,IAAI,EAAEC,MAAM;MACZ,WAAS,MAAM;MACfC,SAAS,EAAE,SAAXA,SAASA,CAAGC,KAAK;QAAA,OACf,CAAC,OAAO,EAAE,MAAM,EAAE,MAAM,EAAE,OAAO,EAAE,MAAM,CAAC,CAACC,QAAQ,CAACD,KAAK,CAAC;MAAA;IAC9D,CAAC;IACD;IACAE,IAAI,EAAE;MACJL,IAAI,EAAEM,MAAM;MACZ,WAAS;IACX,CAAC;IACD;IACAC,IAAI,EAAE;MACJP,IAAI,EAAEM,MAAM;MACZ,WAAS;IACX,CAAC;IACD;IACAE,KAAK,EAAE;MACLR,IAAI,EAAEM,MAAM;MACZ,WAAS;IACX,CAAC;IACD;IACAG,WAAW,EAAE;MACXT,