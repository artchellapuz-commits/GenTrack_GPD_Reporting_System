{"ast":null,"code":"export default {\n  name: 'App'\n};","map":{"version":3,"names":["name"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\App.vue"],"sourcesContent":["<template>\r\n  <div id=\"app\">\r\n    <!-- Header -->\r\n    <header class=\"app-header\">\r\n      <div class=\"container\">\r\n        <div class=\"header-content\">\r\n          <div class=\"logo-section\">\r\n            <img src=\"@/assets/NPC-logo.png\" alt=\"NPC Logo\" class=\"logo-image\" />\r\n            <div class=\"logo-text\">\r\n              <h1 class=\"logo-title\">NPC Reporting System</h1>\r\n              <p class=\"logo-subtitle\">Agus-Pulangi Hydro-Electric Power Plants</p>\r\n            </div>\r\n          </div>\r\n          <nav class=\"main-nav\">\r\n            <router-link to=\"/upload\" class=\"nav-link\">\r\n              <i class=\"pi pi-upload nav-icon\"></i>\r\n              Upload\r\n            </router-link>\r\n            <router-link to=\"/reports\" class=\"nav-link\">\r\n              <i class=\"pi pi-chart-line nav-icon\"></i>\r\n              Reports\r\n            </router-link>\r\n            <router-link to=\"/generate\" class=\"nav-link\">\r\n              <i class=\"pi pi-download nav-icon\"></i>\r\n              Generate\r\n            </router-link>\r\n          </nav>\r\n        </div>\r\n      </div>\r\n    </header>\r\n\r\n    <!-- Main Content -->\r\n    <main class=\"app-main\">\r\n      <div class=\"container\">\r\n        <router-view />\r\n      </div>\r\n    </main>\r\n\r\n    <!-- Footer -->\r\n    <footer class=\"app-footer\">\r\n      <div class=\"container\">\r\n        <div class=\"footer-content\">\r\n          <p class=\"footer-text\">\r\n            © 2026 National Power Corporation. All rights reserved.\r\n          </p>\r\n          <p class=\"footer-links\">\r\n            <a href=\"#\" class=\"footer-link\">Help</a>\r\n            <span class=\"footer-separator\">•</span>\r\n          