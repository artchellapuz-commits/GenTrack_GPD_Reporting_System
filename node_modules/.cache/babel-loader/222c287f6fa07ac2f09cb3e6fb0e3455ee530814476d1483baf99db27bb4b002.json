Everything you need for professional power plant reporting</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Features Grid -->\r\n    <div class=\"features-container\">\r\n      <div \r\n        v-for=\"(feature, index) in features\" \r\n        :key=\"index\"\r\n        class=\"feature-card-glass\"\r\n        :style=\"{ animationDelay: `${index * 0.1}s` }\"\r\n        @mouseenter=\"activeFeature = index\"\r\n        @mouseleave=\"activeFeature = null\"\r\n      >\r\n        <div class=\"feature-glow\" :class=\"{ active: activeFeature === index }\"></div>\r\n        \r\n        <div class=\"feature-icon-container\">\r\n          <div class=\"icon-bg\"></div>\r\n          <i :class=\"feature.icon\" class=\"feature-icon\"></i>\r\n          <div class=\"icon-pulse\"></div>\r\n        </div>\r\n\r\n        <div class=\"feature-content\">\r\n          <h2>{{ feature.title }}</h2>\r\n          <p>{{ feature.description }}</p>\r\n          \r\n          <div class=\"feature-benefits\">\r\n            <div v-for=\"(benefit, idx) in feature.benefits\" :key=\"idx\" class=\"benefit-item\">\r\n              <i class=\"pi pi-check-circle\"></i>\r\n              <span>{{ benefit }}</span>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"feature-stats\">\r\n            <div class=\"stat-item\">\r\n              <span class=\"stat-value\">{{ feature.stat }}</span>\r\n              <span class=\"stat-label\">{{ feature.statLabel }}</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"feature-corner\"></div>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'Features',\r\n  data() {\r\n    return {\r\n      activeFeature: null,\r\n      features: [\r\n        {\r\n          icon: 'pi pi-chart-line',\r\n          title: 'Real-time Dashboard',\r\n          description: 'Monitor all power plants at a glance with live data visualization and instant updates.',\r\n          benefits: [\r\n            'Live data streaming',\r\n            'Instant notifications',\r\n            'Customizable widgets'\r\n          ],\r\n          stat: '24/7',\r\n          statLabel: 'Monitoring'\r\n        },\r\n        {\r\n          icon: 'pi pi-upload',\r\n          title: 'Easy Excel Upload',\r\n          description: 'Import daily reports seamlessly with automatic validation and error checking.',\r\n          benefits: [\r\n            'Drag & drop interface',\r\n            'Auto-validation',\r\n            'Bulk import support'\r\n          ],\r\n          stat: '< 30s',\r\n          statLabel: 'Upload Time'\r\n        },\r\n        {\r\n          icon: 'pi pi-chart-bar',\r\n          title: 'Advanced Analytics',\r\n          description: 'Visualize trends, capacity factors, and performance metrics with interactive charts.',\r\n          benefits: [\r\n            'Interactive charts',\r\n            'Trend analysis',\r\n            'Predictive insights'\r\n          ],\r\n          stat: '15+',\r\n          statLabel: 'Chart Types'\r\n        },\r\n        {\r\n          icon: 'pi pi-download',\r\n          title: 'Export Reports',\r\n          description: 'Generate comprehensive reports in multiple formats with customizable options.',\r\n          benefits: [\r\n            'Excel & PDF export',\r\n            'Custom templates',\r\n            'Scheduled exports'\r\n          ],\r\n          stat: '5 sec',\r\n          statLabel: 'Generation'\r\n        },\r\n        {\r\n          icon: 'pi pi-calendar',\r\n          title: 'Scheduled Reports',\r\n          description: 'Automate report generation with flexible scheduling and email delivery.',\r\n          benefits: [\r\n            'Flexible scheduling',\r\n            'Email automation',\r\n            'Multiple recipients'\r\n          ],\r\n          stat: '100%',\r\n          statLabel: 'Automated'\r\n        },\r\n        {\r\n          icon: 'pi pi-users',\r\n          title: 'User Management',\r\n          description: 'Role-based access control with different permission levels for your team.',\r\n          benefits: [\r\n            'Role-based access',\r\n            'Activity tracking',\r\n            'Secure authentication'\r\n          ],\r\n          stat: '5',\r\n          statLabel: 'User Roles'\r\n        }\r\n      ]\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.features-page {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);\r\n  padding: 100px 20px 80px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n/* Animated Background */\r\n.animated-bg {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.bg-shape {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  filter: blur(80px);\r\n  opacity: 0.15;\r\n  animation: float 20s ease-in-out infinite;\r\n}\r\n\r\n.shape-1 {\r\n  width: 500px;\r\n  height: 500px;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  top: -200px;\r\n  left: -200px;\r\n  animation-delay: 0s;\r\n}\r\n\r\n.shape-2 {\r\n  width: 400px;\r\n  height: 400px;\r\n  background: linear-gradient(135deg, #ec4899 0%, #f59e0b 100%);\r\n  bottom: -150px;\r\n  right: -150px;\r\n  animation-delay: 5s;\r\n}\r\n\r\n.shape-3 {\r\n  width: 350px;\r\n  height: 350px;\r\n  background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation-delay: 10s;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% {\r\n    transform: translate(0, 0) scale(1);\r\n  }\r\n  33% {\r\n    transform: translate(100px, -100px) scale(1.1);\r\n  }\r\n  66% {\r\n    transform: translate(-100px, 100px) scale(0.9);\r\n  }\r\n}\r\n\r\n/* Header */\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.header-content {\r\n  display: inline-block;\r\n  position: relative;\r\n}\r\n\r\n.header-icon {\r\n  width: 100px;\r\n  height: 100px;\r\n  margin: 0 auto 30px;\r\n  border-radius: 30px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 3rem;\r\n  color: #60a5fa;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3),\r\n              0 0 0 1px rgba(255, 255, 255, 0.1) inset;\r\n  animation: iconPulse 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes iconPulse {\r\n  0%, 100% {\r\n    transform: scale(1);\r\n    box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n  }\r\n  50% {\r\n    transform: scale(1.05);\r\n    box-shadow: 0 25px 70px rgba(59, 130, 246, 0.5);\r\n  }\r\n}\r\n\r\n.glowing-text {\r\n  font-size: 4rem;\r\n  font-weight: 900;\r\n  background: linear-gradient(135deg, #ffffff 0%, #60a5fa 50%, #a78bfa 100%);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  background-clip: text;\r\n  margin: 0 0 20px 0;\r\n  letter-spacing: -2px;\r\n  text-shadow: 0 0 80px rgba(96, 165, 250, 0.5);\r\n  animation: textGlow 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes textGlow {\r\n  0%, 100% {\r\n    filter: brightness(1);\r\n  }\r\n  50% {\r\n    filter: brightness(1.2);\r\n  }\r\n}\r\n\r\n.subtitle {\r\n  font-size: 1.5rem;\r\n  color: #cbd5e1;\r\n  margin: 0;\r\n  font-weight: 300;\r\n}\r\n\r\n/* Features Container */\r\n.features-container {\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));\r\n  gap: 40px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n/* Feature Card */\r\n.feature-card-glass {\r\n  position: relative;\r\n  background: linear-gradient(135deg, \r\n    rgba(255, 255, 255, 0.05) 0%, \r\n    rgba(255, 255, 255, 0.02) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  padding: 40px;\r\n  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n  overflow: hidden;\r\n  animation: fadeInUp 0.6s ease-out backwards;\r\n}\r\n\r\n@keyframes fadeInUp {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(30px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n\r\n.feature-card-glass:hover {\r\n  transform: translateY(-10px) scale(1.02);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 30px 80px rgba(59, 130, 246, 0.3),\r\n              0 0 0 1px rgba(96, 165, 250, 0.2) inset;\r\n}\r\n\r\n.feature-glow {\r\n  position: absolute;\r\n  top: -50%;\r\n  left: -50%;\r\n  width: 200%;\r\n  height: 200%;\r\n  background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%);\r\n  opacity: 0;\r\n  transition: opacity 0.5s ease;\r\n  pointer-events: none;\r\n}\r\n\r\n.feature-glow.active {\r\n  opacity: 1;\r\n  animation: rotate 10s linear infinite;\r\n}\r\n\r\n@keyframes rotate {\r\n  from {\r\n    transform: rotate(0deg);\r\n  }\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n/* Feature Icon */\r\n.feature-icon-container {\r\n  position: relative;\r\n  width: 100px;\r\n  height: 100px;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.icon-bg {\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  border-radius: 24px;\r\n  opacity: 0.2;\r\n  transition: all 0.4s ease;\r\n}\r\n\r\n.feature-card-glass:hover .icon-bg {\r\n  opacity: 0.3;\r\n  transform: scale(1.1) rotate(5deg);\r\n}\r\n\r\n.feature-icon {\r\n  position: absolute;\r\n  inset: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 3rem;\r\n  color: #60a5fa;\r\n  z-index: 2;\r\n  transition: all 0.4s ease;\r\n}\r\n\r\n.feature-card-glass:hover .feature-icon {\r\n  transform: scale(1.1);\r\n  color: #93c5fd;\r\n}\r\n\r\n.icon-pulse {\r\n  position: absolute;\r\n  inset: -10px;\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(96, 165, 250, 0.3);\r\n  opacity: 0;\r\n  animation: pulse 2s ease-out infinite;\r\n}\r\n\r\n@keyframes pulse {\r\n  0% {\r\n    transform: scale(0.95);\r\n    opacity: 1;\r\n  }\r\n  100% {\r\n    transform: scale(1.2);\r\n    opacity: 0;\r\n  }\r\n}\r\n\r\n/* Feature Content */\r\n.feature-content h2 {\r\n  font-size: 2rem;\r\n  color: white !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n  letter-spacing: -0.5px;\r\n}\r\n\r\n.feature-content p {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  margin: 0 0 24px 0;\r\n}\r\n\r\n.feature-benefits {\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.benefit-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 12px 0;\r\n  color: #e2e8f0 !important;\r\n  font-size: 1rem;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.benefit-item:hover {\r\n  transform: translateX(10px);\r\n  color: #60a5fa;\r\n}\r\n\r\n.benefit-item i {\r\n  color: #10b981;\r\n  font-size: 1.125rem;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.feature-stats {\r\n  margin-top: 24px;\r\n  padding-top: 24px;\r\n  border-top: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.stat-item {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.stat-value {\r\n  font-size: 2.5rem;\r\n  font-weight: 800;\r\n  background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 100%);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  background-clip: text;\r\n  line-height: 1;\r\n}\r\n\r\n.stat-label {\r\n  font-size: 0.875rem;\r\n  color: #94a3b8 !important;\r\n  text-transform: uppercase;\r\n  letter-spacing: 1px;\r\n  font-weight: 600;\r\n}\r\n\r\n.feature-corner {\r\n  position: absolute;\r\n  top: 0;\r\n  right: 0;\r\n  width: 100px;\r\n  height: 100px;\r\n  background: linear-gradient(135deg, transparent 50%, rgba(96, 165, 250, 0.1) 50%);\r\n  border-radius: 0 24px 0 0;\r\n  opacity: 0;\r\n  transition: opacity 0.3s ease;\r\n}\r\n\r\n.feature-card-glass:hover .feature-corner {\r\n  opacity: 1;\r\n}\r\n\r\n/* Back Button Top Left */\r\n.back-button-top-left {\r\n  position: fixed;\r\n  top: 30px;\r\n  left: 30px;\r\n  z-index: 1000;\r\n}\r\n\r\n.btn-back-glass-small {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 12px 24px;\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.3) 0%, \r\n    rgba(139, 92, 246, 0.3) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 12px;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.btn-back-glass-small:hover {\r\n  transform: translateX(-5px);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 12px 40px rgba(59, 130, 246, 0.5);\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.4) 0%, \r\n    rgba(139, 92, 246, 0.4) 100%);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .features-container {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .glowing-text {\r\n    font-size: 2.5rem;\r\n  }\r\n  \r\n  .subtitle {\r\n    font-size: 1.125rem;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,KAAK,EAAC;AAAe;;EASnBA,KAAK,EAAC;AAAsB;;EAmB5BA,KAAK,EAAC;AAAoB;;;EAWtBA,KAAK,EAAC;AAAwB;;EAM9BA,KAAK,EAAC;AAAiB;;EAIrBA,KAAK,EAAC;AAAkB;;EAOxBA,KAAK,EAAC;AAAe;;EACnBA,KAAK,EAAC;AAAW;;EACdA,KAAK,EAAC;AAAY;;EAClBA,KAAK,EAAC;AAAY;;;uBA3DpCC,mBAAA,CAoEM,OApENC,UAoEM,G,0BAlEJC,mBAAA,CAIM;IAJDH,KAAK,EAAC;EAAa,IACtBG,mBAAA,CAAoC;IAA/BH,KAAK,EAAC;EAAkB,IAC7BG,mBAAA,CAAoC;IAA/BH,KAAK,EAAC;EAAkB,IAC7BG,mBAAA,CAAoC;IAA/BH,KAAK,EAAC;EAAkB,G,QAI/BG,mBAAA,CAKM,OALNC,UAKM,GAJJC,YAAA,CAGcC,sBAAA;IAHDC,EAAE,EAAC,GAAG;IAACP,KAAK,EAAC;;sBACxB,MAAgC,KAAAQ,MAAA,QAAAA,MAAA,OAAhCL,mBAAA,CAAgC;MAA7BH,KAAK,EAAC;IAAkB,