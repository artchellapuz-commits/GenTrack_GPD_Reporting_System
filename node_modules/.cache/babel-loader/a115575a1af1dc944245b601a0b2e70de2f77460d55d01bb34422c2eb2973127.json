{"ast":null,"code":"export default {\n  name: 'ContactUs',\n  data: function data() {\n    return {\n      contactInfo: [{\n        icon: 'pi pi-envelope',\n        title: 'Email Support',\n        description: 'Send us an email for inquiries and support',\n        details: ['System Administrator', 'IT Support Team', 'GPD Technical Staff']\n      }, {\n        icon: 'pi pi-phone',\n        title: 'Phone',\n        description: 'Contact during business hours',\n        details: ['GPD Main Office', 'IT Support Desk', 'System Administrator']\n      }, {\n        icon: 'pi pi-comments',\n        title: 'Internal Support',\n        description: 'Get help from IT support team',\n        details: ['Available during office hours', 'Submit support tickets', 'Technical and system inquiries']\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","data","contactInfo","icon","title","description","details"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\ContactUs.vue"],"sourcesContent":["<template>\r\n  <div class=\"contact-page\">\r\n    <!-- Animated Background -->\r\n    <div class=\"animated-bg\">\r\n      <div class=\"bg-shape shape-1\"></div>\r\n      <div class=\"bg-shape shape-2\"></div>\r\n      <div class=\"bg-shape shape-3\"></div>\r\n    </div>\r\n\r\n    <!-- Back Button Top Left -->\r\n    <div class=\"back-button-top-left\">\r\n      <router-link to=\"/\" class=\"btn-back-glass-small\">\r\n        <i class=\"pi pi-arrow-left\"></i>\r\n        <span>Back to Home</span>\r\n      </router-link>\r\n    </div>\r\n\r\n    <!-- Header -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"header-icon\">\r\n          <i class=\"pi pi-envelope\"></i>\r\n        </div>\r\n        <h1 class=\"glowing-text\">Contact Us</h1>\r\n        <p class=\"subtitle\">Get in touch with the GPD team</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Contact Info -->\r\n    <div class=\"contact-container\">\r\n      <div \r\n        v-for=\"(contact, index) in contactInfo\" \r\n        :key=\"index\"\r\n        class=\"contact-card-glass\"\r\n        :style=\"{ animationDelay: `${index * 0.1}s` }\"\r\n      >\r\n        <div class=\"contact-icon\">\r\n          <i :class=\"contact.icon\"></i>\r\n        </div>\r\n        <h2>{{ contact.title }}</h2>\r\n        <p>{{ contact.description }}</p>\r\n        <div class=\"contact-details\">\r\n          <div v-for=\"(detail, idx) in contact.details\" :key=\"idx\" class=\"detail-item\">\r\n            <i class=\"pi pi-angle-right\"></i>\r\n            <span>{{ detail }}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Office Location -->\r\n    <div class=\"location-section\">\r\n      <div class=\"location-card-glass\">\r\n        <h2>Office Location</h2>\r\n        <div class=\"location-details\">\r\n          <div class=\"location-item\">\r\n            <i class=\"pi pi-map-marker\"></i>\r\n            <div>\r\n              <h3>Generation and Performance Division</h3>\r\n              <p>National Power Corporation</p>\r\n              <p>Mindanao Region</p>\r\n            </div>\r\n          </div>\r\n          <div class=\"location-item\">\r\n            <i class=\"pi pi-clock\"></i>\r\n            <div>\r\n              <h3>Office Hours</h3>\r\n              <p>Monday - Friday</p>\r\n              <p>8:00 AM - 5:00 PM</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ContactUs',\r\n  data() {\r\n    return {\r\n      contactInfo: [\r\n        {\r\n          icon: 'pi pi-envelope',\r\n          title: 'Email Support',\r\n          description: 'Send us an email for inquiries and support',\r\n          details: [\r\n            'System Administrator',\r\n            'IT Support Team',\r\n            'GPD Technical Staff'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-phone',\r\n          title: 'Phone',\r\n          description: 'Contact during business hours',\r\n          details: [\r\n            'GPD Main Office',\r\n            'IT Support Desk',\r\n            'System Administrator'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-comments',\r\n          title: 'Internal Support',\r\n          description: 'Get help from IT support team',\r\n          details: [\r\n            'Available during office hours',\r\n            'Submit support tickets',\r\n            'Technical and system inquiries'\r\n          ]\r\n        }\r\n      ]\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.contact-page {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);\r\n  padding: 100px 20px 80px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.animated-bg {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.bg-shape {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  filter: blur(80px);\r\n  opacity: 0.15;\r\n  animation: float 20s ease-in-out infinite;\r\n}\r\n\r\n.shape-1 {\r\n  width: 500px;\r\n  height: 500px;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  top: -200px;\r\n  left: -200px;\r\n}\r\n\r\n.shape-2 {\r\n  width: 400px;\r\n  height: 400px;\r\n  background: linear-gradient(135deg, #ec4899 0%, #f59e0b 100%);\r\n  bottom: -150px;\r\n  right: -150px;\r\n  animation-delay: 5s;\r\n}\r\n\r\n.shape-3 {\r\n  width: 350px;\r\n  height: 350px;\r\n  background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation-delay: 10s;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% { transform: translate(0, 0) scale(1); }\r\n  33% { transform: translate(100px, -100px) scale(1.1); }\r\n  66% { transform: translate(-100px, 100px) scale(0.9); }\r\n}\r\n\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.header-icon {\r\n  width: 100px;\r\n  height: 100px;\r\n  margin: 0 auto 30px;\r\n  border-radius: 30px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 3rem;\r\n  color: #60a5fa;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n  animation: iconPulse 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes iconPulse {\r\n  0%, 100% { transform: scale(1); }\r\n  50% { transform: scale(1.05); }\r\n}\r\n\r\n.glowing-text {\r\n  font-size: 4rem;\r\n  font-weight: 900;\r\n  background: linear-gradient(135deg, #ffffff 0%, #60a5fa 50%, #a78bfa 100%);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  background-clip: text;\r\n  margin: 0 0 20px 0;\r\n  letter-spacing: -2px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 1.5rem;\r\n  color: #cbd5e1;\r\n  margin: 0;\r\n  font-weight: 300;\r\n}\r\n\r\n.contact-container {\r\n  max-width: 1200px;\r\n  margin: 0 auto 80px;\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\r\n  gap: 30px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.contact-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(255, 255, 255, 0.05) 0%, \r\n    rgba(255, 255, 255, 0.02) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  padding: 40px;\r\n  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n  animation: fadeInUp 0.6s ease-out backwards;\r\n}\r\n\r\n@keyframes fadeInUp {\r\n  from { opacity: 0; transform: translateY(30px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n.contact-card-glass:hover {\r\n  transform: translateY(-10px) scale(1.02);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 30px 80px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.contact-icon {\r\n  width: 80px;\r\n  height: 80px;\r\n  margin-bottom: 24px;\r\n  border-radius: 20px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 2.5rem;\r\n  color: #60a5fa;\r\n  transition: all 0.4s ease;\r\n}\r\n\r\n.contact-card-glass:hover .contact-icon {\r\n  transform: scale(1.1) rotate(5deg);\r\n}\r\n\r\n.contact-card-glass h2 {\r\n  font-size: 1.75rem;\r\n  color: white !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.contact-card-glass p {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  margin: 0 0 24px 0;\r\n}\r\n\r\n.contact-details {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n\r\n.detail-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  color: #e2e8f0 !important;\r\n  font-size: 1rem;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.detail-item:hover {\r\n  transform: translateX(10px);\r\n  color: #60a5fa;\r\n}\r\n\r\n.detail-item i {\r\n  color: #60a5fa;\r\n  font-size: 1rem;\r\n}\r\n\r\n.location-section {\r\n  max-width: 900px;\r\n  margin: 0 auto 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.location-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.1) 0%, \r\n    rgba(139, 92, 246, 0.1) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(96, 165, 250, 0.3);\r\n  padding: 50px;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.location-card-glass h2 {\r\n  font-size: 2.5rem;\r\n  color: white !important;\r\n  margin: 0 0 40px 0;\r\n  font-weight: 700;\r\n  text-align: center;\r\n}\r\n\r\n.location-details {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\r\n  gap: 40px;\r\n}\r\n\r\n.location-item {\r\n  display: flex;\r\n  gap: 20px;\r\n}\r\n\r\n.location-item i {\r\n  font-size: 2rem;\r\n  color: #60a5fa;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.location-item h3 {\r\n  font-size: 1.5rem;\r\n  color: white !important;\r\n  margin: 0 0 12px 0;\r\n  font-weight: 600;\r\n}\r\n\r\n.location-item p {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  margin: 4px 0;\r\n}\r\n\r\n/* Back Button Top Left */\r\n.back-button-top-left {\r\n  position: fixed;\r\n  top: 30px;\r\n  left: 30px;\r\n  z-index: 1000;\r\n}\r\n\r\n.btn-back-glass-small {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 12px 24px;\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.3) 0%, \r\n    rgba(139, 92, 246, 0.3) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 12px;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.btn-back-glass-small:hover {\r\n  transform: translateX(-5px);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 12px 40px rgba(59, 130, 246, 0.5);\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.4) 0%, \r\n    rgba(139, 92, 246, 0.4) 100%);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .contact-container {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .location-details {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .glowing-text {\r\n    font-size: 2.5rem;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AA+EA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,IAAI,WAAJA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,WAAW,EAAE,CACX;QACEC,IAAI,EAAE,gBAAgB;QACtBC,KAAK,EAAE,eAAe;QACtBC,WAAW,EAAE,4CAA4C;QACzDC,OAAO,EAAE,CACP,sBAAsB,EACtB,iBAAiB,EACjB,qBAAoB;MAExB,CAAC,EACD;QACEH,IAAI,EAAE,a