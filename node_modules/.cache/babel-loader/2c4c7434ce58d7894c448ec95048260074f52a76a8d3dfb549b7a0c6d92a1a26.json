{"ast":null,"code":"import axios from 'axios';\nimport AppLayout from './AppLayout.vue';\nexport default {\n  name: 'PasswordResetRequests',\n  components: {\n    AppLayout\n  },\n  data() {\n    return {\n      requests: [],\n      selectedRequest: null,\n      loading: false,\n      filters: {\n        status: '',\n        search: ''\n      },\n      stats: {\n        pending: 0,\n        approved: 0,\n        rejected: 0,\n        completed: 0\n      },\n      searchTimeout: null\n    };\n  },\n  created() {\n    this.loadRequests();\n  },\n  methods: {\n    async loadRequests() {\n      this.loading = true;\n      try {\n        const params = {};\n        if (this.filters.status) params.status = this.filters.status;\n        if (this.filters.search) params.search = this.filters.search;\n        const response = await axios.get(`${process.env.VUE_APP_API_URL}/password-reset-requests/`, {\n          params,\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('access_token')}`\n          }\n        });\n        this.requests = response.data || [];\n        this.calculateStats();\n      } catch (error) {\n        console.error('Error loading requests:', error);\n        alert('Failed to load password reset requests. Please try again.');\n      } finally {\n        this.loading = false;\n      }\n    },\n    calculateStats() {\n      this.stats = {\n        pending: this.requests.filter(r => r.status === 'PENDING').length,\n        approved: this.requests.filter(r => r.status === 'APPROVED').length,\n        rejected: this.requests.filter(r => r.status === 'REJECTED').length,\n        completed: this.requests.filter(r => r.status === 'COMPLETED').length\n      };\n    },\n    debounceSearch() {\n      clearTimeout(this.searchTimeout);\n      this.searchTimeout = setTimeout(() => {\n        this.loadRequests();\n      }, 500);\n    },\n    viewRequest(request) {\n      this.selectedRequest = request;\n    },\n    async approveRequest(request) {\n      if (!confirm(`Approve password reset request for ${request.username}?`)) return;\n      try {\n        await axios.patch(`${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`, {\n          status: 'APPROVED'\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('access_token')}`\n          }\n        });\n        alert('Request approved successfully');\n        this.selectedRequest = null;\n        this.loadRequests();\n      } catch (error) {\n        console.error('Error approving request:', error);\n        alert('Failed to approve request. Please try again.');\n      }\n    },\n    async rejectRequest(request) {\n      const reason = prompt(`Reject password reset request for ${request.username}?\\n\\nEnter rejection reason (optional):`);\n      if (reason === null) return;\n      try {\n        await axios.patch(`${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`, {\n          status: 'REJECTED',\n          admin_notes: reason || 'Request rejected'\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('access_token')}`\n          }\n        });\n        alert('Request rejected');\n        this.selectedRequest = null;\n        this.loadRequests();\n      } catch (error) {\n        console.error('Error rejecting request:', error);\n        alert('Failed to reject request. Please try again.');\n      }\n    },\n    async completeRequest(request) {\n      if (!confirm(`Mark password reset as completed for ${request.username}?`)) return;\n      try {\n        await axios.patch(`${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`, {\n          status: 'COMPLETED'\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('access_token')}`\n          }\n        });\n        alert('Request marked as completed');\n        this.selectedRequest = null;\n        this.loadRequests();\n      } catch (error) {\n        console.error('Error completing request:', error);\n        alert('Failed to complete request. Please try again.');\n      }\n    },\n    formatDate(dateString) {\n      if (!dateString) return 'N/A';\n      const date = new Date(dateString);\n      return date.toLocaleDateString('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric'\n      });\n    },\n    formatDateTime(dateString) {\n      if (!dateString) return 'N/A';\n      const date = new Date(dateString);\n      return date.toLocaleString('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","AppLayout","name","components","data","requests","selectedRequest","loading","filters","status","search","stats","pending","approved","rejected","completed","searchTimeout","created","loadRequests","methods","params","response","get","process","env","VUE_APP_API_URL","headers","Authorization","localStorage","getItem","calculateStats","error","console","alert","filter","r","length","debounceSearch","clearTimeout","setTimeout","viewRequest","request","approveRequest","confirm","username","patch","id","rejectRequest","reason","prompt","admin_notes","completeRequest","formatDate","dateString","date","Date","toLocaleDateString","year","month","day","formatDateTime","toLocaleString","hour","minute"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\PasswordResetRequests.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n    <div class=\"password-reset-requests\">\r\n      <div class=\"page-header\">\r\n        <div class=\"header-content\">\r\n          <div class=\"header-left\">\r\n            <i class=\"pi pi-lock\"></i>\r\n            <div>\r\n              <h1>Password Reset Requests</h1>\r\n              <p>Manage user password reset requests</p>\r\n            </div>\r\n          </div>\r\n          <div class=\"header-actions\">\r\n            <button @click=\"loadRequests\" class=\"btn-refresh\" :disabled=\"loading\">\r\n              <i class=\"pi\" :class=\"loading ? 'pi-spin pi-spinner' : 'pi-refresh'\"></i>\r\n              Refresh\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n        <!-- Stats Cards -->\r\n      <div class=\"stats-grid\">\r\n      <div class=\"stat-card pending\">\r\n        <i class=\"pi pi-clock\"></i>\r\n        <div class=\"stat-content\">\r\n          <span class=\"stat-value\">{{ stats.pending }}</span>\r\n          <span class=\"stat-label\">Pending</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"stat-card approved\">\r\n        <i class=\"pi pi-check-circle\"></i>\r\n        <div class=\"stat-content\">\r\n          <span class=\"stat-value\">{{ stats.approved }}</span>\r\n          <span class=\"stat-label\">Approved</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"stat-card rejected\">\r\n        <i class=\"pi pi-times-circle\"></i>\r\n        <div class=\"stat-content\">\r\n          <span class=\"stat-value\">{{ stats.rejected }}</span>\r\n          <span class=\"stat-label\">Rejected</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"stat-card completed\">\r\n        <i class=\"pi pi-check\"></i>\r\n        <div class=\"stat-content\">\r\n          <span class=\"stat-value\">{{ stats.completed }}</span>\r\n          <span class=\"stat-label\">Completed</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n    <!-- Filters -->\r\n    <div class=\"filters-section\">\r\n      <div class=\"filter-group\">\r\n        <label>Status</label>\r\n        <select v-model=\"filters.status\" @change=\"loadRequests\">\r\n          <option value=\"\">All Status</option>\r\n          <option value=\"PENDING\">Pending</option>\r\n          <option value=\"APPROVED\">Approved</option>\r\n          <option value=\"REJECTED\">Rejected</option>\r\n          <option value=\"COMPLETED\">Completed</option>\r\n        </select>\r\n      </div>\r\n      <div class=\"filter-group\">\r\n        <label>Search</label>\r\n        <div class=\"search-input\">\r\n          <i class=\"pi pi-search\"></i>\r\n          <input \r\n            v-model=\"filters.search\" \r\n            @input=\"debounceSearch\"\r\n            placeholder=\"Search by username...\"\r\n          />\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Requests Table -->\r\n    <div class=\"requests-table-container\">\r\n      <div v-if=\"loading\" class=\"loading-state\">\r\n        <i class=\"pi pi-spin pi-spinner\"></i>\r\n        <p>Loading requests...</p>\r\n      </div>\r\n\r\n      <div v-else-if=\"requests.length === 0\" class=\"empty-state\">\r\n        <i class=\"pi pi-inbox\"></i>\r\n        <h3>No Requests Found</h3>\r\n        <p>There are no password reset requests matching your filters.</p>\r\n      </div>\r\n\r\n      <table v-else class=\"requests-table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Username</th>\r\n            <th>Reason</th>\r\n            <th>Status</th>\r\n            <th>Requested</th>\r\n            <th>IP Address</th>\r\n            <th>Actions</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"request in requests\" :key=\"request.id\">\r\n            <td>\r\n              <div class=\"username-cell\">\r\n                <i class=\"pi pi-user\"></i>\r\n                <strong>{{ request.username }}</strong>\r\n              </div>\r\n            </td>\r\n\r\n            <td>\r\n              <span class=\"reason-text\">{{ request.reason || 'No reason provided' }}</span>\r\n            </td>\r\n            <td>\r\n              <span class=\"status-badge\" :class=\"request.status ? request.status.toLowerCase() : ''\">\r\n                {{ request.status || 'N/A' }}\r\n              </span>\r\n            </td>\r\n            <td>\r\n              <div class=\"date-cell\">\r\n                <i class=\"pi pi-calendar\"></i>\r\n                {{ formatDate(request.created_at) }}\r\n              </div>\r\n            </td>\r\n            <td>\r\n              <span class=\"ip-address\">{{ request.ip_address || 'N/A' }}</span>\r\n            </td>\r\n            <td>\r\n              <div class=\"action-buttons\">\r\n                <button \r\n                  @click=\"viewRequest(request)\" \r\n                  class=\"btn-action btn-view\"\r\n                  title=\"View Details\"\r\n                >\r\n                  <i class=\"pi pi-eye\"></i>\r\n                </button>\r\n                <button \r\n                  v-if=\"request.status === 'PENDING'\"\r\n                  @click=\"approveRequest(request)\" \r\n                  class=\"btn-action btn-approve\"\r\n                  title=\"Approve\"\r\n                >\r\n                  <i class=\"pi pi-check\"></i>\r\n                </button>\r\n                <button \r\n                  v-if=\"request.status === 'PENDING'\"\r\n                  @click=\"rejectRequest(request)\" \r\n                  class=\"btn-action btn-reject\"\r\n                  title=\"Reject\"\r\n                >\r\n                  <i class=\"pi pi-times\"></i>\r\n                </button>\r\n                <button \r\n                  v-if=\"request.status === 'APPROVED'\"\r\n                  @click=\"completeRequest(request)\" \r\n                  class=\"btn-action btn-complete\"\r\n                  title=\"Mark as Completed\"\r\n                >\r\n                  <i class=\"pi pi-check-circle\"></i>\r\n                </button>\r\n              </div>\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n\r\n    <!-- Request Detail Modal -->\r\n    <div v-if=\"selectedRequest\" class=\"modal-overlay\" @click.self=\"selectedRequest = null\">\r\n      <div class=\"request-detail-modal\">\r\n        <div class=\"modal-header\">\r\n          <h3>Request Details</h3>\r\n          <button @click=\"selectedRequest = null\" class=\"btn-close\">\r\n            <i class=\"pi pi-times\"></i>\r\n          </button>\r\n        </div>\r\n        \r\n        <div class=\"modal-body\">\r\n          <div class=\"detail-grid\">\r\n            <div class=\"detail-item\">\r\n              <label>Username</label>\r\n              <div class=\"detail-value\">\r\n                <i class=\"pi pi-user\"></i>\r\n                {{ selectedRequest.username }}\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"detail-item\">\r\n              <label>Status</label>\r\n              <div class=\"detail-value\">\r\n                <span class=\"status-badge\" :class=\"selectedRequest.status ? selectedRequest.status.toLowerCase() : ''\">\r\n                  {{ selectedRequest.status || 'N/A' }}\r\n                </span>\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"detail-item full-width\">\r\n              <label>Reason</label>\r\n              <div class=\"detail-value\">\r\n                {{ selectedRequest.reason || 'No reason provided' }}\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"detail-item\">\r\n              <label>IP Address</label>\r\n              <div class=\"detail-value\">\r\n                <i class=\"pi pi-map-marker\"></i>\r\n                {{ selectedRequest.ip_address || 'N/A' }}\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"detail-item\">\r\n              <label>Requested At</label>\r\n              <div class=\"detail-value\">\r\n                <i class=\"pi pi-calendar\"></i>\r\n                {{ formatDateTime(selectedRequest.created_at) }}\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"detail-item\" v-if=\"selectedRequest.processed_by_username\">\r\n              <label>Processed By</label>\r\n              <div class=\"detail-value\">\r\n                <i class=\"pi pi-user\"></i>\r\n                {{ selectedRequest.processed_by_username }}\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"detail-item\" v-if=\"selectedRequest.processed_at\">\r\n              <label>Processed At</label>\r\n              <div class=\"detail-value\">\r\n                <i class=\"pi pi-calendar\"></i>\r\n                {{ formatDateTime(selectedRequest.processed_at) }}\r\n              </div>\r\n            </div>\r\n\r\n            \r\n            <div class=\"detail-item full-width\" v-if=\"selectedRequest.admin_notes\">\r\n              <label>Admin Notes</label>\r\n              <div class=\"detail-value\">\r\n                {{ selectedRequest.admin_notes }}\r\n              </div>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"modal-actions\">\r\n            <button \r\n              v-if=\"selectedRequest.status === 'PENDING'\"\r\n              @click=\"approveRequest(selectedRequest)\" \r\n              class=\"btn-modal btn-approve\"\r\n            >\r\n              <i class=\"pi pi-check\"></i>\r\n              Approve Request\r\n            </button>\r\n            <button \r\n              v-if=\"selectedRequest.status === 'PENDING'\"\r\n              @click=\"rejectRequest(selectedRequest)\" \r\n              class=\"btn-modal btn-reject\"\r\n            >\r\n              <i class=\"pi pi-times\"></i>\r\n              Reject Request\r\n            </button>\r\n            <button \r\n              v-if=\"selectedRequest.status === 'APPROVED'\"\r\n              @click=\"completeRequest(selectedRequest)\" \r\n              class=\"btn-modal btn-complete\"\r\n            >\r\n              <i class=\"pi pi-check-circle\"></i>\r\n              Mark as Completed\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    </div>\r\n  </AppLayout>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport AppLayout from './AppLayout.vue';\r\n\r\nexport default {\r\n  name: 'PasswordResetRequests',\r\n  components: {\r\n    AppLayout\r\n  },\r\n  data() {\r\n    return {\r\n      requests: [],\r\n      selectedRequest: null,\r\n      loading: false,\r\n      filters: {\r\n        status: '',\r\n        search: ''\r\n      },\r\n      stats: {\r\n        pending: 0,\r\n        approved: 0,\r\n        rejected: 0,\r\n        completed: 0\r\n      },\r\n      searchTimeout: null\r\n    };\r\n  },\r\n  created() {\r\n    this.loadRequests();\r\n  },\r\n  methods: {\r\n    async loadRequests() {\r\n      this.loading = true;\r\n      try {\r\n        const params = {};\r\n        if (this.filters.status) params.status = this.filters.status;\r\n        if (this.filters.search) params.search = this.filters.search;\r\n        \r\n        const response = await axios.get(\r\n          `${process.env.VUE_APP_API_URL}/password-reset-requests/`,\r\n          { \r\n            params,\r\n            headers: { Authorization: `Bearer ${localStorage.getItem('access_token')}` }\r\n          }\r\n        );\r\n        \r\n        this.requests = response.data || [];\r\n        this.calculateStats();\r\n      } catch (error) {\r\n        console.error('Error loading requests:', error);\r\n        alert('Failed to load password reset requests. Please try again.');\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n\r\n    \r\n    calculateStats() {\r\n      this.stats = {\r\n        pending: this.requests.filter(r => r.status === 'PENDING').length,\r\n        approved: this.requests.filter(r => r.status === 'APPROVED').length,\r\n        rejected: this.requests.filter(r => r.status === 'REJECTED').length,\r\n        completed: this.requests.filter(r => r.status === 'COMPLETED').length\r\n      };\r\n    },\r\n    \r\n    debounceSearch() {\r\n      clearTimeout(this.searchTimeout);\r\n      this.searchTimeout = setTimeout(() => {\r\n        this.loadRequests();\r\n      }, 500);\r\n    },\r\n    \r\n    viewRequest(request) {\r\n      this.selectedRequest = request;\r\n    },\r\n    \r\n    async approveRequest(request) {\r\n      if (!confirm(`Approve password reset request for ${request.username}?`)) return;\r\n      \r\n      try {\r\n        await axios.patch(\r\n          `${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`,\r\n          { status: 'APPROVED' },\r\n          { headers: { Authorization: `Bearer ${localStorage.getItem('access_token')}` }}\r\n        );\r\n        \r\n        alert('Request approved successfully');\r\n        this.selectedRequest = null;\r\n        this.loadRequests();\r\n      } catch (error) {\r\n        console.error('Error approving request:', error);\r\n        alert('Failed to approve request. Please try again.');\r\n      }\r\n    },\r\n    \r\n    async rejectRequest(request) {\r\n      const reason = prompt(`Reject password reset request for ${request.username}?\\n\\nEnter rejection reason (optional):`);\r\n      if (reason === null) return;\r\n      \r\n      try {\r\n        await axios.patch(\r\n          `${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`,\r\n          { \r\n            status: 'REJECTED',\r\n            admin_notes: reason || 'Request rejected'\r\n          },\r\n          { headers: { Authorization: `Bearer ${localStorage.getItem('access_token')}` }}\r\n        );\r\n        \r\n        alert('Request rejected');\r\n        this.selectedRequest = null;\r\n        this.loadRequests();\r\n      } catch (error) {\r\n        console.error('Error rejecting request:', error);\r\n        alert('Failed to reject request. Please try again.');\r\n      }\r\n    },\r\n\r\n    \r\n    async completeRequest(request) {\r\n      if (!confirm(`Mark password reset as completed for ${request.username}?`)) return;\r\n      \r\n      try {\r\n        await axios.patch(\r\n          `${process.env.VUE_APP_API_URL}/password-reset-requests/${request.id}/`,\r\n          { status: 'COMPLETED' },\r\n          { headers: { Authorization: `Bearer ${localStorage.getItem('access_token')}` }}\r\n        );\r\n        \r\n        alert('Request marked as completed');\r\n        this.selectedRequest = null;\r\n        this.loadRequests();\r\n      } catch (error) {\r\n        console.error('Error completing request:', error);\r\n        alert('Failed to complete request. Please try again.');\r\n      }\r\n    },\r\n    \r\n    formatDate(dateString) {\r\n      if (!dateString) return 'N/A';\r\n      const date = new Date(dateString);\r\n      return date.toLocaleDateString('en-US', { \r\n        year: 'numeric', \r\n        month: 'short', \r\n        day: 'numeric' \r\n      });\r\n    },\r\n    \r\n    formatDateTime(dateString) {\r\n      if (!dateString) return 'N/A';\r\n      const date = new Date(dateString);\r\n      return date.toLocaleString('en-US', { \r\n        year: 'numeric', \r\n        month: 'short', \r\n        day: 'numeric',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped src=\"@/assets/password-reset-requests.css\"></style>\r\n"],"mappings":"AAyRA,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAOC,SAAQ,MAAO,iBAAiB;AAEvC,eAAe;EACbC,IAAI,EAAE,uBAAuB;EAC7BC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,eAAe,EAAE,IAAI;MACrBC,OAAO,EAAE,KAAK;MACdC,OAAO,EAAE;QACPC,MAAM,EAAE,EAAE;QACVC,MAAM,EAAE;MACV,CAAC;MACDC,KAAK,EAAE;QACLC,OAAO,EAAE,CAAC;QACVC,QAAQ,EAAE,CAAC;QACXC,QAAQ,EAAE,CAAC;QACXC,SAAS,EAAE;MACb,CAAC;MACDC,aAAa,EAAE;IACjB,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,YAAY,CAAC,CAAC;EACrB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,YAAYA,CAAA,EAAG;MACnB,IAAI,CAACX,OAAM,GAAI,IAAI;MACnB,IAAI;QACF,MAAMa,MAAK,GAAI,CAAC,CAAC;QACjB,IAAI,IAAI,CAAC