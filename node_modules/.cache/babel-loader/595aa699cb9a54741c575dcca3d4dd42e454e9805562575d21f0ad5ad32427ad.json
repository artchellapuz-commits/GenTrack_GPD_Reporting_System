>\n\n<style scoped>\n.gauge-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 8px;\n  padding: 10px;\n  width: 100%;\n  height: 100%;\n}\n\n.gauge-header {\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: #1e40af;\n  margin-bottom: 5px;\n  text-align: center;\n  border-bottom: 1px solid #dbeafe;\n  width: 100%;\n  padding-bottom: 5px;\n}\n\n.gauge-body {\n  position: relative;\n  width: 100%;\n  height: 100px;\n  display: flex;\n  justify-content: center;\n  align-items: flex-end;\n}\n\n.gauge-value-center {\n  position: absolute;\n  bottom: 10px;\n  left: 50%;\n  transform: translateX(-50%);\n  text-align: center;\n}\n\n.gauge-value-center .value {\n  font-size: 1.5rem;\n  font-weight: 700;\n  color: #1e293b;\n}\n\n.gauge-footer {\n  width: 100%;\n  margin-top: 5px;\n}\n\n.gauge-min-max {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.7rem;\n  color: #64748b;\n  padding: 0 10px;\n}\n\n.gauge-unit {\n  text-align: center;\n  font-size: 0.8rem;\n  font-weight: 600;\n  color: #475569;\n  margin-top: 5px;\n}\n</style>\n"],"mappings":";;EACO,SAAM;AAAiB;;EACrB,SAAM;AAAc;;EAGpB,SAAM;AAAY;;EAEhB,SAAM;AAAoB;;EACvB,SAAM;AAAO;;EAGlB,SAAM;AAAc;;EAClB,SAAM;AAAe;;EAIrB,SAAM;AAAY;;;uBAf3BA,mBAAA,CAmBM,OAnBNC,UAmBM,GAlBJC,mBAAA,CAEM,OAFNC,UAEM,EAAAC,gBAAA,CADDC,MAAA,CAAAC,KAAK,kBAEVJ,mBAAA,CAKM,OALNK,UAKM,GAJJC,YAAA,CAAsDC,mBAAA;IAA3CC,IAAI,EAAEC,QAAA,CAAAC,SAAS;IAAGC,OAAO,EAAEF,QAAA,CAAAG;gDACtCZ,mBAAA,CAEM,OAFNa,UAEM,GADJb,mBAAA,CAAsC,QAAtCc,UAAsC,EAAAZ,gBAAA,CAAfC,MAAA,CAAAY,KAAK,iB,KAGhCf,mBAAA,CAQM,OARNgB,UAQM,GAPJhB,mBAAA,CAGM,OAHNiB,UAGM,G,0BAFJjB,mBAAA,CAAc,cAAR,GAAC,qBACPA,mBAAA,CAA2B,cAAAE,gBAAA,CAAlBC,MAAA,CAAAe,QAAQ,iB,GAEnBlB,mBAAA,CAEM,OAFNmB,UAEM,EAAAjB,gBAAA,CADDC,MAAA,CAAAiB,IAAI,iB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}