ortable:hover { color: #3b82f6; }\n\n.main-row {\n  transition: all 0.2s ease;\n  border-bottom: 1px solid #f1f5f9;\n}\n\n.main-row:hover { background: #f8fafc; }\n.main-row.expanded { background: #f1f5f9; }\n.failed-row { background: rgba(239, 68, 68, 0.02); }\n\n.audit-table td { padding: 16px 24px; vertical-align: middle; }\n\n.expand-col { width: 40px; text-align: center; cursor: pointer; color: #94a3b8; }\n\n.time-col { display: flex; flex-direction: column; gap: 2px; }\n.time-col .date { font-weight: 600; color: #1e293b; font-size: 14px; }\n.time-col .time { font-size: 12px; color: #64748b; }\n\n/* User Cell */\n.user-cell { display: flex; align-items: center; gap: 12px; }\n.avatar-circle {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: #e2e8f0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 700;\n  color: #475569;\n  font-size: 14px;\n}\n\n.user-info { display: flex; flex-direction: column; }\n.user-info .name { font-weight: 600; color: #1e293b; font-size: 14px; }\n.user-info .role { font-size: 12px; color: #94a3b8; text-transform: capitalize; }\n\n/* Action Chips */\n.action-chip {\n  padding: 6px 12px;\n  border-radius: 20px;\n  font-size: 12px;\n  font-weight: 600;\n  white-space: nowrap;\n}\n\n.create { background: #ecfdf5; color: #059669; }\n.update { background: #eff6ff; color: #2563eb; }\n.delete { background: #fef2f2; color: #dc2626; }\n.login { background: #f5f3ff; color: #7c3aed; }\n.failed { background: #fff7ed; color: #ea580c; }\n.default { background: #f8fafc; color: #64748b; }\n\n/* Status Indicator */\n.status-indicator {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.status-indicator.success { color: #10b981; }\n.status-indicator.failed { color: #ef4444; }\n\n/* Severity Badges */\n.severity-badge {\n  padding: 4px 10px;\n  border-radius: 6px;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.severity-badge.low { background: #f1f5f9; color: #64748b; }\n.severity-badge.medium { background: #fff7ed; color: #f97316; }\n.severity-badge.high { background: #fef2f2; color: #ef4444; }\n.severity-badge.critical { background: #450a0a; color: #fecaca; }\n\n/* Origin Cell */\n.origin-cell { display: flex; align-items: center; gap: 8px; }\n.origin-cell .ip { font-family: monospace; font-size: 13px; color: #475569; }\n.origin-cell .loc { color: #3b82f6; cursor: pointer; }\n\n/* Detail Row */\n.detail-row { background: #f8fafc; }\n.detail-content { padding: 24px 40px; border-left: 4px solid #3b82f6; }\n\n.detail-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 20px;\n}\n\n.detail-item { display: flex; flex-direction: column; gap: 6px; }\n.detail-item.full-width { grid-column: 1 / -1; }\n\n.detail-item label {\n  font-size: 12px;\n  font-weight: 700;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.detail-item p { margin: 0; color: #334155; font-size: 14px; line-height: 1.5; }\n.code-font { font-family: monospace; background: #f1f5f9; padding: 4px 8px; border-radius: 4px; }\n\n.json-display {\n  background: #1e293b;\n  color: #e2e8f0;\n  padding: 16px;\n  border-radius: 12px;\n  font-size: 13px;\n  max-height: 200px;\n  overflow-y: auto;\n  margin: 0;\n}\n\n.error-box {\n  background: #fef2f2;\n  padding: 16px;\n  border-radius: 12px;\n  border: 1px solid #fecaca;\n}\n\n.error-box p { color: #991b1b; }\n\n/* Paginator Overrides */\n:deep(.p-paginator) {\n  background: transparent;\n  border: none;\n  padding: 24px;\n}\n\n:deep(.p-paginator-page.p-highlight) {\n  background: #3b82f6 !important;\n  color: white !important;\n}\n\n/* Animations */\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.stat-card, .glass-panel {\n  animation: fadeIn 0.5s ease-out forwards;\n}\n\n@media (max-width: 1024px) {\n  .detail-grid { grid-template-columns: 1fr