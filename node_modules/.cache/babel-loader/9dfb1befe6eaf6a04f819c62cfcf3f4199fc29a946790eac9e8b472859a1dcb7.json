ortedLogs","_this","_toConsumableArray","sort","a","b","_a$description","_b$description","aVal","bVal","Date","timestamp","user_full_name","toLowerCase","action_display","model_display_name","model_name","description","ip_address","location_display","totalPages","ceil","startEntry","endEntry","min","mounted","loadLogs","methods","sortBy","field","getSortIcon","_this2","_asyncToGenerator","_regenerator","m","_callee","params","response","_t","w","_context","p","n","page","page_size","get","v","results","count","console","error","alert","f","onPageChange","event","changeEntriesPerPage","clearFilters","exportLogs","_this3","_callee2","queryString","url","link","_context2","start_date","end_date","URLSearchParams","toString","concat","document","createElement","href","download","toISOString","split","style","display","body","appendChild","click","removeChild","formatDateTime","datetime","toLocaleString","year","month","day","hour","minute","second","hour12","formatDate","toLocaleDateString","formatTime","toLocaleTimeString","formatJSON","JSON","stringify","toggleRow","id","index","indexOf","splice","push","getActionClass","classes"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\AuditLogs.vue"],"sourcesContent":["<template>\n  <AppLayout>\n  <div class=\"audit-logs-container\">\n    <!-- Stats Overview -->\n    <div class=\"content-section\">\n      <div class=\"stats-grid\">\n        <div class=\"stat-card total\">\n          <div class=\"stat-icon\"><i class=\"pi pi-list\"></i></div>\n          <div class=\"stat-content\">\n            <span class=\"stat-label\">Total Activities</span>\n            <span class=\"stat-value\">{{ totalEntries.toLocaleString() }}</span>\n          </div>\n        </div>\n        <div class=\"stat-card security\">\n          <div class=\"stat-icon\"><i class=\"pi pi-shield\"></i></div>\n          <div class=\"stat-content\">\n            <span class=\"stat-label\">Security Alerts</span>\n            <span class=\"stat-value\">{{ securityAlertsCount }}</span>\n          </div>\n        </div>\n        <div class=\"stat-card success\">\n          <div class=\"stat-icon\"><i class=\"pi pi-check-circle\"></i></div>\n          <div class=\"stat-content\">\n            <span class=\"stat-label\">Success Rate</span>\n            <span class=\"stat-value\">{{ successRate }}%</span>\n          </div>\n        </div>\n        <div class=\"stat-card system\">\n          <div class=\"stat-icon\"><i class=\"pi pi-server\"></i></div>\n          <div class=\"stat-content\">\n            <span class=\"stat-label\">System Events</span>\n            <span class=\"stat-value\">{{ systemEventsCount }}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Filters -->\n    <div class=\"content-section\">\n      <div class=\"filters-card glass-panel\">\n        <div class=\"filters-grid\">\n          <div class=\"filter-group\">\n            <label><i class=\"pi pi-tag\"></i> Action Type</label>\n            <select v-model=\"filters.action\" class=\"custom-select\">\n              <option value=\"\">All Actions</option>\n              <optgroup label=\"Authentication\">\n                <option value=\"LOGIN\">Login</option>\n                <option value=\"LOGOUT\">Logout</option>\n                <option value=\"LOGIN_FAILED\">Login Failed</option>\n              </optgroup>\n              <optgroup label=\"Data Operations\">\n                <option value=\"CREATE\">Create</option>\n                <option value=\"UPDATE\">Update</option>\n                <option value=\"DELETE\">Delete</option>\n              </optgroup>\n              <optgroup label=\"System\">\n                <option value=\"UPLOAD\">Upload</option>\n                <option value=\"EXPORT\">Export</option>\n                <option value=\"REPORT_GENERATE\">Report Generation</option>\n              </optgroup>\n            </select>\n          </div>\n          \n          <div class=\"filter-group\">\n            <label><i class=\"pi pi-user\"></i> User</label>\n            <input type=\"text\" v-model=\"filters.username\" placeholder=\"Search by name...\" class=\"custom-input\">\n          </div>\n          \n          <div class=\"filter-group\">\n            <label><i class=\"pi pi-calendar\"></i> Time Range</label>\n            <div class=\"date-range-inputs\">\n              <input type=\"date\" v-model=\"filters.date_from\" class=\"custom-input small\">\n              <span class=\"date-sep\">to</span>\n              <input type=\"date\" v-model=\"filters.date_to\" class=\"custom-input small\">\n            </div>\n          </div>\n          \n          <div class=\"filter-actions\">\n            <button @click=\"clearFilters\" class=\"btn-action btn-clear\" v-tooltip.top=\"'Reset all filters'\">\n              <i class=\"pi pi-refresh\"></i> Reset\n            </button>\n            <button @click=\"exportLogs\" class=\"btn-action btn-export\">\n              <i class=\"pi pi-file-excel\"></i> Export Excel\n            </button>\n            <button @click=\"loadLogs\" class=\"btn-action btn-search\">\n              <i class=\"pi pi-search\"></i> Search Logs\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Audit Logs Table -->\n    <div class=\"content-section\">\n      <div v-if=\"loading\" class=\"loading-state\">\n        <div class=\"loading-spinner\">\n          <i class=\"pi pi-spin pi-spinner\"></i>\n          <p>Analyzing system logs...</p>\n        </div>\n      </div>\n\n      <div v-else-if=\"logs.length === 0\" class=\"empty-state\">\n        <div class=\"empty-illustration\">\n          <i class=\"pi pi-search-plus\"></i>\n        </div>\n        <h3>No Activities Found</h3>\n        <p>Try adjusting your filters to see more results</p>\n      </div>\n\n      <div v-else class=\"table-wrapper glass-panel\">\n        <div class=\"table-header\">\n          <div class=\"table-info\">\n            Showing <strong>{{ startEntry }}-{{ endEntry }}</strong> of <strong>{{ totalEntries }}</strong> activities\n          </div>\n          <div class=\"entries-selector\">\n            <span>Show</span>\n            <select v-model.number=\"entriesPerPage\" @change=\"changeEntriesPerPage\" class=\"entries-dropdown\">\n              <option :value=\"10\">10</option>\n              <option :value=\"25\">25</option>\n              <option :value=\"50\">50</option>\n            </select>\n            <span>entries</span>\n          </div>\n        </div>\n\n        <div class=\"table-container\">\n          <table class=\"audit-table\">\n            <thead>\n              <tr>\n                <th class=\"expand-col\"></th>\n                <th class=\"sortable\" @click=\"sortBy('timestamp')\">\n                  Timestamp <i :class=\"['pi', getSortIcon('timestamp')]\"></i>\n                </th>\n                <th class=\"sortable\" @click=\"sortBy('user')\">\n                  Initiator <i :class=\"['pi', getSortIcon('user')]\"></i>\n                </th>\n                <th class=\"sortable\" @click=\"sortBy('action')\">\n                  Action <i :class=\"['pi', getSortIcon('action')]\"></i>\n                </th>\n                <th class=\"sortable\" @click=\"sortBy('model')\">\n                  Target <i :class=\"['pi', getSortIcon('model')]\"></i>\n                </th>\n                <th>Status</th>\n                <th>Severity</th>\n                <th class=\"sortable\" @click=\"sortBy('ip_address')\">\n                  Origin <i :class=\"['pi', getSortIcon('ip_address')]\"></i>\n                </th>\n              </tr>\n            </thead>\n            <tbody>\n              <template v-for=\"log in sortedLogs\" :key=\"log.id\">\n                <tr :class=\"['main-row', { 'expanded': expandedRows.includes(log.id), 'failed-row': !log.success }]\">\n                  <td class=\"expand-col\" @click=\"toggleRow(log.id)\">\n                    <i :class=\"['pi', expandedRows.includes(log.id) ? 'pi-chevron-down' : 'pi-chevron-right']\"></i>\n                  </td>\n                  <td class=\"time-col\">\n                    <span class=\"date\">{{ formatDate(log.timestamp) }}</span>\n                    <span class=\"time\">{{ formatTime(log.timestamp) }}</span>\n                  </td>\n                  <td>\n                    <div class=\"user-cell\">\n                      <div class=\"avatar-circle\">{{ (log.user_full_name || 'S').charAt(0) }}</div>\n                      <div class=\"user-info\">\n                        <span class=\"name\">{{ log.user_full_name || 'System' }}</span>\n                        <span class=\"role\">{{ log.category || 'System' }}</span>\n                      </div>\n                    </div>\n                  </td>\n                  <td>\n                    <span :class=\"['action-chip', getActionClass(log.action)]\">\n                      {{ log.action_display || log.action }}\n                    </span>\n                  </td>\n                  <td>\n                    <span class=\"target-name\">{{ log.model_display_name || log.model_name || 'System' }}</span>\n                  </td>\n                  <td>\n                    <div :class=\"['status-indicator', log.success ? 'success' : 'failed']\">\n                      <i :class=\"['pi', log.success ? 'pi-check-circle' : 'pi-exclamation-circle']\"></i>\n                      <span>{{ log.success ? 'Success' : 'Failed' }}</span>\n                    </div>\n                  </td>\n                  <td>\n                    <span :class=\"['severity-badge', (log.severity || 'LOW').toLowerCase()]\">\n                      {{ log.severity || 'LOW' }}\n                    </span>\n                  </td>\n                  <td>\n                    <div class=\"origin-cell\">\n                      <span class=\"ip\">{{ log.ip_address || 'Internal' }}</span>\n                      <span class=\"loc\" v-tooltip.bottom=\"log.location_display\">\n                        <i class=\"pi pi-map-marker\"></i>\n                      </span>\n                    </div>\n                  </td>\n                </tr>\n                \n                <!-- Expanded Details -->\n                <tr v-if=\"expandedRows.includes(log.id)\" class=\"detail-row\">\n                  <td colspan=\"8\">\n                    <div class=\"detail-content\">\n                      <div class=\"detail-grid\">\n                        <div class=\"detail-item full-width\">\n                          <label>Activity Description</label>\n                          <p>{{ log.description }}</p>\n                        </div>\n                        <div class=\"detail-item\">\n                          <label>User Agent</label>\n                          <p class=\"code-font\">{{ log.user_agent || 'System Service' }}</p>\n                        </div>\n                        <div class=\"detail-item\">\n                          <label>Duration</label>\n                          <p>{{ log.duration_ms ? log.duration_ms + 'ms' : 'N/A' }}</p>\n                        </div>\n                        <div v-if=\"log.request_data && Object.keys(log.request_data).length > 0\" class=\"detail-item full-width\">\n                          <label>Request Context</label>\n                          <pre class=\"json-display\">{{ formatJSON(log.request_data) }}</pre>\n                        </div>\n                        <div v-if=\"log.error_message\" class=\"detail-item full-width error-box\">\n                          <label>Error Details</label>\n                          <p>{{ log.error_message }}</p>\n                        </div>\n                      </div>\n                    </div>\n                  </td>\n                </tr>\n              </template>\n            </tbody>\n          </table>\n        </div>\n\n        <Paginator \n          :rows=\"entriesPerPage\" \n          :totalRecords=\"totalEntries\" \n          :first=\"(currentPage - 1) * entriesPerPage\"\n          @page=\"onPageChange($event)\"\n          template=\"FirstPageLink PrevPageLink PageLinks NextPageLink LastPageLink CurrentPageReport\"\n          currentPageReportTemplate=\"{first} to {last} of {totalRecords}\"\n          :pageLinkSize=\"5\"\n        />\n      </div>\n    </div>\n  </div>\n  </AppLayout>\n</template>\n\n<script>\nimport axios from 'axios';\nimport AppLayout from './AppLayout.vue';\nimport Paginator from 'primevue/paginator';\n\nexport default {\n  name: 'AuditLogs',\n  components: {\n    AppLayout,\n    Paginator\n  },\n  data() {\n    return {\n      logs: [],\n      loading: false,\n      expandedRows: [],\n      filters: {\n        action: '',\n        username: '',\n        date_from: '',\n        date_to: ''\n      },\n      // Pagination\n      currentPage: 1,\n      entriesPerPage: 10,\n      totalEntries: 0,\n      // Sorting\n      sortField: 'timestamp',\n      sortOrder: -1 // -1 for descending, 1 for ascending\n    };\n  },\n  computed: {\n    securityAlertsCount() {\n      return this.logs.filter(log => log.severity === 'HIGH' || log.severity === 'CRITICAL').length;\n    },\n    successRate() {\n      if (this.logs.length === 0) return 100;\n      const successful = this.logs.filter(log => log.success).length;\n      return Math.round((successful / this.logs.length) * 100);\n    },\n    systemEventsCount() {\n      return this.logs.filter(log => log.category === 'system' || !log.user).length;\n    },\n    sortedLogs() {\n      return [...this.logs].sort((a, b) => {\n        let aVal, bVal;\n        \n        switch(this.sortField) {\n          case 'timestamp':\n            aVal = new Date(a.timestamp);\n            bVal = new Date(b.timestamp);\n            break;\n          case 'user':\n            aVal = (a.user_full_name || 'System').toLowerCase();\n            bVal = (b.user_full_name || 'System').toLowerCase();\n            break;\n          case 'action':\n            aVal = (a.action_display || a.action || '').toLowerCase();\n            bVal = (b.action_display || b.action || '').toLowerCase();\n            break;\n          case 'model':\n            aVal = (a.model_display_name || a.model_name || '').toLowerCase();\n            bVal = (b.model_display_name || b.model_name || '').toLowerCase();\n            break;\n          case 'description':\n            aVal = a.description?.toLowerCase() || '';\n            bVal = b.description?.toLowerCase() || '';\n            break;\n          case 'ip_address':\n            aVal = a.ip_address || '';\n            bVal = b.ip_address || '';\n            break;\n          case 'location':\n            aVal = (a.location_display || '').toLowerCase();\n            bVal = (b.location_display || '').toLowerCase();\n            break;\n          default:\n            return 0;\n        }\n        \n        if (aVal < bVal) return -1 * this.sortOrder;\n        if (aVal > bVal) return 1 * this.sortOrder;\n        return 0;\n      });\n    },\n    totalPages() {\n      return Math.ceil(this.totalEntries / this.entriesPerPage);\n    },\n    startEntry() {\n      return this.logs.length === 0 ? 0 : (this.currentPage - 1) * this.entriesPerPage + 1;\n    },\n    endEntry() {\n      return Math.min(this.currentPage * this.entriesPerPage, this.totalEntries);\n    }\n  },\n  mounted() {\n    this.loadLogs();\n  },\n  methods: {\n    sortBy(field) {\n      if (this.sortField === field) {\n        // Toggle sort order if clicking the same field\n        this.sortOrder = this.sortOrder * -1;\n      } else {\n        // Set new field and default to ascending\n        this.sortField = field;\n        this.sortOrder = 1;\n      }\n    },\n    \n    getSortIcon(field) {\n      if (this.sortField !== field) {\n        return 'pi-sort-alt'; // Neutral sort icon\n      }\n      return this.sortOrder === 1 ? 'pi-sort-amount-up' : 'pi-sort-amou