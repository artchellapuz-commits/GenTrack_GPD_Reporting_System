{"ast":null,"code":"import AppLayout from './AppLayout.vue';\nimport api from '../services/api';\nimport { getUser } from '../utils/auth';\nexport default {\n  name: 'SimpleSignatureTest',\n  components: {\n    AppLayout\n  },\n  data() {\n    return {\n      userInfo: {},\n      loading: true,\n      error: null,\n      apiTesting: false,\n      apiResult: null\n    };\n  },\n  async mounted() {\n    console.log('SimpleSignatureTest mounted');\n    try {\n      this.loading = true;\n      this.userInfo = getUser() || {};\n      console.log('User info loaded:', this.userInfo);\n    } catch (error) {\n      console.error('Error in mounted:', error);\n      this.error = error.message;\n    } finally {\n      this.loading = false;\n    }\n  },\n  methods: {\n    async testAPI() {\n      this.apiTesting = true;\n      this.apiResult = null;\n      try {\n        console.log('Testing API call...');\n        const response = await api.getCurrentUserSignature();\n        console.log('API response:', response);\n        this.apiResult = 'Success: ' + JSON.stringify(response.data);\n      } catch (error) {\n        console.error('API error:', error);\n        this.apiResult = 'Error: ' + error.message;\n      } finally {\n        this.apiTesting = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["AppLayout","api","getUser","name","components","data","userInfo","loading","error","apiTesting","apiResult","mounted","console","log","message","methods","testAPI","response","getCurrentUserSignature","JSON","stringify"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\npc-reporting-system\\frontend\\src\\components\\SimpleSignatureTest.vue"],"sourcesContent":["<template>\r\n  <AppLayout>\r\n    <div class=\"simple-signature-test\">\r\n      <h2>Simple Signature Test</h2>\r\n      <p>Testing signature management without SignaturePad component</p>\r\n      \r\n      <div class=\"test-section\">\r\n        <h3>User Info Test</h3>\r\n        <p>Username: {{ userInfo.username || 'Not loaded' }}</p>\r\n        <p>Loading: {{ loading }}</p>\r\n        <p>Error: {{ error || 'None' }}</p>\r\n      </div>\r\n\r\n      <div class=\"test-section\">\r\n        <h3>API Test</h3>\r\n        <button @click=\"testAPI\" :disabled=\"apiTesting\">\r\n          {{ apiTesting ? 'Testing...' : 'Test API Call' }}\r\n        </button>\r\n        <p v-if=\"apiResult\">API Result: {{ apiResult }}</p>\r\n      </div>\r\n    </div>\r\n  </AppLayout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from './AppLayout.vue';\r\nimport api from '../services/api';\r\nimport { getUser } from '../utils/auth';\r\n\r\nexport default {\r\n  name: 'SimpleSignatureTest',\r\n  components: {\r\n    AppLayout\r\n  },\r\n  data() {\r\n    return {\r\n      userInfo: {},\r\n      loading: true,\r\n      error: null,\r\n      apiTesting: false,\r\n      apiResult: null\r\n    };\r\n  },\r\n  async mounted() {\r\n    console.log('SimpleSignatureTest mounted');\r\n    try {\r\n      this.loading = true;\r\n      this.userInfo = getUser() || {};\r\n      console.log('User info loaded:', this.userInfo);\r\n    } catch (error) {\r\n      console.error('Error in mounted:', error);\r\n      this.error = error.message;\r\n    } finally {\r\n      this.loading = false;\r\n    }\r\n  },\r\n  methods: {\r\n    async testAPI() {\r\n      this.apiTesting = true;\r\n      this.apiResult = null;\r\n      try {\r\n        console.log('Testing API call...');\r\n        const response = await api.getCurrentUserSignature();\r\n        console.log('API response:', response);\r\n        this.apiResult = 'Success: ' + JSON.stringify(response.data);\r\n      } catch (error) {\r\n        console.error('API error:', error);\r\n        this.apiResult = 'Error: ' + error.message;\r\n      } finally {\r\n        this.apiTesting = false;\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.simple-signature-test {\r\n  padding: 2rem;\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.test-section {\r\n  margin: 2rem 0;\r\n  padding: 1rem;\r\n  border: 1px solid #e2e8f0;\r\n  border-radius: 0.5rem;\r\n}\r\n\r\nbutton {\r\n  padding: 0.5rem 1rem;\r\n  background: #3b82f6;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 0.25rem;\r\n  cursor: pointer;\r\n}\r\n\r\nbutton:disabled {\r\n  opacity: 0.5;\r\n  cursor: not-allowed;\r\n}\r\n</style>"],"mappings":"AAyBA,OAAOA,SAAQ,MAAO,iBAAiB;AACvC,OAAOC,GAAE,MAAO,iBAAiB;AACjC,SAASC,OAAM,QAAS,eAAe;AAEvC,eAAe;EACbC,IAAI,EAAE,qBAAqB;EAC3BC,UAAU,EAAE;IACVJ;EACF,CAAC;EACDK,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,CAAC,CAAC;MACZC,OAAO,EAAE,IAAI;MACbC,KAAK,EAAE,IAAI;MACXC,UAAU,EAAE,KAAK;MACjBC,SAAS,EAAE;IACb,CAAC;EACH,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACdC,OAAO,CAACC,GAAG,CAAC,6BAA6B,CAAC;IAC1C,IAAI;MACF,IAAI,CAACN,OAAM,GAAI,IAAI;MACnB,IAAI,CAACD,QAAO,GAAIJ,OAAO,CAAC,KAAK,CAAC,CAAC;MAC/BU,OAAO,CAACC,GAAG,CAAC,mBAAmB,EAAE,IAAI,CAACP,QAAQ,CAAC;IACjD,EAAE,OAAOE,KAAK,EAAE;MACdI,OAAO,CAACJ,KAAK,CAAC,mBAAmB,EAAEA,KAAK,CAAC;MACzC,IAAI,CAACA,KAAI,GAAIA,KAAK,CAACM,OAAO;IAC5B,UAAU;MACR,IAAI,CAACP,OAAM,GAAI,KAAK;IACtB;EACF,CAAC;EACDQ,OAAO,EAAE;IACP,MAAMC,OAAOA,CAAA,EAAG;MACd,IAAI,CAACP,UAAS,GAAI,IAAI;MACtB,IAAI,CAACC,SAAQ,GAAI,IAAI;MACrB,IAAI;QACFE,OAAO,CAACC,GAAG,CAAC,qBAAqB,CAAC;QAClC,MAAMI,QAAO,GAAI,MAAMhB,GAAG,CAACiB,uBAAuB,CAAC,CAAC;QACpDN,OAAO,CAACC,GAAG,CAAC,eAAe,EAAEI,QAAQ,CAAC;QACtC,IAAI,CAACP,SAAQ,GAAI,WAAU,GAAIS,IAAI,CAACC,SAAS,CAACH,QAAQ,CAACZ,IAAI,CAAC;MAC9D,EAAE,OAAOG,KAAK,EAAE;QACdI,OAAO,CAACJ,KAAK,CAAC,YAAY,EAAEA,KAAK,CAAC;QAClC,IAAI,CAACE,SAAQ,GAAI,SAAQ,GAAIF,KAAK,CAACM,OAAO;MAC5C,UAAU;QACR,IAAI,CAACL,UAAS,GAAI,KAAK;MACzB;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}