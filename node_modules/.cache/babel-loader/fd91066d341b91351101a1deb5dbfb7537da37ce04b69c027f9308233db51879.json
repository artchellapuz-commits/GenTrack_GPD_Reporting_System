T */))])])])]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","_createVNode","_component_router_link","to","_cache","_hoisted_3","_Fragment","_renderList","$data","securityFeatures","feature","index","key","style","_normalizeStyle","animationDelay","_hoisted_4","_normalizeClass","icon","_toDisplayString","title","description","_hoisted_5","items","item","idx","_hoisted_6","_hoisted_7","_hoisted_8","bestPractices","practice","_hoisted_9","_hoisted_10","_hoisted_11","productionRecommendations","rec"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern\\npc-reporting-system\\frontend\\src\\components\\Security.vue"],"sourcesContent":["<template>\r\n  <div class=\"security-page\">\r\n    <!-- Animated Background -->\r\n    <div class=\"animated-bg\">\r\n      <div class=\"bg-shape shape-1\"></div>\r\n      <div class=\"bg-shape shape-2\"></div>\r\n      <div class=\"bg-shape shape-3\"></div>\r\n    </div>\r\n\r\n    <!-- Back Button Top Left -->\r\n    <div class=\"back-button-top-left\">\r\n      <router-link to=\"/\" class=\"btn-back-glass-small\">\r\n        <i class=\"pi pi-arrow-left\"></i>\r\n        <span>Back to Home</span>\r\n      </router-link>\r\n    </div>\r\n\r\n    <!-- Header -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"header-icon\">\r\n          <i class=\"pi pi-lock\"></i>\r\n        </div>\r\n        <h1 class=\"glowing-text\">Security</h1>\r\n        <p class=\"subtitle\">Protecting your data is our priority</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Security Features -->\r\n    <div class=\"security-container\">\r\n      <div \r\n        v-for=\"(feature, index) in securityFeatures\" \r\n        :key=\"index\"\r\n        class=\"security-card-glass\"\r\n        :style=\"{ animationDelay: `${index * 0.1}s` }\"\r\n      >\r\n        <div class=\"security-icon\">\r\n          <i :class=\"feature.icon\"></i>\r\n        </div>\r\n        <h2>{{ feature.title }}</h2>\r\n        <p>{{ feature.description }}</p>\r\n        <ul class=\"feature-list\">\r\n          <li v-for=\"(item, idx) in feature.items\" :key=\"idx\">\r\n            <i class=\"pi pi-check-circle\"></i>\r\n            <span>{{ item }}</span>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Best Practices -->\r\n    <div class=\"best-practices-section\">\r\n      <div class=\"practices-card-glass\">\r\n        <h2>Security Best Practices</h2>\r\n        <p>Help us keep your account secure by following these guidelines</p>\r\n        <div class=\"practices-grid\">\r\n          <div v-for=\"(practice, index) in bestPractices\" :key=\"index\" class=\"practice-item\">\r\n            <i :class=\"practice.icon\"></i>\r\n            <div>\r\n              <h3>{{ practice.title }}</h3>\r\n              <p>{{ practice.description }}</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Production Recommendations -->\r\n    <div class=\"recommendations-section\">\r\n      <div class=\"recommendations-card-glass\">\r\n        <div class=\"recommendation-header\">\r\n          <i class=\"pi pi-info-circle\"></i>\r\n          <h2>Recommended for Production Deployment</h2>\r\n        </div>\r\n        <p class=\"recommendation-intro\">For enhanced security in production environments, consider implementing:</p>\r\n        <div class=\"recommendations-list\">\r\n          <div v-for=\"(rec, index) in productionRecommendations\" :key=\"index\" class=\"recommendation-item\">\r\n            <i class=\"pi pi-angle-right\"></i>\r\n            <span>{{ rec }}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'Security',\r\n  data() {\r\n    return {\r\n      securityFeatures: [\r\n        {\r\n          icon: 'pi pi-lock',\r\n          title: 'Authentication & Authorization',\r\n          description: 'Secure user authentication with JWT tokens',\r\n          items: [\r\n            'JWT token-based authentication',\r\n            'Role-based access control (RBAC)',\r\n            'Secure password hashing (PBKDF2)',\r\n            'Session timeout management',\r\n            'Protected API endpoints'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-shield',\r\n          title: 'Django Security Features',\r\n          description: 'Built-in framework security protections',\r\n          items: [\r\n            'CSRF protection on all forms',\r\n            'SQL injection prevention',\r\n            'XSS (Cross-Site Scripting) protection',\r\n            'Clickjacking protection',\r\n            'Secure cookie handling'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-file-edit',\r\n          title: 'Activity Logging',\r\n          description: 'Comprehensive audit trail of user actions',\r\n          items: [\r\n            'User activity tracking',\r\n            'Login/logout logging',\r\n            'Data modification records',\r\n            'File upload tracking',\r\n            'Searchable audit logs'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-database',\r\n          title: 'Data Protection',\r\n          description: 'Secure data handling and storage',\r\n          items: [\r\n            'Input validation and sanitization',\r\n            'File upload restrictions (25MB limit)',\r\n            'Secure file storage',\r\n            'Database query protection',\r\n            'HTTPS support (when configured)'\r\n          ]\r\n        }\r\n      ],\r\n      bestPractices: [\r\n        {\r\n          icon: 'pi pi-key',\r\n          title: 'Strong Passwords',\r\n          description: 'Use complex passwords with at least 8 characters, including letters, numbers, and symbols'\r\n        },\r\n        {\r\n          icon: 'pi pi-eye-slash',\r\n          title: 'Keep Credentials Private',\r\n          description: 'Never share your login credentials with anyone, including colleagues'\r\n        },\r\n        {\r\n          icon: 'pi pi-sign-out',\r\n          title: 'Logout When Done',\r\n          description: 'Always log out when finished, especially on shared or public computers'\r\n        },\r\n        {\r\n          icon: 'pi pi-exclamation-triangle',\r\n          title: 'Report Suspicious Activity',\r\n          description: 'Immediately report any unusual account activity or security concerns to IT support'\r\n        },\r\n        {\r\n          icon: 'pi pi-desktop',\r\n          title: 'Secure Your Workstation',\r\n          description: 'Lock your computer when away and keep your operating system updated'\r\n        },\r\n        {\r\n          icon: 'pi pi-shield',\r\n          title: 'Verify File Sources',\r\n          description: 'Only upload files from trusted sources and verify data before submission'\r\n        }\r\n      ],\r\n      productionRecommendations: [\r\n        'HTTPS/SSL certificate for encrypted data transmission',\r\n        'Rate limiting to prevent brute force attacks',\r\n        'Regular security audits and vulnerability assessments',\r\n        'Backup and disaster recovery procedures',\r\n        'Network firewall and access restrictions',\r\n        'Security monitoring and logging tools',\r\n        'Regular software updates and patch management',\r\n        'Multi-factor authentication (MFA) for sensitive accounts'\r\n      ]\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.security-page {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);\r\n  padding: 100px 20px 80px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.animated-bg {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.bg-shape {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  filter: blur(80px);\r\n  opacity: 0.15;\r\n  animation: float 20s ease-in-out infinite;\r\n}\r\n\r\n.shape-1 {\r\n  width: 500px;\r\n  height: 500px;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  top: -200px;\r\n  left: -200px;\r\n}\r\n\r\n.shape-2 {\r\n  width: 400px;\r\n  height: 400px;\r\n  background: linear-gradient(135deg, #ec4899 0%, #f59e0b 100%);\r\n  bottom: -150px;\r\n  right: -150px;\r\n  animation-delay: 5s;\r\n}\r\n\r\n.shape-3 {\r\n  width: 350px;\r\n  height: 350px;\r\n  background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation-delay: 10s;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% { transform: translate(0, 0) scale(1); }\r\n  33% { transform: translate(100px, -100px) scale(1.1); }\r\n  66% { transform: translate(-100px, 100px) scale(0.9); }\r\n}\r\n\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.header-icon {\r\n  width: 100px;\r\n  height: 100px;\r\n  margin: 0 auto 30px;\r\n  border-radius: 30px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 3rem;\r\n  color: #60a5fa;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n  animation: iconPulse 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes iconPulse {\r\n  0%, 100% { transform: scale(1); }\r\n  50% { transform: scale(1.05); }\r\n}\r\n\r\n.glowing-text {\r\n  font-size: 4rem;\r\n  font-weight: 900;\r\n  background: linear-gradient(135deg, #ffffff 0%, #60a5fa 50%, #a78bfa 100%);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  background-clip: text;\r\n  margin: 0 0 20px 0;\r\n  letter-spacing: -2px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 1.5rem;\r\n  color: #cbd5e1;\r\n  margin: 0;\r\n  font-weight: 300;\r\n}\r\n\r\n.security-container {\r\n  max-width: 1400px;\r\n  margin: 0 auto 80px;\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));\r\n  gap: 30px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.security-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(255, 255, 255, 0.05) 0%, \r\n    rgba(255, 255, 255, 0.02) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  padding: 40px;\r\n  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n  animation: fadeInUp 0.6s ease-out backwards;\r\n}\r\n\r\n@keyframes fadeInUp {\r\n  from { opacity: 0; transform: translateY(30px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n.security-card-glass:hover {\r\n  transform: translateY(-10px) scale(1.02);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 30px 80px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.security-icon {\r\n  width: 80px;\r\n  height: 80px;\r\n  margin-bottom: 24px;\r\n  border-radius: 20px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 2.5rem;\r\n  color: #60a5fa;\r\n  transition: all 0.4s ease;\r\n}\r\n\r\n.security-card-glass:hover .security-icon {\r\n  transform: scale(1.1) rotate(5deg);\r\n}\r\n\r\n.security-card-glass h2 {\r\n  font-size: 1.75rem;\r\n  color: white !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.security-card-glass p {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  margin: 0 0 24px 0;\r\n}\r\n\r\n.feature-list {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.feature-list li {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 12px 0;\r\n  color: #e2e8f0 !important;\r\n  font-size: 1rem;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.feature-list li:hover {\r\n  transform: translateX(10px);\r\n  color: #60a5fa;\r\n}\r\n\r\n.feature-list li i {\r\n  color: #10b981;\r\n  font-size: 1.125rem;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.best-practices-section {\r\n  max-width: 1200px;\r\n  margin: 0 auto 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.practices-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.1) 0%, \r\n    rgba(139, 92, 246, 0.1) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(96, 165, 250, 0.3);\r\n  padding: 50px;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.practices-card-glass h2 {\r\n  font-size: 2.5rem;\r\n  color: white !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n  text-align: center;\r\n}\r\n\r\n.practices-card-glass > p {\r\n  font-size: 1.25rem;\r\n  color: #cbd5e1 !important;\r\n  margin: 0 0 40px 0;\r\n  text-align: center;\r\n}\r\n\r\n.practices-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\r\n  gap: 30px;\r\n}\r\n\r\n.practice-item {\r\n  display: flex;\r\n  gap: 20px;\r\n  padding: 24px;\r\n  background: rgba(255, 255, 255, 0.03);\r\n  border-radius: 16px;\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.practice-item:hover {\r\n  background: rgba(255, 255, 255, 0.05);\r\n  border-color: rgba(96, 165, 250, 0.3);\r\n  transform: translateY(-5px);\r\n}\r\n\r\n.practice-item i {\r\n  font-size: 2rem;\r\n  color: #60a5fa;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.practice-item h3 {\r\n  font-size: 1.25rem;\r\n  color: white !important;\r\n  margin: 0 0 8px 0;\r\n  font-weight: 600;\r\n}\r\n\r\n.practice-item p {\r\n  font-size: 1rem;\r\n  color: #cbd5e1 !important;\r\n  margin: 0;\r\n  line-height: 1.6;\r\n}\r\n\r\n.recommendations-section {\r\n  max-width: 1000px;\r\n  margin: 0 auto 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.recommendations-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(251, 191, 36, 0.1) 0%, \r\n    rgba(245, 158, 11, 0.1) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(251, 191, 36, 0.3);\r\n  padding: 50px;\r\n  box-shadow: 0 20px 60px rgba(251, 191, 36, 0.2);\r\n}\r\n\r\n.recommendation-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 16px;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.recommendation-header i {\r\n  font-size: 2.5rem;\r\n  color: #fbbf24;\r\n}\r\n\r\n.recommendation-header h2 {\r\n  font-size: 2.5rem;\r\n  color: white !important;\r\n  margin: 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.recommendation-intro {\r\n  font-size: 1.25rem;\r\n  color: #cbd5e1 !important;\r\n  margin: 0 0 32px 0;\r\n  text-align: center;\r\n}\r\n\r\n.recommendations-list {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\r\n  gap: 16px;\r\n}\r\n\r\n.recommendation-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 16px;\r\n  background: rgba(255, 255, 255, 0.03);\r\n  border-radius: 12px;\r\n  border: 1px solid rgba(251, 191, 36, 0.2);\r\n  color: #e2e8f0 !important;\r\n  font-size: 1.125rem;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.recommendation-item:hover {\r\n  background: rgba(255, 255, 255, 0.05);\r\n  border-color: rgba(251, 191, 36, 0.4);\r\n  transform: translateX(10px);\r\n}\r\n\r\n.recommendation-item i {\r\n  color: #fbbf24;\r\n  font-size: 1.25rem;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Back Button Top Left */\r\n.back-button-top-left {\r\n  position: fixed;\r\n  top: 30px;\r\n  left: 30px;\r\n  z-index: 1000;\r\n}\r\n\r\n.btn-back-glass-small {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 12px 24px;\r\n  background: linear-gradient(135deg, \r\n    rgba(