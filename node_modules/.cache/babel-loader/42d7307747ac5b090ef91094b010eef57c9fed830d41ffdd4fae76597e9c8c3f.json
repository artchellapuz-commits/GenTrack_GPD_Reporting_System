s=\"pi pi-check-circle\"></i>\r\n            <span>{{ item }}</span>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'Documentation',\r\n  data() {\r\n    return {\r\n      docSections: [\r\n        {\r\n          icon: 'pi pi-play-circle',\r\n          title: 'Getting Started',\r\n          description: 'Quick start guide to begin using the system',\r\n          items: [\r\n            'System requirements and setup',\r\n            'User registration and login',\r\n            'Dashboard overview',\r\n            'Navigation basics'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-upload',\r\n          title: 'Data Upload',\r\n          description: 'Learn how to upload and manage daily reports',\r\n          items: [\r\n            'Excel file format requirements',\r\n            'Upload process step-by-step',\r\n            'Data validation rules',\r\n            'Error handling and troubleshooting'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-chart-line',\r\n          title: 'Reports & Analytics',\r\n          description: 'Generate and analyze performance reports',\r\n          items: [\r\n            'PSR report generation',\r\n            'Daily status reports',\r\n            'Advanced analytics dashboard',\r\n            'Export options (Excel, PDF)'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-calendar',\r\n          title: 'Scheduled Reports',\r\n          description: 'Automate report generation and delivery',\r\n          items: [\r\n            'Creating scheduled reports',\r\n            'Setting up email notifications',\r\n            'Managing report schedules',\r\n            'Viewing execution history'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-users',\r\n          title: 'User Management',\r\n          description: 'Manage users and permissions',\r\n          items: [\r\n            'User roles and permissions',\r\n            'Adding and editing users',\r\n            'Access control settings',\r\n            'Audit logs and tracking'\r\n          ]\r\n        },\r\n        {\r\n          icon: 'pi pi-cog',\r\n          title: 'System Settings',\r\n          description: 'Configure system preferences',\r\n          items: [\r\n            'Theme customization',\r\n            'User profile settings',\r\n            'Password management',\r\n            'Notification preferences'\r\n          ]\r\n        }\r\n      ]\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.documentation-page {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);\r\n  padding: 100px 20px 80px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.animated-bg {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.bg-shape {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  filter: blur(80px);\r\n  opacity: 0.15;\r\n  animation: float 20s ease-in-out infinite;\r\n}\r\n\r\n.shape-1 {\r\n  width: 500px;\r\n  height: 500px;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  top: -200px;\r\n  left: -200px;\r\n}\r\n\r\n.shape-2 {\r\n  width: 400px;\r\n  height: 400px;\r\n  background: linear-gradient(135deg, #ec4899 0%, #f59e0b 100%);\r\n  bottom: -150px;\r\n  right: -150px;\r\n  animation-delay: 5s;\r\n}\r\n\r\n.shape-3 {\r\n  width: 350px;\r\n  height: 350px;\r\n  background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation-delay: 10s;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% { transform: translate(0, 0) scale(1); }\r\n  33% { transform: translate(100px, -100px) scale(1.1); }\r\n  66% { transform: translate(-100px, 100px) scale(0.9); }\r\n}\r\n\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 80px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.header-icon {\r\n  width: 100px;\r\n  height: 100px;\r\n  margin: 0 auto 30px;\r\n  border-radius: 30px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 3rem;\r\n  color: #60a5fa;\r\n  box-shadow: 0 20px 60px rgba(59, 130, 246, 0.3);\r\n  animation: iconPulse 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes iconPulse {\r\n  0%, 100% { transform: scale(1); }\r\n  50% { transform: scale(1.05); }\r\n}\r\n\r\n.glowing-text {\r\n  font-size: 4rem;\r\n  font-weight: 900;\r\n  background: linear-gradient(135deg, #ffffff 0%, #60a5fa 50%, #a78bfa 100%);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  background-clip: text;\r\n  margin: 0 0 20px 0;\r\n  letter-spacing: -2px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 1.5rem;\r\n  color: #cbd5e1;\r\n  margin: 0;\r\n  font-weight: 300;\r\n}\r\n\r\n.docs-container {\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\r\n  gap: 40px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.doc-card-glass {\r\n  background: linear-gradient(135deg, \r\n    rgba(255, 255, 255, 0.05) 0%, \r\n    rgba(255, 255, 255, 0.02) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 24px;\r\n  border: 2px solid rgba(255, 255, 255, 0.1);\r\n  padding: 40px;\r\n  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n  animation: fadeInUp 0.6s ease-out backwards;\r\n}\r\n\r\n@keyframes fadeInUp {\r\n  from { opacity: 0; transform: translateY(30px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n.doc-card-glass:hover {\r\n  transform: translateY(-10px) scale(1.02);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 30px 80px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.doc-icon {\r\n  width: 80px;\r\n  height: 80px;\r\n  margin-bottom: 24px;\r\n  border-radius: 20px;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 2.5rem;\r\n  color: #60a5fa;\r\n  transition: all 0.4s ease;\r\n}\r\n\r\n.doc-card-glass:hover .doc-icon {\r\n  transform: scale(1.1) rotate(5deg);\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.3) 0%, rgba(139, 92, 246, 0.3) 100%);\r\n}\r\n\r\n.doc-card-glass h2 {\r\n  font-size: 2rem;\r\n  color: white !important;\r\n  margin: 0 0 16px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.doc-card-glass p {\r\n  font-size: 1.125rem;\r\n  color: #cbd5e1 !important;\r\n  line-height: 1.8;\r\n  margin: 0 0 24px 0;\r\n}\r\n\r\n.doc-list {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.doc-list li {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 12px 0;\r\n  color: #e2e8f0 !important;\r\n  font-size: 1rem;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.doc-list li:hover {\r\n  transform: translateX(10px);\r\n  color: #60a5fa;\r\n}\r\n\r\n.doc-list li i {\r\n  color: #10b981;\r\n  font-size: 1.125rem;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Back Button Top Left */\r\n.back-button-top-left {\r\n  position: fixed;\r\n  top: 30px;\r\n  left: 30px;\r\n  z-index: 1000;\r\n}\r\n\r\n.btn-back-glass-small {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 12px 24px;\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.3) 0%, \r\n    rgba(139, 92, 246, 0.3) 100%);\r\n  backdrop-filter: blur(20px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 12px;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);\r\n}\r\n\r\n.btn-back-glass-small:hover {\r\n  transform: translateX(-5px);\r\n  border-color: rgba(96, 165, 250, 0.5);\r\n  box-shadow: 0 12px 40px rgba(59, 130, 246, 0.5);\r\n  background: linear-gradient(135deg, \r\n    rgba(59, 130, 246, 0.4) 0%, \r\n    rgba(139, 92, 246, 0.4) 100%);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .docs-container {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .glowing-text {\r\n    font-size: 2.5rem;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;;;;EACO,SAAM;AAAoB;;EASxB,SAAM;AAAsB;;EAmB5B,SAAM;AAAgB;;EAOlB,SAAM;AAAU;;EAKjB,SAAM;AAAU;;;uBAxC1BA,mBAAA,CAiDM,OAjDNC,UAiDM,GAhDJC,mBAAA,yBAA4B,E,0BAC5BC,mBAAA,CAIM;IAJD,SAAM;EAAa,IACtBA,mBAAA,CAAoC;IAA/B,SAAM;EAAkB,IAC7BA,mBAAA,CAAoC;IAA/B,SAAM;EAAkB,IAC7BA,mBAAA,CAAoC;IAA/B,SAAM;EAAkB,G,qBAG/BD,mBAAA,0BAA6B,EAC7BC,mBAAA,CAKM,OALNC,UAKM,GAJJC,YAAA,CAGcC,sBAAA;IAHDC,EAAE,EAAC,GAAG;IAAC,SAAM;;wBACxB;MAAA,OAAAC,kBAAA,CAAgCC,MAAA,QAAAA,MAAA,OAAhCN,mBAAA,CAAgC;QAA7B,SAAM;MAAkB,2BAC3BA,mBAAA,CAAyB,cAAnB,cAAY,mB;;;QAItBD,mBAAA,YAAe,E,6YAWfA,mBAAA,4BAA+B,EAC/BC,mBAAA,CAmBM,OAnBNO,UAmBM,I,kBAlBJV,mBAAA,CAiBMW,SAAA,QAAAC,WAAA,CAhBuBC,KAAA,CAAAC,WAAW,YAA9BC,OAAO,EAAEC,KAAK;yBADxBhB,mBAAA,CAiBM;MAfHiB,GAAG,EAAED,KAAK;MACX,SAAM,gBAAgB;MACrBE,KAAK,EAAAC,eAAA;QAAAC,cAAA,KAAAC,MAAA,CAAuBL,KAAK;MAAA;QAElCb,mBAAA,CAEM,OAFNmB,UAEM,GADJnB,mBAAA,CAA6B;MAAzB,SAAKoB,eAAA,CAAER,OAAO,CAACS,IAAI;+BAEzBrB,mBAAA,CAA4B,YAAAsB,gBAAA,CAArBV,OAAO,CAACW,KAAK,kBACpBvB,mBAAA,CAAgC,WAAAsB,gBAAA,CAA1BV,OAAO,CAACY,WAAW,kBACzBxB,mBAAA,CAKK,MALLyB,UAKK,I,kBAJH5B,mBAAA,CAGKW,SAAA,QAAAC,WAAA,CAHqBG,OAAO,CAACc,KAAK,YAA3BC,IAAI,EAAEC,GAAG;2BAArB/B,mBAAA,CAGK;QAHqCiB,GAAG,EAAEc;MAAG,I,0BAChD5B,mBAAA,CAAkC;QAA/B,SAAM;MAAoB,4BAC7BA,mBAAA,CAAuB,cAAAsB,gBAAA,CAAdK,IAAI,iB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}