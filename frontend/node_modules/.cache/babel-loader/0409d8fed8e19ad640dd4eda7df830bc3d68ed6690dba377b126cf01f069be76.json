) {\n                  _this2.error = \"Password: \".concat(errors.password[0]);\n                } else {\n                  _this2.error = 'Registration failed. Please try again.';\n                }\n              } else {\n                _this2.error = 'Network error. Please check your connection.';\n              }\n            case 4:\n              _context.p = 4;\n              _this2.loading = false;\n              return _context.f(4);\n            case 5:\n              return _context.a(2);\n          }\n        }, _callee, null, [[1, 3, 4, 5]]);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["axios","ThemeControls","name","components","data","currentRiverIndex","riverImages","require","formData","username","email","first_name","last_name","password","password2","showPassword","showPassword2","loading","error","mounted","startBackgroundSlideshow","beforeUnmount","backgroundInterval","clearInterval","methods","_this","setInterval","length","handleRegister","_this2","_asyncToGenerator","_regenerator","m","_callee","response","errors","_t","w","_context","p","n","a","post","concat","process","env","VUE_APP_API_URL","v","localStorage","setItem","tokens","access","refresh","JSON","stringify","user","defaults","headers","common","$router","push","console","f"],"sources":["C:\\Users\\eladiong\\Desktop\\OJT Intern_v2\\frontend\\src\\components\\Register.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-page\">\r\n    <!-- Background Slideshow -->\r\n    <div class=\"background-slideshow\">\r\n      <img \r\n        v-for=\"(image, index) in riverImages\" \r\n        :key=\"index\"\r\n        :src=\"image\" \r\n        alt=\"\" \r\n        class=\"background-image\"\r\n        :class=\"{ 'active': index === currentRiverIndex }\"\r\n      />\r\n    </div>\r\n    <div class=\"background-overlay\"></div>\r\n\r\n    <!-- Theme Controls -->\r\n    <ThemeControls />\r\n\r\n    <!-- Back Button -->\r\n    <router-link to=\"/\" class=\"back-button\">\r\n      <i class=\"pi pi-arrow-left\"></i>\r\n      Back to Home\r\n    </router-link>\r\n    \r\n    <div class=\"register-container\">\r\n      <div class=\"register-card\">\r\n        <!-- Logo and Title -->\r\n        <div class=\"register-header\">\r\n          <div class=\"logo-icon\">\r\n            <img src=\"@/assets/NPC-logo.png\" alt=\"GenTrack Logo\" />\r\n          </div>\r\n          <h2>Create an Account</h2>\r\n          <p>Sign up to get started</p>\r\n        </div>\r\n\r\n        <!-- Register Form -->\r\n        <form @submit.prevent=\"handleRegister\" class=\"register-form\">\r\n          <div class=\"form-row\">\r\n            <div class=\"form-group\">\r\n              <label for=\"first_name\">First Name</label>\r\n              <input\r\n                id=\"first_name\"\r\n                v-model=\"formData.first_name\"\r\n                type=\"text\"\r\n                placeholder=\"First name\"\r\n                required\r\n                :disabled=\"loading\"\r\n              />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label for=\"last_name\">Last Name</label>\r\n              <input\r\n                id=\"last_name\"\r\n                v-model=\"formData.last_name\"\r\n                type=\"text\"\r\n                placeholder=\"Last name\"\r\n                required\r\n                :disabled=\"loading\"\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"username\">Username</label>\r\n            <input\r\n              id=\"username\"\r\n              v-model=\"formData.username\"\r\n              type=\"text\"\r\n              placeholder=\"Username\"\r\n              required\r\n              :disabled=\"loading\"\r\n            />\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"email\">Email</label>\r\n            <input\r\n              id=\"email\"\r\n              v-model=\"formData.email\"\r\n              type=\"email\"\r\n              placeholder=\"Email address\"\r\n              required\r\n              :disabled=\"loading\"\r\n            />\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"password\">Password</label>\r\n            <div class=\"password-input\">\r\n              <input\r\n                id=\"password\"\r\n                v-model=\"formData.password\"\r\n                :type=\"showPassword ? 'text' : 'password'\"\r\n                placeholder=\"Password\"\r\n                required\r\n                :disabled=\"loading\"\r\n              />\r\n              <button\r\n                type=\"button\"\r\n                class=\"toggle-password\"\r\n                @click=\"showPassword = !showPassword\"\r\n                :disabled=\"loading\"\r\n              >\r\n                <i :class=\"showPassword ? 'pi pi-eye-slash' : 'pi pi-eye'\"></i>\r\n              </button>\r\n            </div>\r\n            <small>At least 8 characters</small>\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"password2\">Confirm Password</label>\r\n            <div class=\"password-input\">\r\n              <input\r\n                id=\"password2\"\r\n                v-model=\"formData.password2\"\r\n                :type=\"showPassword2 ? 'text' : 'password'\"\r\n                placeholder=\"Confirm password\"\r\n                required\r\n                :disabled=\"loading\"\r\n              />\r\n              <button\r\n                type=\"button\"\r\n                class=\"toggle-password\"\r\n                @click=\"showPassword2 = !showPassword2\"\r\n                :disabled=\"loading\"\r\n              >\r\n                <i :class=\"showPassword2 ? 'pi pi-eye-slash' : 'pi pi-eye'\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Error Message -->\r\n          <div v-if=\"error\" class=\"error-message\">\r\n            <i class=\"pi pi-exclamation-circle\"></i>\r\n            {{ error }}\r\n          </div>\r\n\r\n          <!-- Register Button -->\r\n          <button type=\"submit\" class=\"register-button\" :disabled=\"loading\">\r\n            <span v-if=\"!loading\">Create Account</span>\r\n            <span v-else>\r\n              <i class=\"pi pi-spin pi-spinner\"></i>\r\n              Creating account...\r\n            </span>\r\n          </button>\r\n\r\n          <!-- Login Link -->\r\n          <div class=\"login-link\">\r\n            Already have an account?\r\n            <router-link to=\"/login\">Sign in</router-link>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport ThemeControls from './ThemeControls.vue';\r\n\r\nexport default {\r\n  name: 'RegisterPage',\r\n  components: {\r\n    ThemeControls\r\n  },\r\n  data() {\r\n    return {\r\n      currentRiverIndex: 0,\r\n      riverImages: [\r\n        require('@/assets/River1.jpg'),\r\n        require('@/assets/River2.jpg'),\r\n        require('@/assets/River3.jpg'),\r\n        require('@/assets/River4.jpg'),\r\n        require('@/assets/River5.jpg'),\r\n        require('@/assets/River6.jpg'),\r\n        require('@/assets/River7.jpg'),\r\n        require('@/assets/River8.jpg'),\r\n        require('@/assets/River9.jpg'),\r\n        require('@/assets/River10.jpg'),\r\n        require('@/assets/River11.jpg'),\r\n        require('@/assets/River12.jpg'),\r\n        require('@/assets/River13.jpg'),\r\n        require('@/assets/River14.jpg'),\r\n        require('@/assets/River15.jpg'),\r\n        require('@/assets/River16.jpg'),\r\n        require('@/assets/River17.jpg')\r\n      ],\r\n      formData: {\r\n        username: '',\r\n        email: '',\r\n        first_name: '',\r\n        last_name: '',\r\n        password: '',\r\n        password2: ''\